@inject PlaygroundState Pg
@inject WorkspaceConfig Ws
@inject AppState State
@implements IDisposable

@* The shared request composer (Playground and the Overview compact composer bind the SAME PlaygroundState form).
   "Send a request as" lists GET /admin/applications: only enabled + console-testing applications are selectable; the others
   stay visible, disabled, with the reason. The profile select offers ONLY the application's granted profiles.
   Examples populate; Run is always explicit; nothing here submits on render, on example click or on reload. *@

<div class="composer @(Compact ? "compact" : "")">
    <div class="composer-grid">
        <div class="field">
            @{ var only = ComposerRules.OnlySelectable(Ws.Applications); var current = ComposerRules.Find(Ws.Applications, Pg.Form.ApplicationId); }
            @if (only is not null && string.Equals(only.Id, Pg.Form.ApplicationId, StringComparison.Ordinal))
            {
                <span class="field-label" id="@(IdPrefix + "-app-l")">Send a request as</span><InfoTip Label="What is an application?">An <strong>application</strong> is an authenticated consuming system (a portal, an assistant, a batch job). It belongs to a <strong>team</strong>, and that team pays. The Playground sends as an authorized test identity of that application; its credential never reaches this browser.</InfoTip>
                <div class="static-value" aria-labelledby="@(IdPrefix + "-app-l")">
                    <strong>@ComposerRules.ApplicationName(only)</strong>
                    @if (!string.IsNullOrWhiteSpace(only.DisplayName)) { <span class="subtle mono">&nbsp;@only.Id</span> }
                </div>
                @if (!Compact)
                {
                    <span class="help">The only application allowed to run console requests. <a href="policies#applications-list">Add or manage applications</a></span>
                }
            }
            else
            {
                <span class="label-row"><label for="@(IdPrefix + "-app")">Send a request as</label><InfoTip Label="What is an application?">An <strong>application</strong> is an authenticated consuming system (a portal, an assistant, a batch job). It belongs to a <strong>team</strong>, and that team pays. The Playground sends as an authorized test identity of that application; its credential never reaches this browser.</InfoTip></span>
                <select id="@(IdPrefix + "-app")" class="input" value="@(Pg.Form.ApplicationId ?? "")" @onchange="OnApplication"
                        disabled="@(Pg.Running || Ws.Applications is null)" aria-describedby="@(IdPrefix + "-app-help")"
                        title="Identity and team come from this application; its credential never reaches the browser.">
                    <option value="" disabled>@(Ws.Applications is null ? (Ws.Loading ? "Loading applications…" : "Applications unavailable") : "Choose an application…")</option>
                    @foreach (var c in ComposerRules.Applications(Ws.Applications))
                    {
                        <option value="@c.App.Id" disabled="@(!c.Selectable)">@c.Label</option>
                    }
                </select>
                @if (!Compact || AppHelp is not null)
                {
                    <span id="@(IdPrefix + "-app-help")" class="help @(Ws.ApplicationsError is null ? "" : "bad")">@(AppHelp ?? "The system this request comes from.") <a href="policies#applications-list">Add or manage applications</a></span>
                }
            }
            @if (current is not null)
            {
                @* Owner/team stays visible in both composers; the id and purpose only where there is room. *@
                <span class="owner-chips">
                    @if (!Compact) { <span class="chip mono" title="Application id">@current.Id</span> }
                    <span class="chip owner" title="Owning team — pays for this application's requests"><Icon Name="budgets" Size="14" />team @current.Team</span>
                    @if (!Compact && !string.IsNullOrWhiteSpace(current.Description)) { <span class="subtle secondary">@current.Description</span> }
                </span>
            }
        </div>
        <div class="field">
            @{ var app = current; var granted = ComposerRules.GrantedProfiles(app); }
            <WorkloadSelector Granted="granted" Profiles="Ws.Profiles" Selected="@Pg.Form.ProfileId" Disabled="@(Pg.Running || app is null)"
                              HasApplication="@(app is not null)" IdPrefix="@IdPrefix" OnSelect="OnWorkload" />
            @{ var selectedProfile = ComposerRules.Profile(Ws.Profiles, Pg.Form.ProfileId);
               var dest = WorkloadDestination.For(Ws.Config?.Config, selectedProfile, Pg.Form.RequestedModel); }
            @* The approved destination of THIS workload (classification ≠ destination), refreshed with every form/config change.
               Full composer: beside the workload, with fallback, policy and note. Compact: one full-width line below the row. *@
            @if (!Compact)
            {
                <div id="@(IdPrefix + "-profile-help")" class="destination-line" aria-live="polite">
                    @if (dest.Ok)
                    {
                        <span class="subtle">@(selectedProfile is null ? "" : PolicyText.ClassificationLabel(selectedProfile.Baseline) + " →")</span>
                        <BoundaryTag Boundary="@dest.Boundary" />
                        <span class="mono wrap-any">@dest.Target</span>
                        @if (dest.Fallbacks.Count > 0) { <span class="subtle">· fallback @string.Join(", ", dest.Fallbacks)</span> }
                        @if (dest.PolicyId is { } pid) { <span class="subtle">· policy @pid</span> }
                    }
                    else if (dest.Problem is { } problem)
                    {
                        <span class="note warn">@(problem + (dest.Href is null ? "" : " "))@if (dest.Href is { } dh) { <a href="@dh">@dest.HrefLabel</a> }</span>
                    }
                </div>
                @if (Pg.Form.RequestedModel is { } pinned)
                {
                    <div class="note warn pin-warning" role="status">
                        <span>Model pinned to <span class="mono">@pinned</span>@(Pg.Form.PinnedByExample ? " by the example" : " by you") — no fallback; policy still decides and refuses a pin this workload does not approve.</span>
                        <button type="button" class="btn sm" disabled="@Pg.Running" @onclick="ResetToPolicy">Let policy choose</button>
                    </div>
                }
                @* ADR-0019: the rejection sentence (and never the old "stricter (local) rule" copy) comes from WorkloadDestination.Note. *@
                @if (dest.Note is { } dn)
                {
                    <span class="help">@(dn + (dest.Href is null ? "" : " "))@if (dest.Href is { } nh) { <a href="@nh">@dest.HrefLabel</a> }</span>
                }
                @if (WorkloadDestination.OutputBound(Ws.Config?.Config, Pg.Form.ApplicationId, dest, Pg.Form.MaxTokens) is { } bound)
                {
                    <span class="help warn-text">@bound</span>
                }
            }
        </div>
    </div>
    @if (Compact)
    {
        <div id="@(IdPrefix + "-profile-help")" class="destination-line compact" aria-live="polite">
            @if (dest.Ok)
            {
                <span class="subtle">Runs on</span>
                <BoundaryTag Boundary="@dest.Boundary" />
                <span class="mono ellipsis" title="@(dest.Target + (dest.Fallbacks.Count > 0 ? " · fallback " + string.Join(", ", dest.Fallbacks) : "") + (dest.PolicyId is { } tp ? " · policy " + tp : ""))">@dest.Target</span>
            }
            else if (dest.Problem is { } cproblem)
            {
                <span class="note warn ellipsis" title="@cproblem">@cproblem</span>
                @if (dest.Href is { } ch) { <a href="@ch">@dest.HrefLabel</a> }
            }
        </div>
    }

    @* Both composers (Playground and the compact Overview one) offer the examples of the selected application. *@
    <ExamplePicker IdPrefix="@IdPrefix" Compact="@Compact" />
    @if (Pg.PresetNote is { } pn)
    {
        <span class="note warn" role="status">@pn</span>
    }

    <div class="field">
        <label for="@(IdPrefix + "-prompt")">Prompt</label>
        <textarea id="@(IdPrefix + "-prompt")" class="input textarea @(Compact ? "short" : "")" rows="3"
                  @bind="Pg.Form.Prompt" @bind:event="oninput" @bind:after="Pg.NotifyFormChanged"
                  disabled="@Pg.Running"></textarea>
        @if (Pg.Form.FreshNonce)
        {
            <span class="help">A fresh nonce (<span class="mono">[run …]</span>) is appended on every run, so it is never served from cache.</span>
        }
    </div>

    @* ADR-0015: governed web sources. The Host decides (cue, permissions, budget) and reports what actually happened; the
       console only refuses to OFFER a mode the current server setup cannot run, with ONE cause and its fix. The form is never
       changed behind the operator's back: a blocked Required stays Required (Run is blocked with the cause). *@
    @{ var ready = Pg.SearchReadiness; }
    <div class="composer-grid">
        <div class="field">
            <span id="@(IdPrefix + "-ws-l")" class="field-label">Web sources</span>
            <div class="seg" role="radiogroup" aria-labelledby="@(IdPrefix + "-ws-l")" aria-describedby="@(IdPrefix + "-ws-help")">
                @foreach (var m in new[] { WebSourcesMode.Off, WebSourcesMode.Auto, WebSourcesMode.Required })
                {
                    var mode = m;
                    var blocked = mode != WebSourcesMode.Off && ready is { Known: true, Possible: false } && Pg.Form.WebSources != mode;
                    <button type="button" role="radio" aria-checked="@(Pg.Form.WebSources == mode ? "true" : "false")" disabled="@(Pg.Running || blocked)"
                            title="@(blocked ? ready.Cause : null)" @onclick="() => SetWebSources(mode)">@WebSourcesText.Label(mode)</button>
                }
            </div>
            @if (ready is { Known: true, Possible: false })
            {
                @* The precise reason is always visible (Off included); warning styling only once search is requested.
                   Internal workloads staying local is correct behaviour, so it has no "fix" link. *@
                var asked = Pg.Form.WebSources != WebSourcesMode.Off;
                <span id="@(IdPrefix + "-ws-help")" class="help @(asked ? "warn" : "")">
                    @(ready.Cause + (asked && !string.IsNullOrEmpty(ready.Fix) ? " " + ready.Fix : "") + (ready.Href is null ? "" : " "))@if (ready.Href is { } href) { <a href="@href">@ready.HrefLabel</a> }
                </span>
                @if (ready.SwitchToProfile is { } alt)
                {
                    <button type="button" class="btn sm" disabled="@Pg.Running" @onclick="() => Pg.SelectProfileAndPreviewAsync(alt)">Switch to @(ComposerRules.Profile(Ws.Profiles, alt)?.Name ?? alt)</button>
                }
            }
            else
            {
                <span id="@(IdPrefix + "-ws-help")" class="help @(Compact && ready.Known ? "visually-hidden" : "")">@WebSourcesText.Help(Pg.Form.WebSources)@(ready.Known ? "" : " (" + ready.Cause + ")")</span>
            }
        </div>
        @* Search location only where it can matter: web sources on and search possible (or not yet known). *@
        @if (Pg.Form.WebSources != WebSourcesMode.Off && ready.Possible)
        {
            <div class="field">
                <label for="@(IdPrefix + "-loc")">Search location</label>
                <input id="@(IdPrefix + "-loc")" class="input" type="text" maxlength="@WebSourcesText.MaxLocationChars" placeholder="e.g. Toronto"
                       @bind="Pg.Form.Location" @bind:event="oninput" @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running"
                       aria-describedby="@(IdPrefix + "-loc-help")" autocomplete="off" />
                @{ var missingCity = SearchIntent.MissingLocation(Pg.Form.WebSources, Pg.Form.Prompt, Pg.Form.Location); }
                <span id="@(IdPrefix + "-loc-help")" class="help @(missingCity is null ? (Compact ? "visually-hidden" : "") : "warn")">@(missingCity ?? SearchIntent.LocationEffect(Pg.Form.WebSources, Pg.Form.Prompt, Pg.Form.Location))</span>
            </div>
        }
    </div>

    @if (!Compact)
    {
        <RoutePreviewPanel />
    }

    @if (!Compact)
    {
        <details class="advanced">
            <summary>Advanced</summary>
            <div class="advanced-body">
        <details class="about">
            <summary>About this</summary>
            <ul class="plain-list secondary">
                <li>An application is the calling system (for example a support portal). It belongs to a team, which pays for its requests through the team's and the application's budgets, and it may only use the workload profiles granted to it.</li>
                <li>Identity and team come from the selected application; its credential never reaches the browser. The admin token runs the request as that application.</li>
                <li>Only profiles granted to the application are offered. Each profile's baseline is a trusted, server-side classification; detection can only escalate it. There is no client-side classification control.</li>
                <li>Response text is console-only: kept in this tab's memory, never persisted. The audit record holds a prompt fingerprint, not the response.</li>
                <li>Grants, defaults and baselines are edited under Policies → Applications &amp; workload profiles.</li>
            </ul>
        </details>

                <div class="field">
                    <span id="@(IdPrefix + "-route-l")" class="field-label">Model</span>
                    <div class="seg" role="radiogroup" aria-labelledby="@(IdPrefix + "-route-l")">
                        <button type="button" role="radio" aria-checked="@(Pg.Form.Mode == RouteMode.Policy ? "true" : "false")" disabled="@Pg.Running" @onclick="() => SetMode(RouteMode.Policy)">Let policy choose</button>
                        <button type="button" role="radio" aria-checked="@(Pg.Form.Mode == RouteMode.Catalog ? "true" : "false")" disabled="@(Pg.Running || Overrides.Count == 0)" @onclick="() => SetMode(RouteMode.Catalog)">Eligible model</button>
                        <button type="button" role="radio" aria-checked="@(Pg.Form.Mode == RouteMode.Explicit ? "true" : "false")" disabled="@Pg.Running" @onclick="() => SetMode(RouteMode.Explicit)">Test input</button>
                    </div>
                    @if (Pg.Form.Mode == RouteMode.Catalog)
                    {
                        <label for="@(IdPrefix + "-cat")" class="visually-hidden">Model override</label>
                        <select id="@(IdPrefix + "-cat")" class="input mono" value="@(Pg.Form.CatalogModel ?? "")" @onchange="OnCatalogModel" disabled="@Pg.Running">
                            @foreach (var o in Overrides)
                            {
                                <option value="@o.Value">@(o.Label + " · " + (o.Boundary ?? "boundary not reported"))</option>
                            }
                        </select>
                        <span class="help">Pins this target (no fallback). Policy still checks the final classification — a listed model is not a permission grant.</span>
                    }
                    else if (Pg.Form.Mode == RouteMode.Explicit)
                    {
                        <label for="@(IdPrefix + "-explicit")" class="field-label">Model id — test input; does not grant permission</label>
                        <input id="@(IdPrefix + "-explicit")" class="input mono" type="text" spellcheck="false"
                               @bind="Pg.Form.ExplicitModel" @bind:event="oninput" @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running" />
                    }
                </div>
                <div class="composer-grid three">
                    <div class="field">
                        <label for="@(IdPrefix + "-wf")">Workflow</label>
                        <input id="@(IdPrefix + "-wf")" class="input" type="text" @bind="Pg.Form.Workflow" @bind:event="oninput" @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running" />
                    </div>
                    <div class="field">
                        <label for="@(IdPrefix + "-uc")">Use case</label>
                        <input id="@(IdPrefix + "-uc")" class="input" type="text" @bind="Pg.Form.UseCase" @bind:event="oninput" @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running" />
                    </div>
                    <div class="field">
                        <label for="@(IdPrefix + "-max")">Max output tokens</label>
                        @* oninput (not the default onchange): every keystroke updates the form, so closing Advanced or pressing Run
                           right after typing can never send the previous value. The run snapshot records exactly what was sent. *@
                        <input id="@(IdPrefix + "-max")" class="input mono" type="number" min="1" @bind="Pg.Form.MaxTokens" @bind:event="oninput"
                               @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running" aria-describedby="@(IdPrefix + "-max-help")" />
                        <span id="@(IdPrefix + "-max-help")" class="help">Enforced as the lowest of this, the application's cap and the model's cap. A cut-off answer is flagged.</span>
                    </div>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="Pg.Form.Streaming" @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running" /> Stream the response
                </label>
                <details class="tech">
                    <summary>Technical details</summary>
                    <span class="note">Runs through <span class="mono">POST /admin/playground/requests</span> with the admin token (ADR-0012): the Host resolves the selected test application and runs the same governed pipeline as <span class="mono">/v1</span>. The browser holds no application credential. Each Run sends a new <span class="mono">client_request_id</span>; a repeated id is refused (409), so nothing is replayed. Workflow and use case are attribution labels only.</span>
                </details>
            </div>
        </details>
    }

    @if (ShowActionBar)
    {
        <div class="action-bar" role="group" aria-label="Request actions">
            <button type="button" class="btn primary form" id="@(IdPrefix + "-run")" disabled="@(!Pg.CanRun)" aria-busy="@(Pg.Running ? "true" : null)" @onclick="RunAsync">
                <Icon Name="play" Size="16" /><span>@RunLabel</span>
            </button>
            <button type="button" class="btn form" disabled="@(!Pg.Running)" @onclick="Pg.Cancel">
                <Icon Name="stop" Size="16" /><span>Cancel</span>
            </button>
            <span class="action-status" title="@StatusText">@StatusText</span>
            @ExtraActions
        </div>
    }
</div>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool ShowActionBar { get; set; } = true;
    /// <summary>Unique prefix for element ids (label/for pairs) when more than one composer could render.</summary>
    [Parameter] public string IdPrefix { get; set; } = "cmp";
    /// <summary>Optional extra actions rendered at the end of the action bar (e.g. "Presentation mode").</summary>
    [Parameter] public RenderFragment? ExtraActions { get; set; }

    private ScenarioPreset? CurrentPreset => ScenarioPresets.Find(Pg.Form.Scenario) is { } p && p.StillMatches(Pg.Form) ? p : null;

    private DemoExample? CurrentExample => DemoExamples.Find(Pg.Form.ExampleId) is { } e && DemoExamples.StillMatches(e, Pg.Form) ? e : null;

    private IReadOnlyList<OverrideOption> Overrides => ComposerRules.EligibleOverrides(Ws.Config?.Config, Pg.Form.ProfileId, State.Catalog);

    private string RunLabel
    {
        get
        {
            if (Pg.Running) return "Running…";
            if (CurrentExample is not null) return "Run example";
            return CurrentPreset is { } p && ScenarioPresets.IsReady(p, Pg.Form, Ws.Applications)
                ? "Run preset " + p.Letter
                : "Run";
        }
    }

    /// <summary>Only a problem or a loading state is shown under "Run as"; the identity explanation is a tooltip and
    /// part of "About this" (review round 3).</summary>
    private string? AppHelp
    {
        get
        {
            if (Ws.ApplicationsError is { } e) return e;
            if (Ws.Applications is null) return Ws.Loading ? "Loading test applications…" : "Test applications not loaded.";
            if (!Ws.Applications.Any(a => ComposerRules.WhyNotSelectable(a) is null))
                return "No application is enabled for console testing (allow it under Policies → Applications & workload profiles).";
            return null;
        }
    }

    private string StatusText
    {
        get
        {
            if (Pg.Running && Pg.Selected is { } r)
                return "Running request #" + r.Snapshot.Sequence.ToString(System.Globalization.CultureInfo.InvariantCulture) + "…";
            if (Pg.Problem is { } problem) return problem;
            if (Pg.Selected is { Outcome: { } o } sel)
                return "Last: #" + sel.Snapshot.Sequence.ToString(System.Globalization.CultureInfo.InvariantCulture) + " " + o.Title;
            return "Ready to run";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Pg.Changed += OnChanged;
        Ws.Changed += OnChanged;
        await Ws.EnsureLoadedAsync();
        Pg.EnsureDefaultApplication();
    }

    private Task RunAsync() => Pg.RunAsync();

    private void OnApplication(ChangeEventArgs e) => Pg.SelectApplication(e.Value?.ToString());

    private void OnProfile(ChangeEventArgs e) => Pg.SelectProfile(e.Value?.ToString());

    private Task OnWorkload(string? profileId) => Pg.SelectProfileAndPreviewAsync(profileId);

    private void OnCatalogModel(ChangeEventArgs e)
    {
        Pg.Form.CatalogModel = e.Value?.ToString();
        Pg.Form.PinnedByExample = false;   // now the operator's own choice: kept across workload changes, with a warning
        Pg.NotifyFormChanged();
    }

    private void ResetToPolicy() => SetMode(RouteMode.Policy);

    private void SetMode(RouteMode mode)
    {
        Pg.Form.Mode = mode;
        Pg.Form.PinnedByExample = false;
        if (mode == RouteMode.Catalog && (string.IsNullOrWhiteSpace(Pg.Form.CatalogModel) || Overrides.All(o => o.Value != Pg.Form.CatalogModel)) && Overrides.Count > 0)
            Pg.Form.CatalogModel = Overrides[0].Value;
        Pg.NotifyFormChanged();
    }

    private void SetWebSources(WebSourcesMode mode)
    {
        Pg.Form.WebSources = mode;
        Pg.NotifyFormChanged();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Pg.Changed -= OnChanged;
        Ws.Changed -= OnChanged;
    }
}
