@inject PlaygroundState Pg
@inject WorkspaceConfig Ws
@implements IDisposable

@* BEFORE the run: the Host's dry-run route (POST /admin/policies/simulate) — which policy matches the application's
   workload profile and final classification, the primary target, approved fallbacks, and excluded targets with the
   reason. Real engine, no provider call, no record, no spend. AFTER the run, the run summary shows what actually
   happened from evidence. The user's prompt is sent exactly as typed. *@

<div class="route-preview" aria-live="polite">
    <div class="btn-row">
        <button type="button" class="btn sm" disabled="@(Pg.Running || string.IsNullOrWhiteSpace(Pg.Form.ApplicationId) || string.IsNullOrWhiteSpace(Pg.Form.Prompt))"
                @onclick="Pg.PreviewRouteAsync">Preview route (dry run)</button>
        <span class="secondary subtle">Asks the policy engine where this request would go — no model is called.</span>
    </div>
    @* Compact scheme first (Sender → Covenant → Destination) from the CURRENT server dry run only; the long explanation and
       the eligible/excluded targets are behind Details. Stale or pending states show no route they do not have. *@
    @{ var scheme = RouteSchemes.Expected(Pg.Preview, Pg.Form, Ws.Config?.Version, Ws.Applications, Ws.Profiles); }
    <RouteDiagram View="scheme" />
    @if (scheme.State == "stale")
    {
        var now = WorkloadDestination.For(Ws.Config?.Config, ComposerRules.Profile(Ws.Profiles, Pg.Form.ProfileId), Pg.Form.RequestedModel);
        if (now.Ok)
        {
            <span class="secondary subtle">Configured for this workload (not a preview): <BoundaryTag Boundary="@now.Boundary" /> <span class="mono wrap-any">@now.Target</span>@(now.PolicyId is { } np ? " · policy " + np : "")</span>
        }
    }
    @if (scheme.State == "ready" && Pg.Preview?.Result is { RefusedAtStage: "classify", SuggestedProfiles.Count: > 0 } rej)
    {
        @* ADR-0019: the Host's own suggestion (granted workloads its policy engine WOULD route this classification under).
           Switching keeps the prompt; nothing runs until Run. *@
        <div class="btn-row">
            @foreach (var pid in rej.SuggestedProfiles!)
            {
                var target = pid;
                <button type="button" class="btn sm" disabled="@Pg.Running" @onclick="() => SwitchAndPreviewAsync(target)">
                    Use workload @(ComposerRules.Profile(Ws.Profiles, target)?.Name ?? target) (prompt kept)
                </button>
            }
            <span class="secondary subtle">This workload rejects detected sensitive data; the server suggests a workload approved for it.</span>
        </div>
    }
    @if (scheme.State == "ready" && Pg.Preview?.Result is { } r)
    {
        <details class="tech route-details">
            <summary>Details</summary>
            <span class="secondary">@RoutePreview.Summary(r)</span>
            <span class="secondary">@RoutePreview.Classification(r)</span>
            @if (r.Eligible.Count > 0)
            {
                <ul class="plain-list secondary">
                    @foreach (var e in r.Eligible)
                    {
                        <li><span class="mono">@e.Target</span> @(e.Boundary is { Length: > 0 } b ? "· " + b : "") @(e.ExcludedReason is { Length: > 0 } why ? "— excluded: " + why : "— eligible")</li>
                    }
                </ul>
            }
            @if (!string.IsNullOrWhiteSpace(r.Explanation)) { <span class="subtle secondary">@r.Explanation</span> }
            <span class="subtle secondary">Runtime checks (pause, rate limit, budget, provider health, web search readiness) still apply when you Run.</span>
        </details>
        @if (r.Redaction is { } red)
        {
            <SanitizedPreview Redaction="red" />
        }
    }
    <details class="tech">
        <summary>What sensitive-data detection covers — and does not</summary>
        <span class="secondary">@RouteSchemes.DetectionCoverage</span>
    </details>
    @if (Pg.SanitizedWorkload && Pg.Preview is null)
    {
        <span class="note">This workload sends only a sanitized structured record externally. Preview the route to see the exact payload first.</span>
    }
</div>

@code {
    // No parameters change when the form does, so the panel follows the shared state itself: the button's enabled state,
    // the dry-run result and the "previous form" marker all re-render on every form edit, example fill, workload switch,
    // run completion and configuration refresh.
    protected override void OnInitialized()
    {
        Pg.Changed += OnChanged;
        Ws.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SwitchAndPreviewAsync(string profileId) => Pg.SelectProfileAndPreviewAsync(profileId);

    public void Dispose()
    {
        Pg.Changed -= OnChanged;
        Ws.Changed -= OnChanged;
    }
}
