@inject WorkspaceConfig Ws

@* The compact outcome line under the Actual route scheme: outcome, cost, duration, tokens and evidence state. Sender,
   classification and destination are in the scheme; the full facts live in the details drawer — not repeated here.
   "Evidence recorded" = the audit record exists; integrity is verified on Audit & evidence. *@
<div class="run-summary @(Large ? "large" : "")">
    <div class="run-outcome">
        @if (Run.InFlight)
        {
            <span class="outcome unknown">@(Run.Text.Length > 0 ? "Streaming…" : "Running…")</span>
        }
        else if (Run.Outcome is { } o)
        {
            <span class="outcome @o.PillKind">@o.Title@(Run.Evidence.Record is { } tr0 && RecordFacts.Truncated(tr0) ? " — truncated" : "")</span>
            <span class="mono subtle secondary">@o.StatusLine</span>
        }
        @if (OnDetails.HasDelegate)
        {
            <button type="button" class="btn sm" id="@DetailsButtonId" @onclick="() => OnDetails.InvokeAsync()" disabled="@Run.InFlight">
                <Icon Name="details" Size="16" /><span>Details &amp; evidence</span>
            </button>
        }
    </div>
    @if (!Large && !Run.InFlight && Run.Outcome is { } ox)
    {
        <span class="run-explain">@ox.Explanation</span>
    }
    @* Next to the Actual route scheme: sender, classification, destination, sanitization, search and cache are in its three
       boxes and badges, so the summary carries only the outcome chip and the facts the scheme does not show. *@
    @if (!Large && !Run.InFlight && Run.Evidence.Record is { } jr)
    {
        <JourneyChipRow Record="jr" OutcomeOnly="true" />
    }
    @if (!Run.InFlight && Run.Evidence.Record is { } tr && RecordFacts.TruncationWarning(tr) is { } cut)
    {
        <div class="alert warn" role="status"><div class="alert-text"><strong>Truncated</strong><span class="alert-body">@cut</span></div></div>
    }
    @if (Run.Result?.TransportError is { Length: > 0 } te)
    {
        <span class="note bad">@te</span>
    }
    @if (Large)
    {
        <dl class="run-facts presentation-facts">
            <div><dt>Estimated charges</dt><dd title="@RunText.Cost(Run)">@(Run.Evidence.Record is { } costRecord ? CostText.CostShort(costRecord) : RunText.AwaitingText(Run))</dd></div>
            <div><dt>Duration</dt><dd>@RunText.Duration(Run)</dd></div>
            <div><dt>Evidence</dt><dd>@{ var evidence = RunText.Evidence(Run); }<span class="dot @evidence.Tone" aria-hidden="true"></span> @evidence.Text</dd></div>
        </dl>
    }
    else
    {
    @* Only facts the route scheme does not show. Ownership (assigned / charged), cache and the full classification are in
       Details & evidence. *@
    <dl class="run-facts">
        <div><dt>Cost</dt><dd>@RunText.Cost(Run)</dd></div>
        <div><dt>Duration</dt><dd>@RunText.Duration(Run)</dd></div>
        <div><dt>Tokens</dt><dd>@RunText.Tokens(Run)</dd></div>
        <div>
            <dt>Evidence</dt>
            @{ var ev = RunText.Evidence(Run); }
            <dd><span class="dot @ev.Tone" aria-hidden="true"></span> @ev.Text</dd>
        </div>
    </dl>
    }
</div>

@code {
    [Parameter] public PlaygroundRun Run { get; set; } = default!;
    [Parameter] public EventCallback OnDetails { get; set; }
    [Parameter] public string DetailsButtonId { get; set; } = "run-details";
    /// <summary>Presentation sizing; fewer facts.</summary>
    [Parameter] public bool Large { get; set; }
}
