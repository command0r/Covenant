@* Local vs External (cloud) destination tag — teal vs purple; red is reserved for sensitive/blocked — always text + colour + icon, never colour alone. Unknown boundary is said
   explicitly ("Boundary not reported"), never guessed from a model name. *@
@switch (Boundary)
{
    case "Local":
        <span class="tag local" title="Local — runs inside the perimeter"><Icon Name="local" Size="14" />Local</span>
        break;
    case "Cloud":
        <span class="tag cloud" title="External — leaves the perimeter to an approved provider"><Icon Name="cloud" Size="14" />External</span>
        break;
    default:
        <span class="tag unknown">Boundary not reported</span>
        break;
}

@code {
    /// <summary>"Local", "Cloud" or null.</summary>
    [Parameter] public string? Boundary { get; set; }
}
