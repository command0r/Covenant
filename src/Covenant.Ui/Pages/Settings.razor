@page "/settings"
@inject AppState State
@inject AdminApi Api
@inject ConsoleSession Session
@inject ConfigEditor Editor
@inject PlaygroundState Pg
@inject Interop Interop
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Settings · Covenant</PageTitle>

@*
  T08. Grouped: Operational (server, versioned configuration — Edit → Preview impact → Save & apply), Console
  preferences (this browser only), Diagnostics (read-only startup facts; restart-only), Maintenance (archive the audit
  segment — separate from accounting, precise typed confirmation). Nothing unsupported has a Save button.
*@

<div class="page">
    <RequiresConnection>
        <div class="page-head">
            <div class="titles">
                <h1>Settings</h1>
                <span class="lede">Operational settings are server configuration (versioned, audited). Preferences stay in this browser. Startup values need a restart.</span>
            </div>
        </div>

        <EditorBar Owner="settings" Subject="Settings" ShowEditButton="false" ClaimedPaths="@(new[] { "settings", "web_search" })"
                   ViewHint="Each section is edited in its own dialog; saving creates a new configuration version." />
        @if (_notice is { } notice)
        {
            <span class="note" role="status">@notice</span>
        }

        <section class="panel" aria-labelledby="op-h">
            <div class="panel-head">
                <h2 id="op-h">Operational</h2>
                <span class="panel-sub">Cache, evidence retention and rate limits · apply to new requests · no restart</span>
                <span class="grow"></span>
                <button type="button" class="btn sm" id="op-edit" disabled="@(!CanEdit || Editor.Applied?.Config?.Settings is null)" @onclick="OpenOperational">Edit…</button>
            </div>
            @if (Editor.Applied?.Config?.Settings is { } st)
            {
                <FactList Inline="true" Facts="@OperationalFacts(st)" />
                @if (st.PromptPreviewChars is > 0)
                {
                    <span class="note warn">Prompt previews are stored in evidence (@st.PromptPreviewChars characters of every prompt) and cannot be removed later.</span>
                }
            }
            else if (Editor.Loading || Editor.Applied is null)
            {
                <Skeleton Lines="2" Label="Loading operational settings" />
            }
            else
            {
                <span class="secondary muted">The active configuration carries no operational settings.</span>
            }
        </section>

        @* ADR-0015: readiness from GET /admin/web-search (the key never appears); enabled/limits/price are versioned config. *@
        <section class="panel" aria-labelledby="ws-h">
            <div class="panel-head">
                <h2 id="ws-h">Web search (Tavily)</h2>
                <span class="panel-sub">Public workloads only · optional per request · charged to budgets</span>
                <span class="grow"></span>
                <button type="button" class="btn sm" id="ws-edit" disabled="@(!CanEdit)" @onclick="OpenWebSearch">@(Editor.Applied?.Config?.WebSearch is null ? "Configure…" : "Edit…")</button>
            </div>
            @if (_ws is { } wst)
            {
                <div class="result-head">
                    <StatusPill Kind="@(wst.Ready ? "served" : "unknown")" Text="@(wst.Ready ? "Ready" : "Not ready")" />
                    <span class="secondary">@WebSearchSummary(wst)</span>
                    <button type="button" class="btn ghost sm" @onclick="LoadWebSearchAsync">Refresh</button>
                </div>
                @if (!wst.Ready)
                {
                    <ul class="plain-list secondary">
                        @foreach (var item in WebSourcesText.Checklist(wst).Where(i => !i.Ok))
                        {
                            <li><span class="dot warn" aria-hidden="true"></span> @item.Label — no</li>
                        }
                    </ul>
                    @if (wst.Setup.Count > 0)
                    {
                        <details class="tech">
                            <summary>Setup steps</summary>
                            <ol class="plain-list secondary">
                                @foreach (var step in wst.Setup) { <li>@step</li> }
                            </ol>
                        </details>
                    }
                }
            }
            else if (_wsError is { } wse)
            {
                <span class="note warn">@wse</span>
            }
            else
            {
                <Skeleton Lines="2" Label="Loading web search status" />
            }
            <details class="tech">
                <summary>How web search is governed</summary>
                <ul class="plain-list secondary">
                    <li>Playground → Web sources: Off (default), Auto (only when the prompt asks for current information) or Required.</li>
                    <li>Auth, policy, pause, rate limit and budget run first. Internal, PII and PHI requests — or a sensitive query or location — are never searched.</li>
                    <li>Exactly one bounded search; results are untrusted data. If it fails or finds nothing, the request fails rather than answering from stale knowledge.</li>
                    <li>Evidence records outcome, source hosts and charge — never the query, location or snippets.</li>
                </ul>
            </details>
        </section>

        @if (_op is { } oe)
        {
            var o = oe.Working;
            <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="Operational settings" OpenerId="op-edit" IsDirty="() => oe.IsDirty"
                        Busy="@_saving" Error="@_saveError" ErrorTitle="@_saveErrorTitle" ErrorTone="@_saveErrorTone" Issues="@_issues"
                        OnSave="@(() => SaveAsync(oe.BaseVersion, d => EntityEdits.Apply(d, oe), "Console: operational settings edited"))" OnCancel="DiscardScoped">
                <div class="dialog-section">
                    <h3>Exact cache</h3>
                    <div class="form-grid">
                        <div class="field"><label for="s-ttl">TTL (seconds, 0 = off)</label><input id="s-ttl" class="input mono" type="number" min="0" @bind="o.CacheTtlSeconds" @bind:event="oninput" /></div>
                        <div class="field"><label for="s-max">Max entries</label><input id="s-max" class="input mono" type="number" min="1" @bind="o.CacheMaxEntries" @bind:event="oninput" /></div>
                    </div>
                    <span class="secondary subtle">A hit still passes auth, classification and policy, and makes no provider call.</span>
                </div>
                <div class="dialog-section">
                    <h3>Evidence and trace</h3>
                    <div class="form-grid">
                        <div class="field">
                            <label for="s-prev">Prompt preview in evidence (characters, 0–500)</label>
                            <input id="s-prev" class="input mono" type="number" min="0" max="500" @bind="o.PromptPreviewChars" @bind:event="oninput" />
                            <span class="help @(o.PromptPreviewChars is > 0 ? "warn" : "")">@(o.PromptPreviewChars is > 0 ? "Stored in the tamper-evident audit log for every prompt; cannot be removed later." : "0 = fingerprint and length only.")</span>
                        </div>
                        <div class="field"><label for="s-trace">Live trace retention (minutes, 1–1440)</label><input id="s-trace" class="input mono" type="number" min="1" max="1440" @bind="o.TraceRetentionMinutes" @bind:event="oninput" /></div>
                    </div>
                </div>
                <div class="dialog-section">
                    <h3>Rate limits (requests per minute, 0 = off)</h3>
                    <div class="form-grid">
                        <div class="field"><label for="s-rg">All traffic</label><input id="s-rg" class="input mono" type="number" min="0" @bind="o.RateLimitGlobalPerMinute" @bind:event="oninput" /></div>
                        <div class="field"><label for="s-rt">Per team</label><input id="s-rt" class="input mono" type="number" min="0" @bind="o.RateLimitPerTeamPerMinute" @bind:event="oninput" /></div>
                    </div>
                </div>
            </EditDialog>
        }

        @if (_wsEdit is { } we)
        {
            var w = we.Working;
            <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="Web search settings" OpenerId="ws-edit" IsDirty="() => we.IsDirty"
                        Busy="@_saving" Error="@_saveError" ErrorTitle="@_saveErrorTitle" ErrorTone="@_saveErrorTone" Issues="@_issues"
                        OnSave="@(() => SaveAsync(we.BaseVersion, d => EntityEdits.Apply(d, we), "Console: web search settings edited"))" OnCancel="DiscardScoped">
                <div class="dialog-section">
                    <label class="switch"><input type="checkbox" @bind="w.Enabled" /> Enable web search</label>
                    <span class="secondary subtle">Also needs Hybrid mode, the server key, the egress allow-list entry, a price, and a Public workload that allows it (Policies → Workloads).</span>
                </div>
                <div class="dialog-section">
                    <div class="form-grid">
                        <div class="field">
                            <label for="ws-price">Price per Tavily credit (USD)</label>
                            <input id="ws-price" class="input mono" type="number" min="0" step="0.0001" @bind="w.PricePerCreditUsd" @bind:event="oninput" />
                            <span class="help">From your Tavily plan; a basic search uses 1 credit. Empty = unknown — search stays refused.</span>
                        </div>
                        <div class="field"><label for="ws-basis">Price basis (optional)</label><input id="ws-basis" class="input" maxlength="200" @bind="w.PriceBasis" @bind:event="oninput" placeholder="e.g. Tavily pay-as-you-go" /></div>
                        <div class="field"><label for="ws-max">Max results (1–3)</label><input id="ws-max" class="input mono" type="number" min="1" max="3" @bind="w.MaxResults" @bind:event="oninput" /></div>
                        <div class="field"><label for="ws-to">Timeout (seconds, 1–30)</label><input id="ws-to" class="input mono" type="number" min="1" max="30" @bind="w.TimeoutSeconds" @bind:event="oninput" /></div>
                    </div>
                </div>
            </EditDialog>
        }

        <section class="panel" aria-labelledby="apps-link-h">
            <div class="panel-head">
                <h2 id="apps-link-h">Applications &amp; workload profiles</h2>
                <span class="panel-sub">Server configuration · edited with the routing policies</span>
            </div>
            <div class="btn-row">
                <span class="secondary row-main">Workload profiles (trusted baselines) and which existing applications may use them, their default profile, console testing and output bound.</span>
                <a class="btn" href="policies#applications">Open under Policies</a>
            </div>
        </section>

        <section class="panel" aria-labelledby="pref-h">
            <div class="panel-head">
                <h2 id="pref-h">Console preferences</h2>
                <span class="panel-sub">This browser only · saved immediately · never sent to the server</span>
            </div>
            <div class="form-grid">
                <div class="field">
                    <span class="field-label" id="theme-l">Theme</span>
                    <div class="seg" role="radiogroup" aria-labelledby="theme-l">
                        <button type="button" role="radio" aria-checked="@(_theme == "dark" ? "true" : "false")" @onclick="@(() => SetThemeAsync("dark"))"><Icon Name="moon" Size="16" /> Dark</button>
                        <button type="button" role="radio" aria-checked="@(_theme == "light" ? "true" : "false")" @onclick="@(() => SetThemeAsync("light"))"><Icon Name="sun" Size="16" /> Light</button>
                    </div>
                </div>
                <div class="field">
                    <span class="field-label" id="stream-l">Default response mode for new requests</span>
                    <div class="seg" role="radiogroup" aria-labelledby="stream-l">
                        <button type="button" role="radio" aria-checked="@(Pg.StreamingDefault ? "true" : "false")" @onclick="@(() => SetStreamingAsync(true))">Streamed</button>
                        <button type="button" role="radio" aria-checked="@(!Pg.StreamingDefault ? "true" : "false")" @onclick="@(() => SetStreamingAsync(false))">Buffered</button>
                    </div>
                    <span class="help">Used when the composer starts empty; each run can still change it under Advanced.</span>
                </div>
            </div>
            @if (_prefNote is { } pn)
            {
                <span class="note" role="status">@pn</span>
            }
            <span class="note">Presentation mode follows the operating system's reduced-motion setting; open it from the Playground.</span>
        </section>

        @if (State.LastStatus is { } s)
        {
            <section class="panel" aria-labelledby="diag-h">
                <div class="panel-head">
                    <h2 id="diag-h">Diagnostics</h2>
                    <span class="panel-sub">Read-only · live mode and active version, plus startup values (those need a restart to change)</span>
                </div>
                <FactList Inline="true" Facts="@SummaryFacts(s)" />
                <details class="tech">
                    <summary>Technical details</summary>
                    <FactList Facts="@DiagnosticFacts(s)" />
                    <span class="note">Restart-only (never editable in the console): Admin:Token, secret values, Auth:Keys key values, Audit:*, Config:Path, Providers:ProbeAllowList (egress allow-list), Providers:LocalEndpoints. After configuration v1 exists, legacy routing keys (Providers:Mode, OpenAI:*, Local:*, Budget:*, Pricing:*, Routing:*) are ignored; the Host logs each ignored key at startup.</span>
                </details>
            </section>

            <section class="panel" aria-labelledby="ses-h">
                <div class="panel-head">
                    <h2 id="ses-h">This console session</h2>
                    <span class="panel-sub">Shared admin token in this tab's session storage; disconnecting does not pause Covenant</span>
                </div>
                <FactList Facts="@SessionFacts()" />
                <div class="btn-row">
                    <Button OnClick="DisconnectAsync">Disconnect</Button>
                </div>
            </section>

            <section class="panel maintenance" aria-labelledby="mt-h">
                <div class="panel-head">
                    <h2 id="mt-h">Maintenance — archive the audit segment</h2>
                    <span class="panel-sub">Separate from accounting · not a demo step · not a fix for an exhausted budget</span>
                </div>
                <ul class="plain-list secondary muted">
                    <li>The current audit segment is closed and archived beside the log with a timestamp. Nothing is deleted; the archive stays independently verifiable and browsable under Requests (segment selector).</li>
                    <li>@AccountingImpact</li>
                    <li>Budget period rollover is a different thing: it happens by UTC date and never archives evidence.</li>
                </ul>
                <ErrorBanner Title="Archive failed" Message="@_resetError" />
                @if (_resetResult is { } done)
                {
                    <div class="alert ok" role="status">
                        <div class="alert-text">
                            <strong>Audit segment archived (confirmed by the Host)</strong>
                            <span class="alert-body">@(done.ArchivedTo is { Length: > 0 } ? "Archived to " + done.ArchivedTo + ". " : "The segment was empty; nothing to archive. ")A new segment has started.</span>
                        </div>
                        <a class="btn" href="audit">Open Audit &amp; evidence</a>
                    </div>
                }
                @if (!s.ChainValid)
                {
                    <AlertCard Tone="bad" Title="Chain verification is failing — do not archive" Body="Investigate the current segment first. Archiving would move an unverifiable segment out of the default view." ActionText="Open Audit & evidence" ActionHref="audit" />
                }
                else
                {
                    <div class="btn-row">
                        <Button Id="reset-open" Variant="danger" OnClick="OpenConfirm" Disabled="@_resetting">Archive audit segment…</Button>
                    </div>
                }
            </section>

            <Drawer Mode="dialog" Title="@("Archive the audit segment of " + State.EnvironmentLabel + "?")" @bind-Open="_confirmOpen" OpenerId="reset-open">
                <p class="secondary">This archives the <strong>current audit segment</strong> of environment <span class="mono">@State.EnvironmentLabel</span> (@Fmt.Int(s.AuditEntries) entries) and starts a new one. Nothing is deleted.</p>
                <p class="secondary">@AccountingImpact</p>
                @if (State.Paused)
                {
                    <p class="secondary note warn">New provider calls are paused; archiving does not resume them.</p>
                }
                <div class="field">
                    <label for="envname">Type the environment name (<span class="mono">@State.EnvironmentLabel</span>) to confirm</label>
                    <input id="envname" class="input mono" type="text" autocomplete="off" spellcheck="false" @bind="_typed" @bind:event="oninput" disabled="@_resetting" />
                </div>
                <div class="btn-row" style="justify-content:flex-end">
                    <Button OnClick="@(() => _confirmOpen = false)" Disabled="@_resetting">Cancel</Button>
                    <Button Variant="danger" OnClick="ResetAsync" Busy="@_resetting" BusyText="Archiving…" Disabled="@(!CanConfirm)">Archive segment</Button>
                </div>
            </Drawer>
        }
        else
        {
            <ErrorBanner Title="Status unavailable" Message="@(State.FeedError ?? "No status snapshot has been received from the Host yet.")" />
        }
    </RequiresConnection>
</div>

@code {
    private string _theme = "dark";
    private string? _prefNote;
    private bool _confirmOpen;
    private string _typed = "";
    private bool _resetting;
    private string? _resetError;
    private ResetResponse? _resetResult;
    private WebSearchStatusDto? _ws;
    private string? _wsError;
    /// <summary>null = not checked yet; true = GET /admin/budgets answered (ADR-0014 ledger); false = 404 (pre-v2 counters).</summary>
    private bool? _ledger;

    private bool CanEdit => Editor.Applied?.Config is not null && !Editor.Saving && !_saving && (!Editor.IsDirty || Editor.Owner == "settings");

    private EntityEdit<OperationalSettingsDto>? _op;
    private EntityEdit<WebSearchSettingsDto>? _wsEdit;
    private bool _saving;
    private string? _saveError;
    private string? _saveErrorTitle;
    private string _saveErrorTone = "bad";
    private IReadOnlyList<ConfigIssueDto>? _issues;
    private string? _notice;
    private bool CanConfirm => !_resetting && string.Equals(_typed.Trim(), State.EnvironmentLabel, StringComparison.Ordinal);

    private string AccountingImpact => _ledger switch
    {
        true => "Budgets are NOT reopened and spend is NOT reset: spend and reservations live in the budget ledger, independent of audit segments (ADR-0014).",
        false => "This Host has no budget ledger yet (GET /admin/budgets is missing): on it, archiving ALSO resets the pre-v2 spend counters, so reached budgets reopen.",
        null => "Accounting impact is being checked (budget ledger present or not)…",
    };

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Interop.ThemeChanged += OnThemeChanged;
        Editor.Changed += OnChanged;
        Pg.Changed += OnChanged;
        await Editor.EnsureLoadedAsync();
        await CheckLedgerAsync();
        await LoadWebSearchAsync();
    }

    private async Task LoadWebSearchAsync()
    {
        if (!State.Connected) return;
        try
        {
            _ws = await Api.GetWebSearchStatusAsync();
            _wsError = null;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound)
        {
            _ws = null;
            _wsError = "This Host does not support governed web search (GET /admin/web-search is missing).";
        }
        catch (Exception ex)
        {
            _ws = null;
            _wsError = "Web search status unavailable: " + ex.Message;
        }
    }

    private void ResetResult()
    {
        _saveError = null;
        _saveErrorTitle = null;
        _saveErrorTone = "bad";
        _issues = null;
        _notice = null;
    }

    private void OpenOperational()
    {
        if (Editor.Applied?.Config?.Settings is not { } st) return;
        ResetResult();
        _op = EntityEdits.Edit(st);
        _op.BaseVersion = Editor.AppliedVersion;
    }

    private void OpenWebSearch()
    {
        if (Editor.Applied?.Config is not { } cfg) return;
        ResetResult();
        _wsEdit = EntityEdits.Edit(cfg.WebSearch);
        _wsEdit.BaseVersion = Editor.AppliedVersion;
    }

    private void CloseDialogs()
    {
        _op = null;
        _wsEdit = null;
    }

    private void DiscardScoped()
    {
        Editor.DiscardIfOwner("settings");
        ResetResult();
    }

    private async Task SaveAsync(int? openedAt, Func<CovenantConfigDto, string?> change, string summary)
    {
        _saving = true;
        _saveError = null;
        _issues = null;
        try
        {
            var outcome = await Editor.ApplyScopedAsync("settings", openedAt, change, summary);
            if (outcome.Succeeded)
            {
                _notice = outcome.Message + ".";
                CloseDialogs();
                await LoadWebSearchAsync();
                return;
            }
            _saveErrorTitle = outcome.Kind == EditOutcomeKind.Stale ? "The configuration changed meanwhile" : outcome.Kind == EditOutcomeKind.Invalid ? "The Host rejected this change" : "Not saved";
            _saveErrorTone = outcome.Kind == EditOutcomeKind.Stale ? "warn" : "bad";
            _saveError = outcome.Message;
            _issues = outcome.Errors;
        }
        finally
        {
            _saving = false;
        }
    }

    private static IReadOnlyList<FactList.Fact> OperationalFacts(OperationalSettingsDto s) =>
    [
        new("Exact cache", s.CacheTtlSeconds is > 0 ? s.CacheTtlSeconds.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + " s · max " + (s.CacheMaxEntries?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "default") + " entries" : "Off"),
        new("Prompt preview in evidence", s.PromptPreviewChars is > 0 ? s.PromptPreviewChars.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + " characters" : "None (fingerprint only)"),
        new("Live trace retention", (s.TraceRetentionMinutes?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "default") + " min"),
        new("Rate limits", Limit(s.RateLimitGlobalPerMinute) + " all · " + Limit(s.RateLimitPerTeamPerMinute) + " per team"),
    ];

    private static string Limit(int? perMinute) => perMinute is > 0 ? perMinute.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + "/min" : "off";

    private string WebSearchSummary(WebSearchStatusDto s)
    {
        var cfg = Editor.Applied?.Config?.WebSearch;
        if (cfg is null) return "Not configured (disabled).";
        var price = cfg.PricePerCreditUsd is { } p ? Money.Usd(p) + " per credit" : "no price";
        return (cfg.Enabled ? "Enabled" : "Disabled") + " · " + price + " · up to " + cfg.MaxResults.ToString(System.Globalization.CultureInfo.InvariantCulture)
               + " results · " + cfg.TimeoutSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture) + " s timeout"
               + (s.ProfilesAllowed.Count > 0 ? " · allowed on " + string.Join(", ", s.ProfilesAllowed) : "");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _theme = await Interop.GetThemeAsync(); } catch (JSException) { _theme = "dark"; }
        StateHasChanged();
    }

    private async Task CheckLedgerAsync()
    {
        if (!State.Connected) return;
        try
        {
            await Api.GetBudgetsAsync();
            _ledger = true;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound)
        {
            _ledger = false;
        }
        catch (Exception)
        {
            _ledger = null; // unknown: the confirmation keeps saying so
        }
    }

    private async Task SetThemeAsync(string theme)
    {
        try
        {
            _theme = await Interop.SetThemeAsync(theme);
            _prefNote = "Theme saved in this browser.";
        }
        catch (JSException)
        {
            _prefNote = "The browser refused to store the theme.";
        }
    }

    private async Task SetStreamingAsync(bool streaming)
    {
        Pg.SetStreamingDefault(streaming);
        bool stored;
        try { stored = await Interop.PrefSetAsync("stream-default", streaming ? "true" : "false"); }
        catch (JSException) { stored = false; }
        _prefNote = stored ? "Default response mode saved in this browser." : "Applied for this session; the browser did not store it.";
    }

    private IReadOnlyList<FactList.Fact> SummaryFacts(StatusReport s) =>
    [
        new("Environment", s.Environment ?? NotReported, true),
        new("Mode", ShellStatus.Mode(Editor.Applied?.Config?.Mode ?? s.Mode).Label),
        new("Active configuration", (Editor.AppliedVersion ?? s.ConfigVersion) is { } v ? "v" + v.ToString(System.Globalization.CultureInfo.InvariantCulture) : NotReported, true),
        new("Started", Fmt.Utc(s.StartedUtc), true),
    ];

    private IReadOnlyList<FactList.Fact> DiagnosticFacts(StatusReport s) =>
    [
        new("Covenant version", s.Version ?? NotReported, true),
        new("Audit log path (Audit:Path)", s.AuditPath ?? NotReported, true),
        new("Anchor (Audit:AnchorPath / AnchorEvery)", AnchorText(s)),
        new("Configuration directory (Config:Path)", NotReported + " (default: beside the audit log, <audit>.config/)"),
        new("Legacy keys ignored after import", NotReported + " — listed in the Host's startup log"),
        new("Probe allow-list (Providers:ProbeAllowList ∪ Local:Endpoint)", State.Catalog?.ProbeAllowList is { Count: > 0 } pl ? string.Join(", ", pl) : NotReported, true),
        new("Egress allow-list", Editor.Applied?.AllowList is { Count: > 0 } al ? string.Join(", ", al) : NotReported, true),
        new("Telemetry (OpenTelemetry)", s.OtelEnabled ? "Enabled — in-perimeter collector" : "Disabled"),
        new("Application keys (Auth:Keys)", Fmt.Int(s.Auth.KeyCount) + (s.Auth.AllowAnonymous ? " · anonymous requests ALLOWED" : " · anonymous requests refused"), true),
    ];

    private const string NotReported = "Not reported by this Host";

    private static string AnchorText(StatusReport s) => s.Anchor switch
    {
        null => NotReported,
        { Configured: false } => "Not configured",
        { Configured: true, Every: { } every } => "Configured · every " + Fmt.Int(every) + " entries",
        _ => "Configured",
    };

    private IReadOnlyList<FactList.Fact> SessionFacts() =>
    [
        new("Credential", "Shared admin token (X-Covenant-Admin-Token) — a shared console operator, not an individual identity", true),
        new("Stored in", "This tab's sessionStorage only; cleared on disconnect or when the tab closes"),
        new("Status feed", State.FeedMode switch { FeedMode.Stream => "Live stream", FeedMode.Polling => "Polling every 3 s (stream unavailable)", _ => "Not running" }),
        new("Application key", "Never held — console requests run as an authorized test application (ADR-0012)"),
    ];

    private void OpenConfirm()
    {
        _confirmOpen = true;
        _typed = "";
        _resetError = null;
    }

    private async Task ResetAsync()
    {
        if (!CanConfirm) return;
        _resetting = true;
        _resetError = null;
        _resetResult = null;
        try
        {
            _resetResult = await Api.ResetAsync();
            _confirmOpen = false;
        }
        catch (Exception ex)
        {
            _resetError = ex.Message;
            _confirmOpen = false;
        }
        finally
        {
            _resetting = false;
            _typed = "";
        }
        // Never assume the outcome: re-sync from the server either way.
        await Session.TryRefreshAsync();
    }

    private async Task DisconnectAsync()
    {
        await Session.DisconnectAsync("Disconnected");
        Nav.NavigateTo("connect");
    }

    private void OnThemeChanged(string theme) { _theme = theme; _ = InvokeAsync(StateHasChanged); }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Interop.ThemeChanged -= OnThemeChanged;
        Editor.Changed -= OnChanged;
        Pg.Changed -= OnChanged;
    }
}
