@page "/"
@inject AppState State
@inject ConsoleSession Session
@inject WorkspaceConfig Ws
@inject PlaygroundState Pg
@implements IDisposable

<PageTitle>Overview · Covenant</PageTitle>

@* T07 Overview: setup checks (each missing item links to the exact page/action — and none of them is a
   "demo ready" verdict), spend/request metrics for the labelled audit segment, recent outcomes, a modest
   activity chart, and the shared composer (same state as Playground; Run is explicit). *@

<div class="page">
    <RequiresConnection>
        @if (State.LastStatus is not { } s)
        {
            <ErrorBanner Title="Status unavailable" Message="@(State.FeedError ?? "No status snapshot has been received from the Host yet.")" />
        }
        else
        {
            var f = s.FinOps;
            <div class="page-head">
                <div class="titles">
                    <h1>Overview</h1>
                    <span class="lede">@SegmentLabel(s)</span>
                </div>
                <a class="btn" href="requests"><Icon Name="requests" Size="16" /><span>View requests</span></a>
            </div>

            <div class="ov-top">
                <section class="panel" aria-labelledby="checks-h">
                    <div class="panel-head">
                        <h2 id="checks-h">Setup checks</h2>
                        <span class="panel-sub">Each check stands alone</span>
                    </div>
                    <ul class="check-list">
                        @foreach (var c in Checks(s))
                        {
                            <li class="check @c.Tone" title="@c.Title">
                                <span class="dot @c.Tone" aria-hidden="true"></span>
                                <span class="check-name">@c.Name</span>
                                <span class="check-value">
                                    <span class="check-status">@c.Value</span>
                                    @if (c.Id is { Length: > 0 } cid)
                                    {
                                        <span class="check-id mono">@cid</span>
                                    }
                                </span>
                                @if (c.ActionText is not null && c.Href is not null)
                                {
                                    <a class="check-action" href="@c.Href" aria-label="@(c.ActionText + " — " + c.Name)">@c.ActionText</a>
                                }
                                else if (c.ActionText is not null && c.Resume)
                                {
                                    <button type="button" class="btn sm check-action" disabled="@_busy" @onclick="ResumeAsync" aria-label="Resume provider calls"><Icon Name="play" Size="14" /><span>@c.ActionText</span></button>
                                }
                            </li>
                        }
                    </ul>
                </section>

                <section class="panel" aria-labelledby="ov-run-h">
                    <div class="panel-head">
                        <h2 id="ov-run-h">Run a request</h2>
                        <a class="secondary" href="playground">Open the full Playground</a>
                    </div>
                    <RequestComposer Compact="true" IdPrefix="ov" />
                    @if (Pg.Selected is { } run)
                    {
                        <div class="ov-result">
                            <span class="secondary subtle">@run.Snapshot.Title</span>
                            @if (run.Text.Length > 0)
                            {
                                <div class="ov-response" aria-label="Response text">@run.Text</div>
                            }
                            else if (run.InFlight)
                            {
                                <span role="status">Waiting for the response…</span>
                            }
                            <WebSourcesPanel Run="run" />
                            <details class="tech" open="@(run.Text.Length == 0 && !run.InFlight)">
                                <summary>Request outcome and cost</summary>
                                <RunSummary Run="run" />
                            </details>
                            <TraceBar Trace="run.CurrentTrace" FeedState="run.TraceState" Message="@run.TraceMessage" Compact="true" />
                            <a class="secondary" href="playground">See the response and details in Playground</a>
                        </div>
                    }
                </section>
            </div>

            <dl class="summary-grid">
                <div class="summary-card">
                    <dt>Served</dt>
                    <dd class="value">@Fmt.Int(f.Allowed)</dd>
                    <dd class="hint">@(f.CacheHits > 0 ? $"Including {Fmt.Int(f.CacheHits)} from cache" : "Allowed and answered")</dd>
                </div>
                <div class="summary-card">
                    <dt>Refused or failed</dt>
                    <dd class="value">@Fmt.Int(f.Denied)</dd>
                    <dd class="hint">Each one is an audit entry</dd>
                </div>
                <div class="summary-card">
                    <dt>Estimated provider charges</dt>
                    <dd class="value">@Fmt.Usd(f.TotalCostUsd)</dd>
                    <dd class="hint">Infrastructure excluded</dd>
                </div>
                <div class="summary-card">
                    <dt>Global budget used</dt>
                    <dd class="value">@Fmt.Percent(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd)</dd>
                    <dd class="hint">@Fmt.Usd(s.Budget.GlobalSpendUsd) of @Fmt.UsdTotal(s.Budget.GlobalCapUsd)</dd>
                    <dd>
                        <span class="meter @MeterTone(s)" role="img" aria-label="@(Fmt.Percent(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd) + " of the global cap used")">
                            <span style="width:@(Fmt.PercentClamped(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd))%"></span>
                        </span>
                    </dd>
                </div>
            </dl>

            <div class="two-col">
                <section class="panel flush" aria-labelledby="recent-h" style="flex:1.3 1 420px">
                    <div class="panel-head">
                        <h2 id="recent-h">Recent outcomes</h2>
                        <a href="requests" class="secondary">All requests</a>
                    </div>
                    @if (f.Recent.Count == 0)
                    {
                        <p class="secondary muted pad">No requests recorded in this segment yet.</p>
                    }
                    else
                    {
                        <ul class="row-list">
                            @foreach (var r in f.Recent.Take(6))
                            {
                                <li>
                                    <span class="mono secondary subtle">@Fmt.UtcShort(r.T)</span>
                                    <StatusPill Kind="@StatusPill.KindFor(r.Effect, null)" />
                                    <span class="secondary muted row-main">
                                        <span class="mono">@(r.Model ?? "no model")</span> · <span class="mono">@r.Team</span>
                                        @if (!string.Equals(r.Effect, "Allow", StringComparison.OrdinalIgnoreCase) && r.Reason.Length > 0)
                                        {
                                            <span> · @r.Reason</span>
                                        }
                                    </span>
                                    <a class="mono secondary" href="@("requests/" + Uri.EscapeDataString(r.Id))" aria-label="@("Open request " + r.Id)">Open</a>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="panel" aria-labelledby="act-h" style="flex:1 1 340px">
                    <div class="panel-head">
                        <h2 id="act-h">Activity</h2>
                        <span class="panel-sub">@ActivityWindow(f)</span>
                    </div>
                    @if (f.Activity.Count == 0)
                    {
                        <p class="secondary muted">Requests per minute appear once the first request is recorded.</p>
                    }
                    else
                    {
                        var peakReq = Math.Max(1, f.Activity.Max(b => b.Requests));
                        <div class="chart">
                            <div class="legend">
                                <span><span class="swatch" style="background:var(--accent)"></span>Served</span>
                                <span><span class="swatch" style="background:var(--amber)"></span>Refused or failed</span>
                                <span class="subtle">peak @peakReq / min</span>
                            </div>
                            <div class="bars short" role="img" aria-label="@($"Requests per minute over {f.Activity.Count} minutes, peak {peakReq}")">
                                @foreach (var b in f.Activity)
                                {
                                    var served = b.Requests - b.Denied;
                                    <div class="bar" title="@($"{Fmt.UtcShort(b.T)} UTC · {b.Requests} requests, {b.Denied} refused · {Fmt.Usd(b.CostUsd)}")">
                                        <div class="refused" style="height:@(Pct(b.Denied, peakReq))%"></div>
                                        <div class="served" style="height:@(Pct(served, peakReq))%"></div>
                                    </div>
                                }
                            </div>
                            <div class="axis"><span>@Fmt.UtcShort(f.Activity[0].T) UTC</span><span>@Fmt.UtcShort(f.Activity[^1].T) UTC</span></div>
                        </div>
                    }
                    @if (f.DenialsByReason.Count > 0)
                    {
                        <details class="tech">
                            <summary>Refusals by reason (@Fmt.Int(f.DenialsByReason.Values.Sum()))</summary>
                            <table class="secondary">
                                <tbody>
                                    @foreach (var kv in f.DenialsByReason.OrderByDescending(k => k.Value))
                                    {
                                        <tr><td class="wrap-any">@kv.Key</td><td class="num mono">@Fmt.Int(kv.Value)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    }
                </section>
            </div>
        }
    </RequiresConnection>
</div>

@code {
    /// <summary>One setup check. <see cref="Value"/> is a short status (no ids); <see cref="Id"/> (a scope or connection id)
    /// is rendered separately and is the only part allowed to break anywhere; <see cref="Title"/> holds the long form.</summary>
    private sealed record Check(string Name, string Value, string Tone, string? ActionText = null, string? Href = null, bool Resume = false,
        string? Id = null, string? Title = null);

    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Ws.Changed += OnChanged;
        Pg.Changed += OnChanged;
        await Ws.EnsureLoadedAsync();
    }

    private IEnumerable<Check> Checks(StatusReport s)
    {
        var fresh = ShellStatus.Freshness(State.Connected, State.IsStale, State.LastUpdatedUtc, DateTimeOffset.UtcNow, State.FeedError);
        yield return fresh.Stale
            ? new Check("Console", "Status " + fresh.Label.ToLowerInvariant(), "warn", Title: "Connected; the status feed is stale and retrying")
            : new Check("Console", "Live", "ok", Title: "Connected · live status");

        var mode = ShellStatus.Mode(s.Mode);
        yield return mode.Tone == "unknown"
            ? new Check("Mode", "Not reported", "warn", "Open", "connections", Title: ShellStatus.ModeNotReported)
            : new Check("Mode", mode.Label, mode.Tone == "legacy" ? "warn" : "ok", mode.Tone == "legacy" ? "Review" : null, mode.Tone == "legacy" ? "policies" : null, Title: mode.Description);

        var local = RouteHealth.LocalRoute(State.Catalog, State.LastStatus, DateTimeOffset.UtcNow);
        yield return local.State switch
        {
            LocalRouteState.Ready => new Check("Local route", "Ready", "ok", Id: local.Target, Title: local.Text),
            LocalRouteState.Degraded => new Check("Local route", "Degraded", "warn", "Review", "connections", Id: local.Target, Title: local.Text + (local.LastError is { Length: > 0 } le ? " · " + le : "")),
            LocalRouteState.NotRegistered => new Check("Local route", "Not registered", "bad", "Fix", "connections", Id: local.Target, Title: local.Text),
            LocalRouteState.NotConfigured => new Check("Local route", "Not configured", "warn", "Add", "connections", Title: "No local connection — sensitive requests will be refused"),
            LocalRouteState.NotObserved => new Check("Local route", "Not yet observed", "hollow", "Test", "connections", Id: local.Target, Title: local.Text),
            _ => new Check("Local route", "Unknown", "hollow", "Open", "connections", Title: State.CatalogError ?? local.Text),
        };

        yield return State.Paused
            ? new Check("Provider calls", "Paused", "warn", "Resume", Resume: true, Title: string.IsNullOrWhiteSpace(s.KillSwitch.Reason) ? "Paused" : "Paused — " + s.KillSwitch.Reason)
            : new Check("Provider calls", "Accepted", "ok");

        yield return BudgetCheck(s);

        if (Ws.ApplicationsError is { } ae)
            yield return new Check("Test applications", "Unavailable", "warn", Title: ae);
        else if (Ws.Applications is { } apps)
        {
            int testable = apps.Count(a => ComposerRules.WhyNotSelectable(a) is null);
            yield return testable == 0
                ? new Check("Test applications", "None testable", "warn", "Settings", "settings", Title: "No application is enabled for console testing")
                : new Check("Test applications", testable.ToString(System.Globalization.CultureInfo.InvariantCulture) + " available", "ok", Title: "Applications the console can run as");
        }

        yield return s.ChainValid
            ? new Check("Audit chain", "Verifies", "ok", Title: "The current segment's hash chain verifies")
            : new Check("Audit chain", "Fails", "bad", "Open", "evidence", Title: "The current segment's hash chain does not verify");
    }

    private Check BudgetCheck(StatusReport s)
    {
        if (Ws.Budgets is { Count: > 0 } budgets)
        {
            var worst = budgets.FirstOrDefault(b => string.Equals(b.Warning, "exceeded", StringComparison.OrdinalIgnoreCase))
                        ?? budgets.FirstOrDefault(b => string.Equals(b.Warning, "critical", StringComparison.OrdinalIgnoreCase))
                        ?? budgets.FirstOrDefault(b => string.Equals(b.Warning, "warn", StringComparison.OrdinalIgnoreCase));
            if (worst is null) return new Check("Budgets", "No warning", "ok", Title: "No budget has reached a warning threshold");
            var tone = string.Equals(worst.Warning, "warn", StringComparison.Ordinal) ? "warn" : "bad";
            return new Check("Budgets", worst.Warning + " · " + Fmt.Percent(worst.SpentUsd, worst.CapUsd), tone, "Open", "budgets", Id: worst.Scope,
                Title: worst.Scope + ": " + worst.Warning + " · " + Fmt.Usd(worst.SpentUsd) + " of " + Fmt.UsdTotal(worst.CapUsd));
        }
        var pct = Fmt.PercentClamped(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd);
        if (s.Budget.GlobalCapUsd <= 0) return new Check("Budgets", "No global cap", "hollow", "Open", "budgets");
        var used = Fmt.Percent(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd) + " of global";
        var title = Fmt.Usd(s.Budget.GlobalSpendUsd) + " of " + Fmt.UsdTotal(s.Budget.GlobalCapUsd);
        return pct >= 95
            ? new Check("Budgets", used, "bad", "Open", "budgets", Title: title)
            : pct >= 80
                ? new Check("Budgets", used, "warn", "Open", "budgets", Title: title)
                : new Check("Budgets", used, "ok", Title: title);
    }

    private static int Pct(int value, int peak) => peak <= 0 ? 0 : (int)Math.Round(value * 100.0 / peak);

    private static string MeterTone(StatusReport s)
    {
        var pct = Fmt.PercentClamped(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd);
        return pct >= 100 ? "bad" : pct >= 80 ? "warn" : "";
    }

    /// <summary>Totals cover the current audit segment. Its start is the oldest activity bucket when there is any
    /// (the Host's segment first_utc is not in /admin/status); otherwise we say so rather than guess.</summary>
    private static string SegmentLabel(StatusReport s)
    {
        var oldest = s.FinOps.Activity.Count > 0 ? s.FinOps.Activity[0].T : (DateTimeOffset?)null;
        return oldest is null
            ? "Totals cover the current audit segment (no entries yet). Opening this page never resets accounting."
            : "Totals cover the current audit segment since " + Fmt.Utc(oldest) + ". Opening this page never resets accounting.";
    }

    private static string ActivityWindow(FinOpsSummary f)
    {
        if (f.Activity.Count == 0) return "Per minute · nothing recorded";
        var span = f.Activity[^1].T - f.Activity[0].T + TimeSpan.FromMinutes(1);
        return $"Per minute · {Fmt.Duration(span)} to {Fmt.UtcShort(f.Activity[^1].T)} UTC";
    }

    private async Task ResumeAsync()
    {
        _busy = true;
        await Session.SetPausedAsync(false, null);
        _busy = false;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Ws.Changed -= OnChanged;
        Pg.Changed -= OnChanged;
    }
}
