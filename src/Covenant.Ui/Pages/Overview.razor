@page "/"
@inject AppState State
@inject ConsoleSession Session
@implements IDisposable

<PageTitle>Overview · Covenant</PageTitle>

<div class="page">
    <RequiresConnection>
        @if (State.LastStatus is not { } s)
        {
            <ErrorBanner Title="Status unavailable" Message="@(State.FeedError ?? "No status snapshot has been received from the Host yet.")" />
        }
        else
        {
            var f = s.FinOps;

            @* ---- What needs attention (first) ---- *@
            if (State.Paused)
            {
                <AlertCard Tone="warn" Title="New provider calls paused"
                           Body="@("Requests that need a provider call are refused at the pause stage. " + (string.IsNullOrWhiteSpace(s.KillSwitch.Reason) ? "No reason recorded." : "Reason: " + s.KillSwitch.Reason))"
                           ActionText="Resume" Busy="@_busy" OnAction="ResumeAsync" />
            }
            if (!s.ChainValid)
            {
                <AlertCard Tone="bad" Title="Audit chain verification failed"
                           Body="The hash chain of the current audit segment does not verify. Do not archive or reset; open Evidence for the failure detail."
                           ActionText="Open evidence" ActionHref="evidence" />
            }
            if (State.IsStale)
            {
                <AlertCard Tone="warn" Title="Status is stale"
                           Body="@(State.FeedError ?? ("No status update for " + Fmt.Ago(State.LastUpdatedUtc, DateTimeOffset.UtcNow) + ". Totals below are from the last snapshot."))"
                           ActionText="Refresh now" Busy="@_refreshing" OnAction="RefreshAsync" />
            }
            if (RouteHealth.LocalRouteMissing(s, State.Catalog))
            {
                <AlertCard Tone="warn" Title="Local route has no registered adapter"
                           Body="Policy permits the local route but nothing serves it. Matching requests pass routing and are refused at the Provider stage — never sent elsewhere."
                           ActionText="Review connection" ActionHref="connections" />
            }
            var localRoute = RouteHealth.LocalRoute(State.Catalog, DateTimeOffset.UtcNow);
            if (localRoute.State == LocalRouteState.Degraded)
            {
                <AlertCard Tone="warn" Title="@localRoute.Text"
                           Body="@("The most recent observed call or probe of the local model failed" + (localRoute.LastError is { Length: > 0 } le ? " (" + le + ")" : "") + ". Requests routed to it fail closed; they are never sent elsewhere.")"
                           ActionText="Review connection" ActionHref="connections" />
            }
            if (State.Catalog is null && State.CatalogError is not null)
            {
                <AlertCard Tone="info" Title="Route health unknown" Body="@("The provider catalog could not be read (" + State.CatalogError + "), so unresolved routes cannot be detected.")" />
            }
            if (!State.Paused && s.ChainValid && !State.IsStale && !RouteHealth.LocalRouteMissing(s, State.Catalog) && localRoute.State != LocalRouteState.Degraded && State.Catalog is not null)
            {
                <div class="alert ok" role="status">
                    <div class="alert-text">
                        <strong>Nothing needs attention</strong>
                        <span class="alert-body">New provider calls are accepted, the audit chain verifies, and every configured route has a registered adapter.</span>
                    </div>
                </div>
            }

            <div class="page-head">
                <div class="titles">
                    <h1>Overview</h1>
                    <span class="lede">@SegmentLabel(s). Opening this page never resets accounting.</span>
                </div>
                <a class="btn form" href="requests">View requests</a>
                <a class="btn primary form" href="playground">Run a request</a>
            </div>

            @* ---- Summary row ---- *@
            <dl class="summary-grid">
                <div class="summary-card">
                    <dt>Served</dt>
                    <dd class="value">@Fmt.Int(f.Allowed)</dd>
                    <dd class="hint">@(f.CacheHits > 0 ? $"Including {Fmt.Int(f.CacheHits)} served from cache" : "Allowed by policy and answered")</dd>
                </div>
                <div class="summary-card">
                    <dt>Refused or failed</dt>
                    <dd class="value">@Fmt.Int(f.Denied)</dd>
                    <dd class="hint">Every refusal is an audit entry · reasons below</dd>
                </div>
                <div class="summary-card">
                    <dt>Estimated provider charges</dt>
                    <dd class="value">@Fmt.Usd(f.TotalCostUsd)</dd>
                    <dd class="hint">Reported tokens × configured prices · infrastructure excluded</dd>
                </div>
                <div class="summary-card">
                    <dt>Global budget used</dt>
                    <dd class="value">@Fmt.Percent(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd)</dd>
                    <dd class="hint">@Fmt.Usd(s.Budget.GlobalSpendUsd) of @Fmt.UsdTotal(s.Budget.GlobalCapUsd) cap</dd>
                    <dd>
                        <span class="meter @MeterTone(s)" role="img" aria-label="@(Fmt.Percent(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd) + " of the global cap used")">
                            <span style="width:@(Fmt.PercentClamped(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd))%"></span>
                        </span>
                    </dd>
                </div>
            </dl>

            <div class="alert @(s.ChainValid ? "ok" : "bad")" role="status">
                <span class="indicator">
                    <span class="dot @(s.ChainValid ? "ok" : "bad")" aria-hidden="true"></span>
                    @(s.ChainValid ? "Audit chain verifies" : "Audit chain verification FAILED")
                </span>
                <span class="subtle secondary">Checked @Fmt.Ago(State.LastUpdatedUtc, DateTimeOffset.UtcNow) · @Fmt.Int(s.AuditEntries) entries in this segment</span>
                <a href="evidence">Open evidence</a>
            </div>

            @* ---- Activity ---- *@
            <section class="panel" aria-labelledby="act-h">
                <div class="panel-head">
                    <h2 id="act-h">Activity</h2>
                    <span class="panel-sub">@ActivityWindow(f)</span>
                </div>
                @if (f.Activity.Count == 0)
                {
                    <EmptyState Title="No activity in this segment" Body="Requests per minute appear here once the first request is recorded." />
                }
                else
                {
                    var peakReq = Math.Max(1, f.Activity.Max(b => b.Requests));
                    var peakCost = f.Activity.Max(b => b.CostUsd);
                    <div class="chart">
                        <div class="legend">
                            <span class="title">Requests per minute</span>
                            <span><span class="swatch" style="background:var(--accent)"></span>Served</span>
                            <span><span class="swatch" style="background:var(--amber)"></span>Refused or failed</span>
                            <span class="subtle">peak @peakReq / min</span>
                        </div>
                        <div class="bars" role="img" aria-label="@($"Requests per minute over {f.Activity.Count} minutes, peak {peakReq}")">
                            @foreach (var b in f.Activity)
                            {
                                var served = b.Requests - b.Denied;
                                <div class="bar" title="@($"{Fmt.UtcShort(b.T)} UTC · {b.Requests} requests, {b.Denied} refused")">
                                    <div class="refused" style="height:@(Pct(b.Denied, peakReq))%"></div>
                                    <div class="served" style="height:@(Pct(served, peakReq))%"></div>
                                </div>
                            }
                        </div>
                        <div class="axis"><span>@Fmt.UtcShort(f.Activity[0].T) UTC</span><span>@Fmt.UtcShort(f.Activity[^1].T) UTC</span></div>
                    </div>
                    <div class="chart">
                        <div class="legend">
                            <span class="title">Estimated provider charges per minute (USD)</span>
                            <span class="subtle">peak @Fmt.Usd(peakCost) / min</span>
                        </div>
                        <div class="bars short" role="img" aria-label="@($"Estimated provider charges per minute, peak {Fmt.Usd(peakCost)}")">
                            @foreach (var b in f.Activity)
                            {
                                <div class="bar" title="@($"{Fmt.UtcShort(b.T)} UTC · {Fmt.Usd(b.CostUsd)}")">
                                    <div class="cost" style="height:@(peakCost > 0 ? (int)Math.Round(b.CostUsd / peakCost * 100m) : 0)%"></div>
                                </div>
                            }
                        </div>
                        <div class="axis"><span>@Fmt.UtcShort(f.Activity[0].T) UTC</span><span>@Fmt.UtcShort(f.Activity[^1].T) UTC</span></div>
                    </div>
                }
            </section>

            <div class="two-col">
                <section class="panel flush" aria-labelledby="not-h" style="flex:1.4 1 420px">
                    <div class="panel-head">
                        <h2 id="not-h">Recent notable outcomes</h2>
                        <a href="requests" class="secondary">All requests</a>
                    </div>
                    @if (Notable(f).Count == 0)
                    {
                        <div style="padding:18px"><EmptyState Title="No refusals, failures or pauses recorded" Body="Served requests are listed under Requests." /></div>
                    }
                    else
                    {
                        <ul class="row-list">
                            @foreach (var r in Notable(f))
                            {
                                <li>
                                    <span class="mono secondary subtle">@Fmt.UtcShort(r.T)</span>
                                    <StatusPill Kind="@StatusPill.KindFor(r.Effect, null)" />
                                    <span class="secondary muted" style="flex:1 1 260px">
                                        @r.Reason
                                        @if (r.Model is { Length: > 0 })
                                        {
                                            <span> · </span><span class="mono">@r.Model</span>
                                        }
                                        <span> · </span><span class="mono">@r.Team</span>
                                    </span>
                                    <a class="mono secondary" href="@("requests/" + Uri.EscapeDataString(r.Id))">@r.Id</a>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="panel flush" aria-labelledby="den-h" style="flex:1 1 340px">
                    <div class="panel-head" style="flex-direction:column;align-items:flex-start;gap:0">
                        <h2 id="den-h">Refusals by reason</h2>
                        <span class="panel-sub">This segment, grouped from the audit reason text</span>
                    </div>
                    @if (f.DenialsByReason.Count == 0)
                    {
                        <div style="padding:18px" class="secondary muted">No refusals in this segment.</div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="secondary">
                                <tbody>
                                    @foreach (var kv in f.DenialsByReason.OrderByDescending(k => k.Value))
                                    {
                                        <tr><td>@kv.Key</td><td class="num mono">@Fmt.Int(kv.Value)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        }
    </RequiresConnection>
</div>

@code {
    private bool _busy;
    private bool _refreshing;

    protected override void OnInitialized() => State.Changed += OnChanged;

    private static int Pct(int value, int peak) => peak <= 0 ? 0 : (int)Math.Round(value * 100.0 / peak);

    private static string MeterTone(StatusReport s)
    {
        var pct = Fmt.PercentClamped(s.Budget.GlobalSpendUsd, s.Budget.GlobalCapUsd);
        return pct >= 100 ? "bad" : pct >= 80 ? "warn" : "";
    }

    /// <summary>Totals cover the current audit segment. Its start is the oldest activity bucket when there is any
    /// (the Host's segment first_utc is not in /admin/status); otherwise we say so rather than guess.</summary>
    private static string SegmentLabel(StatusReport s)
    {
        var oldest = s.FinOps.Activity.Count > 0 ? s.FinOps.Activity[0].T : (DateTimeOffset?)null;
        return oldest is null
            ? "Totals cover the current audit segment (no entries yet)"
            : "Current audit segment since " + Fmt.Utc(oldest);
    }

    private static string ActivityWindow(FinOpsSummary f)
    {
        if (f.Activity.Count == 0) return "Per-minute buckets · nothing recorded";
        var span = f.Activity[^1].T - f.Activity[0].T + TimeSpan.FromMinutes(1);
        return $"Per-minute buckets · {Fmt.Duration(span)} ending {Fmt.UtcShort(f.Activity[^1].T)} UTC (most recent hour retained)";
    }

    private static List<RecentRequest> Notable(FinOpsSummary f)
        => f.Recent.Where(r => !string.Equals(r.Effect, "Allow", StringComparison.OrdinalIgnoreCase)).Take(8).ToList();

    private async Task ResumeAsync()
    {
        _busy = true;
        await Session.SetPausedAsync(false, null);
        _busy = false;
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        await Session.TryRefreshAsync();
        _refreshing = false;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
