@page "/playground"
@page "/playground/{Scenario}"
@inject AppState State
@inject PlaygroundState Pg
@inject WorkspaceConfig Ws
@inject Interop Interop
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Playground · Covenant</PageTitle>

@*
  T07 request workspace. Run sends POST /admin/playground/requests (admin token) as the selected test application
  (ADR-0012); the governed pipeline decides. Prompt/composer left, streamed response right, an always-visible
  action bar, the compact outcome line, the real trace (GET /admin/requests/{id}/trace/stream) and ONE details
  drawer with the full facts and evidence. /playground/{A-D} only fills the composer. Nothing is submitted on
  open, on reload or when a history entry is selected.
*@

@if (_present)
{
    <RequiresConnection>
        <div class="present-root" id="pg-present-root" tabindex="-1" role="region" aria-label="Playground presentation mode" @onkeydown="OnPresentKeyDown">
            <header class="present-head">
                <span class="brand">Covenant</span>
                <span class="env" title="Environment">@State.EnvironmentLabel</span>
                @{ var mode = ShellStatus.Mode(State.LastStatus?.Mode); }
                <span class="mode-badge @mode.Tone">@mode.Label</span>
                @if (State.Paused)
                {
                    <span class="indicator"><span class="dot warn" aria-hidden="true"></span>New provider calls paused</span>
                }
                <span class="grow"></span>
                <span class="subtle secondary">Run as <span class="mono">@(Pg.Form.ApplicationId ?? "—")</span>@(Pg.Form.ProfileId is { } pp ? " · " + ComposerRules.ProfileLabel(Ws.Profiles, pp) : "")</span>
                <button type="button" class="btn sm" id="pg-present-exit" @onclick="ExitPresent">Exit presentation <span class="subtle">(Esc)</span></button>
            </header>

            <div class="present-grid">
                <section class="present-prompt" aria-label="Prompt">
                    <label for="pp-prompt" class="field-label">Prompt</label>
                    <textarea id="pp-prompt" class="input textarea" @bind="Pg.Form.Prompt" @bind:event="oninput" @bind:after="Pg.NotifyFormChanged" disabled="@Pg.Running"></textarea>
                    <div class="action-bar">
                        <button type="button" class="btn primary form" disabled="@(!Pg.CanRun)" aria-busy="@(Pg.Running ? "true" : null)" @onclick="RunAsync">
                            <Icon Name="play" Size="18" /><span>@(Pg.Running ? "Running…" : "Run")</span>
                        </button>
                        <button type="button" class="btn form" disabled="@(!Pg.Running)" @onclick="Pg.Cancel"><Icon Name="stop" Size="18" /><span>Cancel</span></button>
                        @if (!Pg.Running && Pg.Problem is { } pr)
                        {
                            <span class="action-status">@pr</span>
                        }
                    </div>
                </section>

                <section class="present-response" aria-label="Response">
                    @if (Pg.Selected is { } prun)
                    {
                        <div class="response md @(prun.Text.Length == 0 ? "empty" : "")" tabindex="0" aria-label="Response text" aria-busy="@(prun.InFlight ? "true" : "false")">
                            @ResponseBody(prun)
                        </div>
                        <RunSummary Run="prun" Large="true" />
                    }
                    else
                    {
                        <div class="response md empty">Run a request to see the response here.</div>
                    }
                </section>

                <section class="present-trace" aria-label="Trace">
                    @if (Pg.Selected is { } trun)
                    {
                        <TraceBar Trace="trun.CurrentTrace" FeedState="trun.TraceState" Message="@trun.TraceMessage" />
                    }
                    else
                    {
                        <TraceBar Trace="TraceView.Empty" />
                    }
                </section>
            </div>
            <span class="visually-hidden" role="status" aria-live="polite">@RunText.Announcement(Pg.Selected)</span>
        </div>
    </RequiresConnection>
}
else
{
    <div class="page pg-page">
        <RequiresConnection>
            <div class="page-head">
                <div class="titles">
                    <h1>Playground</h1>
                    <span class="lede">Run a request as a test application and watch what governance actually does.</span>
                </div>
                <button type="button" class="btn" id="pg-present-toggle" @onclick="EnterPresent">
                    <Icon Name="present" Size="16" /><span>Presentation mode</span>
                </button>
            </div>

            <div class="pg-panes">
                <section class="panel pg-left" aria-label="Request">
                    <RequestComposer IdPrefix="pg" />
                </section>

                <section class="panel pg-right" aria-labelledby="pg-resp-h">
                    <div class="panel-head">
                        <h2 id="pg-resp-h">Response</h2>
                        @if (Pg.Selected is { } hr)
                        {
                            <span class="secondary subtle">@hr.Snapshot.Title · @Fmt.UtcShort(hr.Snapshot.SubmittedUtc) UTC</span>
                            @if (!hr.InFlight && !hr.Snapshot.MatchesForm(Pg.Form))
                            {
                                <span class="changed-flag">Previous request — the composer has changed since</span>
                            }
                            <span class="grow"></span>
                            <span class="btn-row tight">
                                <button type="button" class="btn ghost sm" aria-pressed="@(_raw ? "true" : "false")" @onclick="() => _raw = !_raw">Raw</button>
                                <button type="button" class="btn ghost sm" disabled="@(hr.Text.Length == 0)" @onclick="() => CopyResponseAsync(hr)">
                                    <Icon Name="copy" Size="16" /><span>Copy</span>
                                </button>
                                @if (_copyNote is not null)
                                {
                                    <span class="subtle secondary" role="status">@_copyNote</span>
                                }
                            </span>
                        }
                    </div>

                    @if (Pg.Selected is not { } run)
                    {
                        <div class="response md empty">No request yet. Choose a preset or write a prompt, pick who to run as, then Run.</div>
                        <TraceBar Trace="TraceView.Empty" />
                    }
                    else
                    {
                        <div class="response md @(run.Text.Length == 0 ? "empty" : "")" tabindex="0" aria-label="Response text" aria-busy="@(run.InFlight ? "true" : "false")">
                            @ResponseBody(run)
                        </div>
                        <span class="note">Response text is console-only: kept in this tab's memory, never persisted.</span>
                        <RunSummary Run="run" OnDetails="OpenDetails" DetailsButtonId="pg-details-open" />
                        <TraceBar Trace="run.CurrentTrace" FeedState="run.TraceState" Message="@run.TraceMessage" />
                    }
                </section>
            </div>

            @if (Pg.Runs.Count > 0)
            {
                <section class="panel history-panel" aria-labelledby="pg-hist-h">
                    <div class="panel-head">
                        <h2 id="pg-hist-h"><Icon Name="history" Size="16" /> This session</h2>
                        <span class="panel-sub">Selecting an entry shows its stored result — it never runs again.</span>
                        <button type="button" class="btn ghost sm" disabled="@Pg.Running" @onclick="Pg.ClearOutput">Clear</button>
                    </div>
                    <ol class="history-list">
                        @foreach (var h in Enumerable.Reverse(Pg.Runs))
                        {
                            var item = h;
                            var selected = ReferenceEquals(item, Pg.Selected);
                            <li>
                                <button type="button" class="history-item @(selected ? "selected" : "")" aria-current="@(selected ? "true" : null)" @onclick="() => Pg.Select(item)">
                                    <span class="mono">#@item.Snapshot.Sequence</span>
                                    <span class="history-label">@item.Snapshot.ScenarioLabel</span>
                                    @if (item.InFlight)
                                    {
                                        <StatusPill Kind="unknown" Text="Running" />
                                    }
                                    else if (item.Outcome is { } ho)
                                    {
                                        <StatusPill Kind="@ho.PillKind" Text="@ho.Title" />
                                    }
                                    <span class="subtle mono">@Fmt.UtcShort(item.Snapshot.SubmittedUtc)</span>
                                </button>
                            </li>
                        }
                    </ol>
                </section>
            }

            <span class="visually-hidden" role="status" aria-live="polite">@RunText.Announcement(Pg.Selected)</span>

            <Drawer @bind-Open="_detailsOpen" Title="@(Pg.Selected is { } dr ? dr.Snapshot.Title : "Request details")" OpenerId="pg-details-open">
                @if (Pg.Selected is { } drun)
                {
                    <RunDetails Run="drun" OnNavigate="CloseDetails" />
                }
            </Drawer>
        </RequiresConnection>
    </div>
}

@code {
    [Parameter] public string? Scenario { get; set; }
    [SupplyParameterFromQuery(Name = "present")] public string? Present { get; set; }

    private bool _present;
    private bool _wasPresent;
    private bool _focusPending;
    private string? _appliedScenario;
    private bool _detailsOpen;
    private bool _raw;
    private string? _copyNote;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Pg.Changed += OnChanged;
        Ws.Changed += OnChanged;
        await Ws.EnsureLoadedAsync();
        Pg.EnsureDefaultApplication();
        ApplyScenarioFromRoute();
    }

    protected override void OnParametersSet()
    {
        _present = string.Equals(Present, "1", StringComparison.Ordinal);
        if (_present != _wasPresent)
        {
            _wasPresent = _present;
            _focusPending = true;
        }
        ApplyScenarioFromRoute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await Interop.FocusElementAsync(_present ? "pg-present-root" : "pg-present-toggle"); }
        catch (JSException) { /* focus is best effort */ }
    }

    /// <summary>A scenario in the URL only fills the composer, like clicking the preset — never runs it.</summary>
    private void ApplyScenarioFromRoute()
    {
        if (string.Equals(Scenario, _appliedScenario, StringComparison.OrdinalIgnoreCase)) return;
        // Apply once applications are known (so the preset can pick a granted profile); a Host without the
        // applications endpoint still gets the prompt filled.
        if (Ws.Applications is null && (Ws.Loading || State.Restoring || (State.Connected && Ws.LoadedUtc is null))) return;
        _appliedScenario = Scenario;
        if (!Pg.Running && ScenarioPresets.Find(Scenario) is { } preset) Pg.ApplyPreset(preset);
    }

    private Task RunAsync() => Pg.RunAsync();

    private void EnterPresent()
    {
        _detailsOpen = false;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("present", "1"));
    }

    private void ExitPresent() => Nav.NavigateTo(Nav.GetUriWithQueryParameter("present", (string?)null));

    private void OnPresentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ExitPresent();
    }

    private void OpenDetails() => _detailsOpen = true;
    private void CloseDetails() => _detailsOpen = false;

    private async Task CopyResponseAsync(PlaygroundRun run)
    {
        bool ok;
        try { ok = await Interop.CopyTextAsync(run.Text); }
        catch (JSException) { ok = false; }
        _copyNote = ok ? "Copied" : "Copy failed — select the text and copy it manually";
    }

    /// <summary>Model output, rendered ONLY through SafeMarkdown (input HTML-encoded first; no raw HTML, http(s)
    /// links only) — or, with Raw, as plain escaped text. This is the console's only MarkupString.</summary>
    private RenderFragment<PlaygroundRun> ResponseBody => run => @<div class="md-body">
        @if (run.Text.Length == 0)
        {
            <span>@(run.InFlight ? "Waiting for the first token…" : "No response text.")</span>
        }
        else if (_raw)
        {
            <pre class="raw-text">@run.Text</pre>
        }
        else
        {
            @((MarkupString)SafeMarkdown.ToHtml(run.Text))
        }
    </div>;

    private void OnChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_appliedScenario != Scenario) ApplyScenarioFromRoute();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Pg.Changed -= OnChanged;
        Ws.Changed -= OnChanged;
    }
}
