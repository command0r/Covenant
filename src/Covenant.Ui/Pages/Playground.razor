@page "/playground/{Scenario?}"
@inject AppState State
@inject PlaygroundState Pg
@inject ConsoleSession Session
@inject Interop Interop
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Playground · Covenant</PageTitle>

@*
  TASK 04. Every Run sends a real POST /v1/chat/completions with the APPLICATION key (never the admin token);
  the governed pipeline decides the outcome. Presets only fill the form. Each run freezes a RequestSnapshot, and
  its result/evidence stay tied to that snapshot. Evidence is looked up by the server's correlation id
  (X-Covenant-Request-Id == audit Id) — never by timestamp. Response text is console-only and memory-only.
*@

@if (_present)
{
    <RequiresConnection>
        <div class="present-root" role="region" aria-label="Playground presentation mode">
            <header class="present-head">
                <span class="brand">Covenant</span>
                <span class="env" title="Environment">@State.EnvironmentLabel</span>
                @if (State.LastStatus?.Mode is { Length: > 0 } mode)
                {
                    <span class="subtle">Provider mode: <span class="mono">@mode</span></span>
                }
                <span class="indicator" aria-live="polite">
                    <span class="dot @(State.Paused ? "warn" : "hollow")" aria-hidden="true"></span>
                    @(State.Paused ? "New provider calls paused" : "New provider calls accepted")
                </span>
                <span class="grow"></span>
                <span class="pause-scope">Pauses NEW provider calls. Cache hits and in-flight calls are not stopped.</span>
                @if (_pauseError is not null)
                {
                    <span role="alert" class="note bad">@_pauseError</span>
                }
                @if (State.Paused)
                {
                    <Button Variant="primary" Busy="@_pauseBusy" BusyText="Resuming…" OnClick="ResumeAsync">Resume new provider calls</Button>
                }
                else
                {
                    <Button Busy="@_pauseBusy" BusyText="Pausing…" OnClick="PauseAsync">Pause new provider calls</Button>
                }
                <Button Id="pg-setup-open" OnClick="OpenSetup">Setup</Button>
                <Button Variant="ghost" OnClick="TogglePresent">Exit presentation mode</Button>
            </header>

            <div class="present-scen" role="group" aria-label="Scenario presets (fill the form; only Run sends)">
                @foreach (var p in ScenarioPresets.All)
                {
                    var preset = p;
                    <button type="button" class="preset" aria-pressed="@(Pg.Form.Scenario == preset.Letter ? "true" : "false")"
                            disabled="@Pg.Running" @onclick="() => Pg.ApplyPreset(preset)">
                        @preset.Letter · @preset.Title
                    </button>
                }
            </div>

            <div class="present-main">
                <section aria-label="Request">
                    <label for="pp-prompt" class="secondary muted">Prompt</label>
                    <textarea id="pp-prompt" class="input textarea" @bind="Pg.Form.Prompt" @bind:event="oninput" disabled="@Pg.Running"></textarea>
                    <span class="secondary muted">@SetupLine()</span>
                    @if (Pg.Form.Problem is { } problem && Pg.Form.Prompt.Length > 0)
                    {
                        <span class="note warn">@problem</span>
                    }
                    <div class="btn-row">
                        <Button Variant="primary" Size="form" Disabled="@(!CanRun)" Busy="@Pg.Running" BusyText="Running…" OnClick="RunAsync">Run request</Button>
                        <Button Size="form" Disabled="@(!Pg.Running)" OnClick="Cancel">Cancel</Button>
                    </div>
                    <span class="note">Cancel stops waiting; it is not a rollback.</span>
                </section>

                <section aria-label="Result" aria-live="polite">
                    @if (Pg.Selected is not { } run)
                    {
                        <span class="outcome unknown">Ready</span>
                        <span class="reason">Pick a scenario and press Run request.</span>
                    }
                    else
                    {
                        <span class="secondary muted">
                            @run.Snapshot.Title · @Fmt.UtcShort(run.Snapshot.SubmittedUtc) UTC
                            @if (!run.Snapshot.MatchesForm(Pg.Form))
                            {
                                <span> · previous request</span>
                            }
                        </span>
                        @if (run.InFlight)
                        {
                            <span class="outcome unknown">Sending request #@run.Snapshot.Sequence…</span>
                        }
                        else if (run.Outcome is { } o)
                        {
                            <div class="result-head">
                                <span class="outcome @o.PillKind">@o.Title</span>
                                <span class="mono secondary muted">@o.StatusLine</span>
                            </div>
                            <span class="reason">@o.Explanation</span>
                        }
                        <div class="response-box @(run.Text.Length == 0 ? "empty" : "")" tabindex="0" aria-label="Response text">@(run.Text.Length == 0 ? (run.InFlight ? "Waiting for the first token…" : "No response text.") : run.Text)</div>
                        <dl class="present-facts">
                            <div><dt>Model</dt><dd class="mono">@PresentModel(run)</dd></div>
                            <div><dt>Estimated provider cost</dt><dd>@CostFor(run)</dd></div>
                            <div><dt>Duration</dt><dd>@DurationFor(run)</dd></div>
                        </dl>
                        <div class="btn-row">
                            <Button Id="pg-inspect" OnClick="OpenInspect" Disabled="@run.InFlight">Inspect evidence</Button>
                            @if (RequestIdOf(run) is { } rid)
                            {
                                <Button Variant="ghost" OnClick="@(() => OpenInRequests(rid))">Open in Requests</Button>
                            }
                            <span class="secondary muted">@EvidenceShort(run)</span>
                        </div>
                    }
                </section>
            </div>
        </div>

        <Drawer @bind-Open="_setupOpen" Title="Request setup" OpenerId="pg-setup-open">
            @SetupFields
        </Drawer>
        <Drawer @bind-Open="_inspectOpen" Title="@(Pg.Selected is { } sr ? "Evidence · " + sr.Snapshot.Title : "Evidence")" OpenerId="pg-inspect">
            @if (Pg.Selected is { } ir)
            {
                @FactsBlock(ir)
                @EvidenceBlock(ir)
                @FlowBlock(ir)
            }
        </Drawer>
    </RequiresConnection>
}
else
{
    <div class="page pg-page">
        <RequiresConnection>
            <div class="page-head">
                <div class="titles">
                    <h1>Playground</h1>
                    <span class="lede">Send a request through the governed pipeline and inspect exactly what happened to it.</span>
                </div>
                <span class="pause-scope" style="max-width:360px">The header’s Pause control pauses NEW provider calls. Cache hits and in-flight calls are not stopped.</span>
                <Button OnClick="TogglePresent">Presentation mode</Button>
            </div>

            <div class="pg-cols">
                <section class="panel" aria-labelledby="setup-h">
                    <h2 id="setup-h">New request</h2>
                    <div class="field">
                        <span class="secondary" style="font-weight:500">Scenario preset <span class="subtle">— fills the form; only Run sends</span></span>
                        <div class="presets">
                            @foreach (var p in ScenarioPresets.All)
                            {
                                var preset = p;
                                <button type="button" class="preset" aria-pressed="@(Pg.Form.Scenario == preset.Letter ? "true" : "false")"
                                        disabled="@Pg.Running" @onclick="() => Pg.ApplyPreset(preset)">
                                    <span>@preset.Letter · @preset.Title</span>
                                    <span class="hint">@preset.Hint</span>
                                </button>
                            }
                        </div>
                        @if (ScenarioPresets.Find(Pg.Form.Scenario) is { } cur)
                        {
                            <span class="note">@cur.Note</span>
                        }
                        @if (Pg.Form.Scenario == 'C' && RouteHealth.LocalRoute(State.Catalog, DateTimeOffset.UtcNow).State is LocalRouteState.NotConfigured or LocalRouteState.NotRegistered)
                        {
                            <span class="note warn">No usable local route is registered, so policy will refuse C (fail-closed). <a href="connections">Set up the connection</a></span>
                        }
                    </div>

                    <div class="field">
                        <label for="pg-prompt">Prompt</label>
                        <textarea id="pg-prompt" class="input textarea" rows="4" @bind="Pg.Form.Prompt" @bind:event="oninput" disabled="@Pg.Running"></textarea>
                        @if (Pg.Form.FreshNonce)
                        {
                            <span class="help">A fresh nonce (<span class="mono">[run …]</span>) is appended on every run, so this request is never served from cache.</span>
                        }
                    </div>

                    @SetupFields

                    <div class="btn-row">
                        <Button Variant="primary" Size="form" Disabled="@(!CanRun)" Busy="@Pg.Running" BusyText="Running…" OnClick="RunAsync">Run request</Button>
                        <Button Size="form" Disabled="@(!Pg.Running)" OnClick="Cancel">Cancel</Button>
                        <Button Size="form" Variant="ghost" Disabled="@(Pg.Running || Pg.Runs.Count == 0)" OnClick="Pg.ClearOutput">Clear output</Button>
                    </div>
                    @if (Pg.Form.Problem is { } problem && Pg.Form.Prompt.Length > 0)
                    {
                        <span class="note warn">@problem</span>
                    }
                    <span class="note">Cancel stops waiting; it is not a rollback. Work or provider cost already incurred remains.</span>
                </section>

                <section class="panel" aria-labelledby="result-h" aria-live="polite">
                    <h2 id="result-h">Result</h2>
                    @if (Pg.Selected is not { } run)
                    {
                        <EmptyState Title="No request yet" Body="Choose a scenario or write a prompt, then Run request. Each result stays tied to the request that produced it." />
                    }
                    else
                    {
                        <div class="result-head">
                            <span class="title">@run.Snapshot.Title</span>
                            <span class="secondary subtle">submitted @Fmt.UtcShort(run.Snapshot.SubmittedUtc) UTC · @run.Snapshot.RoutingLabel · @(run.Snapshot.Streaming ? "streamed" : "buffered")</span>
                            @if (!run.InFlight && !run.Snapshot.MatchesForm(Pg.Form))
                            {
                                <span class="changed-flag">Previous request — the form has changed since</span>
                            }
                        </div>

                        @if (run.InFlight)
                        {
                            <span class="outcome unknown">Sending request #@run.Snapshot.Sequence…</span>
                            <span class="secondary muted">Waiting for Covenant. Cancel stops waiting; it does not roll anything back.</span>
                        }
                        else if (run.Outcome is { } o)
                        {
                            <div class="result-head">
                                <span class="outcome @o.PillKind">@o.Title</span>
                                <StatusPill Kind="@o.PillKind" Text="@o.StatusLine" />
                            </div>
                            <span class="secondary">@o.Explanation</span>
                            @if (run.Result?.ErrorReason is { Length: > 0 } why)
                            {
                                <span class="secondary muted">Server reason: <span class="mono">@why</span></span>
                            }
                            @if (run.Result?.TransportError is { Length: > 0 } te)
                            {
                                <span class="note bad">@te</span>
                            }
                            @if (run.Evidence.Record is { StoppedAtStage: "provider", AttemptedModel: null })
                            {
                                <a href="connections" class="secondary">Review the connection for this route</a>
                            }
                        }

                        <div class="field">
                            <span class="secondary" style="font-weight:500">Response <span class="subtle">— console-only; not persisted; cleared on disconnect or reload</span></span>
                            <div class="response-box @(run.Text.Length == 0 ? "empty" : "")" tabindex="0" aria-label="Response text">@(run.Text.Length == 0 ? (run.InFlight ? "Waiting for the first token…" : "No response text.") : run.Text)</div>
                        </div>

                        @FactsBlock(run)

                        <div class="btn-row">
                            @if (RequestIdOf(run) is { } rid)
                            {
                                <Button OnClick="@(() => OpenInRequests(rid))">Open in Requests</Button>
                            }
                            <span class="secondary muted">@EvidenceShort(run)</span>
                        </div>

                        @if (Pg.Runs.Count > 1)
                        {
                            <div class="history" role="group" aria-label="Requests in this session">
                                <span class="secondary subtle">This session</span>
                                @foreach (var h in Pg.Runs)
                                {
                                    var hr = h;
                                    <button type="button" class="btn sm @(ReferenceEquals(hr, Pg.Selected) ? "primary" : "ghost")"
                                            aria-pressed="@(ReferenceEquals(hr, Pg.Selected) ? "true" : "false")" @onclick="() => Pg.Select(hr)">
                                        #@hr.Snapshot.Sequence @(hr.Snapshot.Scenario is { } sc ? sc.ToString() : "custom")
                                    </button>
                                }
                            </div>
                        }
                    }
                </section>
            </div>

            <div class="pg-bottom">
                <section class="panel" aria-labelledby="flow-h">
                    @if (Pg.Selected is { } fr)
                    {
                        @FlowBlock(fr)
                    }
                    else
                    {
                        @FlowBlock(null)
                    }
                </section>
                <section class="panel" id="evidence" aria-labelledby="ev-h">
                    <h2 id="ev-h">
                        <button type="button" class="ev-toggle" aria-expanded="@(_evOpen ? "true" : "false")" @onclick="() => _evOpen = !_evOpen">
                            <span>Evidence @(Pg.Selected is { } er ? "for request #" + er.Snapshot.Sequence : "")</span>
                            <span class="secondary subtle">@(_evOpen ? "Hide" : "Show")</span>
                        </button>
                    </h2>
                    @if (_evOpen)
                    {
                        if (Pg.Selected is { } evr)
                        {
                            @EvidenceBlock(evr)
                        }
                        else
                        {
                            <span class="secondary muted">Run a request to see its audit evidence here.</span>
                        }
                    }
                </section>
            </div>
        </RequiresConnection>
    </div>
}

@code {
    [Parameter] public string? Scenario { get; set; }
    [SupplyParameterFromQuery(Name = "present")] public string? Present { get; set; }

    private bool _present;
    private string? _appliedScenario;
    private bool _setupOpen;
    private bool _inspectOpen;
    private bool _evOpen = true;
    private bool _pauseBusy;
    private string? _pauseError;
    private string? _copyNote;

    private bool CanRun => !Pg.Running && Pg.Form.Problem is null;

    private IReadOnlyList<CatalogModel> PermittedModels
        => State.Catalog is { } c ? c.Models.Where(m => m.Classifications.Count > 0).ToList() : [];

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Pg.Changed += OnChanged;
    }

    protected override void OnParametersSet()
    {
        _present = string.Equals(Present, "1", StringComparison.Ordinal);
        if (!string.Equals(Scenario, _appliedScenario, StringComparison.OrdinalIgnoreCase))
        {
            _appliedScenario = Scenario;
            // A scenario in the URL only fills the form, like clicking the preset. Never while a run is in flight.
            if (!Pg.Running && ScenarioPresets.Find(Scenario) is { } preset) Pg.ApplyPreset(preset);
        }
    }

    private Task RunAsync() => Pg.RunAsync();

    private void Cancel() => Pg.Cancel();

    private void TogglePresent()
    {
        _setupOpen = false;
        _inspectOpen = false;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("present", _present ? null : "1"));
    }

    private void OpenSetup() => _setupOpen = true;
    private void OpenInspect() => _inspectOpen = true;

    private void OpenInRequests(string id)
    {
        _inspectOpen = false;
        Nav.NavigateTo("requests/" + Uri.EscapeDataString(id));
    }

    private void SetMode(RouteMode mode)
    {
        Pg.Form.Mode = mode;
        if (mode == RouteMode.Catalog && string.IsNullOrWhiteSpace(Pg.Form.CatalogModel) && PermittedModels.Count > 0)
            Pg.Form.CatalogModel = PermittedModels[0].ModelId;
    }

    private void OnKeyInput(ChangeEventArgs e) => State.SetApplicationKey(e.Value?.ToString());

    private void ForgetKey() => State.SetApplicationKey(null);

    private async Task CopyIdAsync(string id)
    {
        bool ok;
        try { ok = await Interop.CopyTextAsync(id); }
        catch (JSException) { ok = false; }
        _copyNote = ok ? "Copied" : "Copy failed — select the id and copy it manually";
    }

    private async Task PauseAsync()
    {
        _pauseBusy = true; _pauseError = null;
        var err = await Session.SetPausedAsync(true, "paused from console (presentation)");
        _pauseBusy = false;
        _pauseError = err is null ? null : "Pause failed — " + err;
    }

    private async Task ResumeAsync()
    {
        _pauseBusy = true; _pauseError = null;
        var err = await Session.SetPausedAsync(false, null);
        _pauseBusy = false;
        _pauseError = err is null ? null : "Resume failed — " + err;
    }

    // ---- Text helpers (all derived from the run's own snapshot / result / audit record) ----

    private static string? RequestIdOf(PlaygroundRun run) => run.Result?.RequestId is { Length: > 0 } id ? id : null;

    private string SetupLine()
    {
        var key = string.IsNullOrEmpty(State.ApplicationKey) ? "no application key (the server will answer 401)" : "application key set (memory only)";
        var route = Pg.Form.RequestedModel ?? RequestSnapshot.PolicyChooses;
        return $"{key} · {route} · {(Pg.Form.Streaming ? "streamed" : "buffered")}";
    }

    private static string AwaitingText(PlaygroundRun run) => run.InFlight ? "Awaiting response" : run.Evidence.State switch
    {
        EvidenceState.Pending => "Awaiting audit record…",
        EvidenceState.Unavailable => "Not available — no audit record found yet",
        EvidenceState.Error => "Not available — evidence lookup failed",
        _ => RequestIdOf(run) is null ? "Not available — no request id received" : "Not available — no audit record",
    };

    private static string DurationFor(PlaygroundRun run)
    {
        if (run.Evidence.Record is { } rec) return Fmt.Ms(rec.DurationMs) + " (recorded by Covenant)";
        if (run.InFlight) return Fmt.Ms(run.Clock.Elapsed.TotalMilliseconds) + " so far (client-measured)";
        return run.Result is { } r ? Fmt.Ms(r.ClientMs) + " (client-measured)" : "Not reported";
    }

    private static string CostFor(PlaygroundRun run)
        => run.Evidence.Record is { } rec ? CostText.Cost(rec) : AwaitingText(run);

    private static string TokensFor(PlaygroundRun run)
        => run.Evidence.Record is { } rec ? CostText.Tokens(rec) : AwaitingText(run);

    private static string PresentModel(PlaygroundRun run)
    {
        if (run.Evidence.Record is not { } rec) return AwaitingText(run);
        var f = ModelFacts.From(rec);
        return rec.CacheHit || !string.IsNullOrWhiteSpace(rec.ServedByModel) ? f.Served : "Selected: " + f.Selected + " · attempted: " + f.Attempted;
    }

    private static string EvidenceShort(PlaygroundRun run)
    {
        if (run.InFlight) return "";
        return run.Evidence.State switch
        {
            EvidenceState.Pending => $"Awaiting audit record… (lookup {run.Evidence.Attempts + 1})",
            EvidenceState.Found => "Audit record found",
            EvidenceState.Unavailable => run.Evidence.Message ?? EvidenceTracker.UnavailableMessage,
            EvidenceState.Error => run.Evidence.Message ?? "Evidence lookup failed",
            _ => run.Outcome?.Outcome == DisplayOutcome.RejectedBeforeGovernance
                ? "Rejected before governance (400); no evidence record"
                : RequestIdOf(run) is null ? "No request id was received, so there is no exact record to open" : "",
        };
    }

    // ---- Shared fragments (normal layout and presentation drawers) ----

    private RenderFragment SetupFields => @<div style="display:flex;flex-direction:column;gap:14px">
        <div class="field">
            <label for="pg-key">Application key</label>
            <div class="copy-row" style="width:100%">
                <input id="pg-key" class="input mono" style="flex:1 1 220px" type="password" autocomplete="off" spellcheck="false"
                       value="@State.ApplicationKey" @oninput="OnKeyInput" placeholder="Paste an application key" />
                @if (!string.IsNullOrEmpty(State.ApplicationKey))
                {
                    <Button Size="sm" Variant="ghost" OnClick="ForgetKey">Forget key</Button>
                }
            </div>
            @if (string.IsNullOrEmpty(State.ApplicationKey))
            {
                <span class="help bad" role="status">No application key set — Run will be refused with HTTP 401 (useful only for the authentication-failure demo). Paste an application key, e.g. the <span class="mono">App key</span> printed by scripts/run-local-demo.sh. The admin token does not work here.</span>
            }
            <span class="help">Held in this tab's memory only; never stored — a page reload clears it. Identity and team are resolved by Covenant from this key — never from the admin token.</span>
        </div>

        <div class="field">
            <span id="pg-route-l" class="secondary" style="font-weight:500">Model routing</span>
            <div class="seg" role="radiogroup" aria-labelledby="pg-route-l">
                <button type="button" role="radio" aria-checked="@(Pg.Form.Mode == RouteMode.Policy ? "true" : "false")" disabled="@Pg.Running" @onclick="() => SetMode(RouteMode.Policy)">Let policy choose</button>
                <button type="button" role="radio" aria-checked="@(Pg.Form.Mode == RouteMode.Catalog ? "true" : "false")" disabled="@(Pg.Running || PermittedModels.Count == 0)" @onclick="() => SetMode(RouteMode.Catalog)">Permitted catalog model</button>
                <button type="button" role="radio" aria-checked="@(Pg.Form.Mode == RouteMode.Explicit ? "true" : "false")" disabled="@Pg.Running" @onclick="() => SetMode(RouteMode.Explicit)">Advanced: explicit model id</button>
            </div>
            @if (Pg.Form.Mode == RouteMode.Policy)
            {
                <span class="help">Classification picks the route (see Policies). No model is requested.</span>
            }
            else if (Pg.Form.Mode == RouteMode.Catalog)
            {
                <label for="pg-cat" class="visually-hidden">Requested model</label>
                <select id="pg-cat" class="input mono" @bind="Pg.Form.CatalogModel" disabled="@Pg.Running">
                    @foreach (var m in PermittedModels)
                    {
                        <option value="@m.ModelId">@(m.ModelId + " (" + string.Join(", ", m.Classifications) + ")" + (m.Registered ? "" : " — not registered"))</option>
                    }
                </select>
                <span class="help">From GET /admin/catalog. Policy still checks the request’s classification: a listed model is not a permission grant.</span>
            }
            else
            {
                <label for="pg-explicit" class="secondary">Advanced: explicit model id (test input — does not grant permission)</label>
                <input id="pg-explicit" class="input mono" type="text" spellcheck="false" @bind="Pg.Form.ExplicitModel" @bind:event="oninput" disabled="@Pg.Running" />
            }
            @if (State.Catalog is null)
            {
                <span class="help bad">@(State.CatalogError is { } ce ? "Catalog unavailable: " + ce : "Catalog not loaded yet.")</span>
            }
        </div>

        <div class="field-row">
            <div class="field">
                <label for="pg-max">Max output tokens</label>
                <input id="pg-max" class="input mono" type="number" min="1" @bind="Pg.Form.MaxTokens" disabled="@Pg.Running" />
            </div>
            <div class="field">
                <label for="pg-wf">Workflow label</label>
                <input id="pg-wf" class="input" type="text" @bind="Pg.Form.Workflow" @bind:event="oninput" disabled="@Pg.Running" />
            </div>
            <div class="field">
                <label for="pg-uc">Use-case label</label>
                <input id="pg-uc" class="input" type="text" @bind="Pg.Form.UseCase" @bind:event="oninput" disabled="@Pg.Running" />
            </div>
        </div>
        <span class="help">Labels are attribution text only (X-Covenant-Workflow / X-Covenant-UseCase); they do not change identity, team or permission.</span>
        <label class="switch">
            <input type="checkbox" @bind="Pg.Form.Streaming" disabled="@Pg.Running" /> Stream the response (SSE)
        </label>
    </div>;

    private RenderFragment<PlaygroundRun> FactsBlock => run => @<dl class="facts">
        @if (run.Evidence.Record is { } rec)
        {
            var f = ModelFacts.From(rec);
            <dt>Selected model</dt><dd class="mono">@f.Selected</dd>
            <dt>Provider attempted</dt><dd class="mono">@f.Attempted</dd>
            <dt>Served model</dt><dd class="mono">@f.Served</dd>
            <dt>Classification</dt><dd>@f.Classification</dd>
            <dt>Identity</dt><dd class="mono">@rec.Principal · team @Fmt.OrNotRecorded(rec.Tags.Team)</dd>
        }
        else
        {
            <dt>Selected / attempted / served</dt><dd>@AwaitingText(run)</dd>
        }
        <dt>Duration</dt><dd>@DurationFor(run)</dd>
        <dt>Tokens</dt><dd>@TokensFor(run)</dd>
        <dt>Estimated cost</dt><dd>@CostFor(run)</dd>
        <dt>Request id</dt>
        <dd>
            @if (RequestIdOf(run) is { } id)
            {
                <span class="copy-row">
                    <span class="mono wrap-any">@id</span>
                    <Button Size="sm" Variant="ghost" OnClick="@(() => CopyIdAsync(id))" AriaLabel="Copy request id">Copy</Button>
                    @if (_copyNote is not null)
                    {
                        <span class="subtle" role="status">@_copyNote</span>
                    }
                </span>
            }
            else
            {
                <span>@(run.InFlight ? "Awaiting response" : "None — no response with a request id was received")</span>
            }
        </dd>
    </dl>;

    private RenderFragment<PlaygroundRun> EvidenceBlock => run => @<div style="display:flex;flex-direction:column;gap:10px">
        @switch (run.Evidence.State)
        {
            case EvidenceState.Found when run.Evidence.Record is { } rec:
                var o = OutcomeModel.FromRecord(rec);
                <dl class="facts">
                    <dt>Audit record</dt><dd class="mono wrap-any">@rec.Id</dd>
                    <dt>Recorded</dt><dd>@Fmt.Utc(rec.TimestampUtc)</dd>
                    <dt>Recorded outcome</dt><dd><StatusPill Kind="@o.PillKind" Text="@o.Title" /></dd>
                    <dt>Effect / denial kind</dt><dd class="mono">@rec.Effect · @Fmt.OrNotRecorded(rec.DenialKind)</dd>
                    <dt>Stopped at</dt><dd>@(rec.StoppedAtStage is { } st ? PipelineStages.Label(st) : string.Equals(rec.Effect, "Allow", StringComparison.OrdinalIgnoreCase) ? "Completed" : "Not recorded")</dd>
                    <dt>Reason</dt><dd>@rec.Reason</dd>
                    <dt>Cost basis</dt><dd>@CostText.BasisDescription(rec.CostBasis)</dd>
                    <dt>Prompt fingerprint</dt><dd class="mono wrap-any">sha256 @Fmt.OrNotRecorded(rec.PromptSha256) · @rec.PromptChars chars</dd>
                </dl>
                <div class="btn-row">
                    <Button Variant="primary" OnClick="@(() => OpenInRequests(rec.Id))">Open in Requests</Button>
                </div>
                break;
            case EvidenceState.Pending:
                <span class="secondary muted" role="status">Awaiting audit record… The audit sink writes asynchronously; looking up <span class="mono">@RequestIdOf(run)</span> (attempt @(run.Evidence.Attempts + 1)).</span>
                break;
            case EvidenceState.Unavailable:
                <ErrorBanner Title="No audit record found yet" Message="@(run.Evidence.Message ?? EvidenceTracker.UnavailableMessage)" OnRetry="@(() => Pg.RetryEvidenceAsync(run))" />
                <span class="note">This does not mean the audit write failed — the record may still be on its way.</span>
                break;
            case EvidenceState.Error:
                <ErrorBanner Title="Evidence lookup failed" Message="@run.Evidence.Message" OnRetry="@(() => Pg.RetryEvidenceAsync(run))" />
                break;
            default:
                if (run.InFlight)
                {
                    <span class="secondary muted">The request is still in flight.</span>
                }
                else if (run.Outcome?.Outcome == DisplayOutcome.RejectedBeforeGovernance)
                {
                    <span class="secondary muted">Rejected before governance (400); no evidence record — the request never reached the pipeline.</span>
                }
                else if (RequestIdOf(run) is null)
                {
                    <span class="secondary muted">No request id was received (stopped waiting before the response headers, or Covenant was unreachable), so there is no exact record to look up. Search Requests by time instead — never assume the newest record is this one.</span>
                }
                break;
        }
    </div>;

    private RenderFragment<PlaygroundRun?> FlowBlock => run => @<div style="display:flex;flex-direction:column;gap:8px">
        <div class="panel-head">
            <h2 id="flow-h">Configured processing order</h2>
        </div>
        <span class="note">The order assembled at startup — not a measured trace. Only the stage recorded as stopping this request is highlighted; no timings are shown.</span>
        <ol class="stage-list">
            @{ var rec = run?.Evidence.Record; var stopKey = PipelineStages.RowKey(rec?.StoppedAtStage); var n = 0; }
            @foreach (var st in PipelineStages.Configured)
            {
                n++;
                var stopped = stopKey == st.Key;
                var cacheHit = rec is { CacheHit: true } && st.Key == "cache";
                <li class="@(stopped ? "stopped" : cacheHit ? "cache-hit" : "")" aria-current="@(stopped || cacheHit ? "step" : null)">
                    <span class="n">@n</span>
                    <span class="name">@st.Name</span>
                    <span class="detail">@st.Detail</span>
                    @if (stopped)
                    {
                        <span class="mark">· stopped here (recorded)</span>
                    }
                    else if (cacheHit)
                    {
                        <span class="mark">· served from cache here; later stages skipped</span>
                    }
                </li>
            }
        </ol>
        <span class="note">
            Audit wraps every request, including refusals.
            @if (rec is { } r && string.Equals(r.Effect, "Allow", StringComparison.OrdinalIgnoreCase) && !r.CacheHit)
            {
                <span>This request completed: no stage stopped it.</span>
            }
            else if (rec is { StoppedAtStage: null, DenialKind: null } lr && string.Equals(lr.Effect, "Deny", StringComparison.OrdinalIgnoreCase))
            {
                <span>Stopping stage not recorded (legacy record).</span>
            }
            else if (run is { InFlight: false } && rec is null)
            {
                <span>The stopping stage is shown once the audit record arrives.</span>
            }
        </span>
    </div>;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Pg.Changed -= OnChanged;
    }
}
