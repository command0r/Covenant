@page "/policies"
@inject AppState State
@inject ConfigEditor Editor
@inject WorkspaceConfig Ws
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Policies · Covenant</PageTitle>

@*
  November redesign (docs/CONSOLE-USABILITY-NOVEMBER.md §4). Three views of the versioned configuration:
  - Routes: match (classification + workload) → primary → optional fallback → state, with per-route Edit / Pause / Remove.
  - Applications: the calling systems (owner team, grants, console testing), Edit / Add.
  - Workloads: the profiles (trusted baseline, web search permission, used by), Edit / Add / Remove.
  Every change happens in a focused dialog titled with the entity and is saved on its own (ConfigEditor.ApplyScopedAsync:
  fresh draft from the active version → only that change → preview → PUT with If-Match). Validation errors and conflicts
  are shown in the dialog; Cancel discards. The EditorBar keeps version history, rollback and the unsaved-change guard.
  PII/PHI are never offered cloud targets; the Host's validation stays authoritative.
*@

<div class="page">
    <RequiresConnection>
        <div class="page-head">
            <div class="titles">
                <h1>Policies</h1>
                <span class="lede">Which approved model serves each workload, who may call it, and when a request is refused.</span>
            </div>
            @if (Editor.Current is { } hc)
            {
                var badge = ShellStatus.Mode(hc.Mode);
                <span class="mode-badge @badge.Tone" title="@badge.Description">@badge.Label</span>
                <button type="button" class="btn sm" id="mode-open" disabled="@(!CanEdit)" @onclick="OpenMode">Change mode…</button>
            }
            <a class="btn" href="playground">Try in Playground</a>
        </div>

        <EditorBar Owner="policies" Subject="Policies" ShowEditButton="false" ClaimedPaths="@ClaimedPaths"
                   ViewHint="Each route, application and workload is edited in its own dialog; saving creates a new configuration version." />

        @if (_notice is { } notice)
        {
            <span class="note" role="status">@notice</span>
        }

        @if (Editor.Applied?.Config is not { } cfg)
        {
            if (Editor.Loading || (Editor.Applied is null && Editor.LoadError is null))
            {
                <section class="panel"><Skeleton Lines="5" Label="Loading policies" /></section>
            }
            else if (Editor.EndpointMissing)
            {
                <EmptyState Title="Policies cannot be shown or edited on this Host" Body="This Host does not expose versioned configuration (GET /admin/config)." />
            }
            else
            {
                <ErrorBanner Title="Configuration unavailable" Message="@Editor.LoadError" />
            }
        }
        else
        {
            <div class="view-tabs" role="tablist" aria-label="Policies views">
                @foreach (var (key, label) in Views)
                {
                    var k = key;
                    <button type="button" role="tab" id="@("tab-" + k)" aria-selected="@(_view == k ? "true" : "false")" aria-controls="@("view-" + k)"
                            tabindex="@(_view == k ? "0" : "-1")" @onclick="() => _view = k">@label</button>
                }
            </div>

            @if (_view == "routes")
            {
                <section class="panel flush" id="view-routes" role="tabpanel" aria-labelledby="tab-routes">
                    <div class="panel-head">
                        <h2>Routes</h2>
                        <span class="panel-sub">@ModeSentence(cfg.Mode)</span>
                        <span class="grow"></span>
                        <button type="button" class="btn sm" id="route-add" disabled="@(!CanEdit)" @onclick="() => OpenRoute(null, cfg)"><Icon Name="plus" Size="16" /><span>Add route…</span></button>
                    </div>
                    @if (cfg.Policies.Count == 0)
                    {
                        <div class="pad"><EmptyState Title="No routes" Body="Every request is refused (fail-closed) until a route covers its classification." /></div>
                    }
                    <ul class="entity-list">
                        @foreach (var p in OrderedPolicies(cfg))
                        {
                            var pol = p;
                            var targets = PolicyRoutes.Targets(pol, cfg);
                            <li class="entity-row">
                                <div class="entity-main">
                                    <strong class="wrap-any">@(pol.Name ?? pol.Id)</strong>
                                    <span class="secondary subtle">@PolicyText.Applicability(pol)</span>
                                </div>
                                @* Own classes (not the old route view's grid-area classes): identity · path · state · actions. *@
                                <div class="entity-path">
                                <span class="entity-arrow" aria-hidden="true">→</span>
                                <span class="entity-targets">
                                    @if (targets.Count == 0)
                                    {
                                        <span class="route-chip refused">No targets — refused</span>
                                    }
                                    @foreach (var (t, i) in targets.Select((x, n) => (x, n)))
                                    {
                                        <span class="route-chip @(t.Eligible ? (t.Boundary == "Cloud" ? "cloud" : "local") : "excluded")" title="@(t.ExcludedReason ?? PolicyRoutes.RoleLabel(i))">
                                            <span class="route-role">@(i == 0 ? "Primary" : "Fallback")</span>
                                            <span class="mono wrap-any">@t.Key</span>
                                            @if (t.Eligible) { <BoundaryTag Boundary="@t.Boundary" /> } else { <span class="route-why">@t.ExcludedReason</span> }
                                        </span>
                                    }
                                    @if (PolicyText.IsSanitized(pol)) { <span class="jchip external" title="@PolicyText.SanitizedOnly"><Icon Name="shield" Size="14" /><span>Sanitized payload only</span></span> }
                                </span>
                                </div>
                                <span class="entity-state"><StatusPill Kind="@PolicyText.StateKind(pol)" Text="@PolicyText.StateText(pol)" /></span>
                                <span class="entity-actions">
                                    <button type="button" class="btn sm" id="@("route-edit-" + pol.Id)" disabled="@(!CanEdit)" @onclick="() => OpenRoute(pol, cfg)">Edit</button>
                                    <button type="button" class="btn sm" id="@("route-pause-" + pol.Id)" disabled="@(!CanEdit)" @onclick="() => OpenPause(pol)">
                                        <Icon Name="@(pol.Paused ? "play" : "pause")" Size="16" /><span>@(pol.Paused ? "Resume" : "Pause")</span>
                                    </button>
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="pad secondary subtle">@PolicyText.SensitiveNeverCloud</div>
                </section>
            }
            else if (_view == "applications")
            {
                <section class="panel flush" id="view-applications" role="tabpanel" aria-labelledby="tab-applications">
                    <div class="panel-head">
                        <h2>Applications</h2>
                        <span class="panel-sub">The calling systems. Each belongs to a team that pays for its requests.</span>
                        <span class="grow"></span>
                        <button type="button" class="btn sm" id="app-add" disabled="@(!CanEdit)" @onclick="() => OpenApp(null, cfg)"><Icon Name="plus" Size="16" /><span>Add application…</span></button>
                    </div>
                    <ul class="entity-list">
                        @foreach (var a in cfg.Applications)
                        {
                            var app = a;
                            <li class="entity-row simple">
                                <div class="entity-main">
                                    <strong class="wrap-any">@ProfileEditing.ApplicationName(app.Id, app.DisplayName) <span class="chip owner" title="Owning team — pays for this application's requests"><Icon Name="budgets" Size="14" />team @app.Team</span></strong>
                                    <span class="secondary subtle"><span class="mono">@app.Id</span> · workloads: @(app.GrantedProfiles.Count == 0 ? "none" : string.Join(", ", app.GrantedProfiles.Select(g => ProfileEditing.Label(cfg, g))))</span>
                                </div>
                                <span class="entity-state">
                                    <StatusPill Kind="@(app.Enabled ? "served" : "unknown")" Text="@(app.Enabled ? "Enabled" : "Disabled")" />
                                    @if (app.ConsoleTesting) { <StatusPill Kind="served" Text="Console testing" /> }
                                </span>
                                <span class="entity-actions">
                                    <button type="button" class="btn sm" id="@("app-edit-" + app.Id)" disabled="@(!CanEdit)" @onclick="() => OpenApp(app, cfg)">Edit</button>
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="pad secondary subtle">@ProfileEditing.ApplicationKeysExplained</div>
                </section>
            }
            else
            {
                <section class="panel flush" id="view-workloads" role="tabpanel" aria-labelledby="tab-workloads">
                    <div class="panel-head">
                        <h2>Workloads</h2>
                        <span class="panel-sub">Workload profiles: the declared kind of work and its trusted classification. Routes match on them.</span>
                        <span class="grow"></span>
                        <button type="button" class="btn sm" id="wl-add" disabled="@(!CanEdit)" @onclick="() => OpenWorkload(null)"><Icon Name="plus" Size="16" /><span>Add workload…</span></button>
                    </div>
                    <ul class="entity-list">
                        @foreach (var w in cfg.Profiles)
                        {
                            var wl = w;
                            var usage = ProfileEditing.Usage(cfg, wl.Id);
                            <li class="entity-row simple">
                                <div class="entity-main">
                                    <strong class="wrap-any"><Icon Name="@ComposerRules.WorkloadIcon(wl)" Size="16" /> @(wl.Name ?? wl.Id)</strong>
                                    <span class="secondary subtle"><span class="mono">@wl.Id</span> · baseline @PolicyText.ClassificationLabel(wl.Baseline)@(wl.WebSearchAllowed ? " · web search allowed" : "")@(ProfileEditing.RejectsSensitive(wl) ? " · rejects detected sensitive data" : "") · used by @(usage.GrantedTo.Count == 0 ? "no application" : string.Join(", ", usage.GrantedTo))</span>
                                </div>
                                <span class="entity-state">
                                    @{ var dest = WorkloadDestination.For(cfg, wl); }
                                    @if (dest.Ok) { <BoundaryTag Boundary="@dest.Boundary" /> <span class="mono secondary">@dest.Target</span> }
                                    else { <span class="note warn">No route</span> }
                                </span>
                                <span class="entity-actions">
                                    <button type="button" class="btn sm" id="@("wl-edit-" + wl.Id)" disabled="@(!CanEdit)" @onclick="() => OpenWorkload(wl)">Edit</button>
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="pad secondary subtle">@ProfileEditing.BaselineExplained</div>
                </section>
            }

            <PolicySimulator Applications="@Ws.Applications" Profiles="@cfg.Profiles" Draft="@null" AppliedVersion="@Editor.AppliedVersion" />

            @* ---------------- dialogs ---------------- *@

            @if (_route is { } re)
            {
                var rp = re.Working;
                var options = PolicyEditing.TargetOptionsFor(rp, cfg);
                <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="@(re.IsNew ? "New route" : "Route: " + (rp.Name ?? rp.Id))"
                            OpenerId="@_opener" IsDirty="() => re.IsDirty" Busy="@_saving" SaveDisabled="@(RouteProblem(re, options) is not null)"
                            Error="@(_error ?? RouteProblem(re, options))" ErrorTitle="@(_error is null ? "Before saving" : _errorTitle)" ErrorTone="@(_error is null ? "warn" : _errorTone)" Issues="@_issues"
                            OnSave="@(() => SaveRouteAsync(re))" OnCancel="DiscardScoped">
                    <div class="dialog-section">
                        <div class="form-grid">
                            @if (re.IsNew)
                            {
                                <div class="field"><label for="rd-id">Route id</label><input id="rd-id" class="input mono" @bind="rp.Id" @bind:event="oninput" spellcheck="false" /></div>
                            }
                            <div class="field"><label for="rd-name">Name</label><input id="rd-name" class="input" @bind="rp.Name" @bind:event="oninput" /></div>
                        </div>
                    </div>
                    <div class="dialog-section">
                        <h3>Matches</h3>
                        <fieldset class="inline-fieldset">
                            <legend class="field-label">Classification</legend>
                            @foreach (var c in PolicyEditing.AllClassifications)
                            {
                                var cls = c;
                                <label class="switch"><input type="checkbox" checked="@rp.Classifications.Contains(cls)" @onchange="@(e => Toggle(rp.Classifications, cls, e))" /> @PolicyText.ClassificationLabel(cls)</label>
                            }
                        </fieldset>
                        <fieldset class="inline-fieldset">
                            <legend class="field-label">Workloads (none = every workload)</legend>
                            @foreach (var pr in cfg.Profiles)
                            {
                                var prof = pr;
                                <label class="switch"><input type="checkbox" checked="@rp.Profiles.Contains(prof.Id)" @onchange="@(e => Toggle(rp.Profiles, prof.Id, e))" /> @(prof.Name ?? prof.Id)</label>
                            }
                        </fieldset>
                    </div>
                    <div class="dialog-section">
                        <h3>Destination</h3>
                        <div class="form-grid">
                            <div class="field">
                                <label for="rd-primary">Primary model</label>
                                <select id="rd-primary" class="input mono" value="@(EntityEdits.PrimaryKey(rp) ?? "")" @onchange="@(e => SetTargets(rp, e.Value?.ToString(), EntityEdits.FallbackKey(rp)))">
                                    <option value="">Choose an eligible model…</option>
                                    @foreach (var o in options)
                                    {
                                        <option value="@o.Value" disabled="@(o.DisabledReason is not null)">@(o.Label + (o.DisabledReason is { } dr ? " — " + dr : ""))</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label for="rd-fallback">Fallback (optional)</label>
                                <select id="rd-fallback" class="input mono" value="@(EntityEdits.FallbackKey(rp) ?? "")" @onchange="@(e => SetTargets(rp, EntityEdits.PrimaryKey(rp), e.Value?.ToString()))">
                                    <option value="">No fallback</option>
                                    @foreach (var o in options.Where(o => o.Value != EntityEdits.PrimaryKey(rp)))
                                    {
                                        <option value="@o.Value" disabled="@(o.DisabledReason is not null)">@(o.Label + (o.DisabledReason is { } dr2 ? " — " + dr2 : ""))</option>
                                    }
                                </select>
                                <span class="help">Used only on a transient failure of the primary, before any content was streamed.</span>
                            </div>
                        </div>
                        @if (rp.Targets.Count > 2)
                        {
                            <span class="secondary">Further fallbacks kept: <span class="mono">@string.Join(", ", rp.Targets.Skip(2).Select(PolicyRoutes.Key))</span></span>
                        }
                        @if (rp.Classifications.Any(PolicyText.IsSensitive) && !PolicyText.IsSanitized(rp))
                        {
                            <span class="note">@PolicyText.SensitiveNeverCloud External models are not offered.</span>
                        }
                        else if (PolicyText.IsSanitized(rp))
                        {
                            <span class="note">@PolicyText.SanitizedOnly</span>
                        }
                        <label class="switch"><input type="checkbox" checked="@rp.Paused" @onchange="@(e => rp.Paused = e.Value is bool b && b)" /> Paused — matching requests are refused</label>
                    </div>
                    @if (rp.Classifications.Count == 1 && rp.Classifications[0] == "Pii")
                    {
                        <div class="dialog-section">
                            <h3>Sanitized external route <InfoTip Label="What is a sanitized route?">@SanitizedRoute.Limits</InfoTip></h3>
                            <label class="switch">
                                <input type="checkbox" checked="@(rp.Redaction is not null)" @onchange="@(e => PolicyEditing.SetSanitized(rp, e.Value is bool on && on))" />
                                Allow a sanitized structured record (covenant.record.v1) to use the models above
                            </label>
                            @if (rp.Redaction is { } red)
                            {
                                <fieldset class="inline-fieldset">
                                    <legend class="field-label">Identifier fields replaced by placeholders</legend>
                                    @foreach (var (value, label) in SanitizedRoute.IdentifierTypes)
                                    {
                                        var v = value;
                                        <label class="switch"><input type="checkbox" checked="@red.Types.Contains(v)" @onchange="@(e => Toggle(red.Types, v, e))" /> @label</label>
                                    }
                                </fieldset>
                                <fieldset class="inline-fieldset">
                                    <legend class="field-label">Allowed tasks (Covenant sends its fixed instruction, never the caller's text)</legend>
                                    @foreach (var (value, label) in SanitizedRoute.Tasks)
                                    {
                                        var v = value;
                                        <label class="switch"><input type="checkbox" checked="@red.Tasks.Contains(v)" @onchange="@(e => Toggle(red.Tasks, v, e))" /> @label <span class="subtle mono">@v</span></label>
                                    }
                                </fieldset>
                                <span class="help">Only the dedicated workloads chosen above (baseline PII) use it; every other PII request keeps its local route. Prose, unknown fields and PHI are refused. Not anonymisation.</span>
                                @if (PolicyEditing.SanitizedProblem(rp, cfg) is { } sp) { <span class="note warn">@sp</span> }
                            }
                        </div>
                    }
                    <details class="tech dialog-section">
                        <summary>Advanced: strategy, retries, deadline</summary>
                        <div class="form-grid">
                            <div class="field">
                                <label for="rd-st">Strategy</label>
                                <select id="rd-st" class="input" value="@(PolicyText.IsLengthHeuristic(rp) ? "length-heuristic" : "fixed")" @onchange="@(e => SetStrategy(rp, e))">
                                    <option value="fixed">Fixed (primary, then fallback)</option>
                                    <option value="length-heuristic">Length-based heuristic</option>
                                </select>
                            </div>
                            @if (PolicyText.IsLengthHeuristic(rp))
                            {
                                <div class="field"><label for="rd-th">Threshold (estimated tokens)</label><input id="rd-th" class="input mono" type="number" min="0" @bind="rp.ThresholdTokens" @bind:event="oninput" /></div>
                            }
                            <div class="field"><label for="rd-ma">Max attempts (1–3)</label><input id="rd-ma" class="input mono" type="number" min="1" max="3" @bind="RetryOf(rp).MaxAttempts" @bind:event="oninput" /></div>
                            <div class="field"><label for="rd-dl">Total deadline (ms)</label><input id="rd-dl" class="input mono" type="number" min="1000" max="600000" @bind="RetryOf(rp).DeadlineMs" @bind:event="oninput" /></div>
                        </div>
                        <fieldset class="inline-fieldset">
                            <legend class="field-label">Fall back on</legend>
                            @foreach (var kind in RetryKinds)
                            {
                                var k = kind;
                                <label class="switch"><input type="checkbox" checked="@(RetryOf(rp).On?.Contains(k.Key) ?? false)" @onchange="@(e => SetRetryOn(rp, k.Key, e))" /> @k.Label</label>
                            }
                        </fieldset>
                    </details>
                    @if (!re.IsNew)
                    {
                        <div class="dialog-section">
                            <button type="button" class="btn ghost sm" disabled="@_saving" @onclick="() => OpenRemoveRoute(rp.Id)">Remove this route…</button>
                        </div>
                    }
                </EditDialog>
            }

            @if (_confirm is { } cf)
            {
                <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="@cf.Title" OpenerId="@_opener" Busy="@_saving" Danger="@cf.Danger"
                            SaveLabel="@cf.Action" Error="@_error" ErrorTitle="@_errorTitle" ErrorTone="@_errorTone" Issues="@_issues"
                            OnSave="@(() => SaveConfirmAsync(cf))" OnCancel="DiscardScoped">
                    <ul class="plain-list secondary">
                        @foreach (var line in cf.Lines) { <li>@line</li> }
                    </ul>
                </EditDialog>
            }

            @if (_app is { } ae)
            {
                var ap = ae.Working;
                var appProblems = AppProblems(ae, cfg);
                <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="@(ae.IsNew ? "New application" : "Application: " + ProfileEditing.ApplicationName(ap.Id, ap.DisplayName))"
                            OpenerId="@_opener" IsDirty="() => ae.IsDirty" Busy="@_saving" SaveDisabled="@(appProblems.Count > 0)"
                            Error="@(_error ?? (appProblems.Count > 0 ? string.Join(" ", appProblems) : null))" ErrorTitle="@(_error is null ? "Before saving" : _errorTitle)" ErrorTone="@(_error is null ? "warn" : _errorTone)" Issues="@_issues"
                            OnSave="@(() => SaveAppAsync(ae))" OnCancel="DiscardScoped">
                    <div class="dialog-section">
                        <div class="form-grid">
                            <div class="field"><label for="ad-name">Name</label><input id="ad-name" class="input" maxlength="100" @bind="ap.DisplayName" @bind:event="oninput" placeholder="@ap.Id" /></div>
                            @if (ae.IsNew)
                            {
                                <div class="field"><label for="ad-id">Application id</label><input id="ad-id" class="input mono" @bind="ap.Id" @bind:event="oninput" spellcheck="false" /></div>
                            }
                            <div class="field"><label for="ad-team">Owning team (pays)</label><input id="ad-team" class="input mono" @bind="ap.Team" @bind:event="oninput" spellcheck="false" /></div>
                            <div class="field"><label for="ad-max">Max output tokens (cap)</label><input id="ad-max" class="input mono" type="number" min="1" @bind="ap.MaxOutputTokens" @bind:event="oninput" /></div>
                        </div>
                        <div class="field"><label for="ad-desc">What it does</label><input id="ad-desc" class="input" maxlength="300" @bind="ap.Description" @bind:event="oninput" /></div>
                    </div>
                    <div class="dialog-section">
                        <h3>Allowed workloads</h3>
                        <fieldset class="inline-fieldset">
                            <legend class="visually-hidden">Granted workloads</legend>
                            @foreach (var pr in cfg.Profiles)
                            {
                                var pid = pr.Id;
                                <label class="switch"><input type="checkbox" checked="@ap.GrantedProfiles.Contains(pid)" @onchange="@(e => ToggleGrant(ap, pid, e))" /> @(pr.Name ?? pr.Id) <span class="subtle">(@PolicyText.ClassificationLabel(pr.Baseline))</span></label>
                            }
                        </fieldset>
                        <div class="field">
                            <label for="ad-def">Default workload</label>
                            <select id="ad-def" class="input" value="@(ap.DefaultProfile ?? "")" @onchange="@(e => ap.DefaultProfile = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                <option value="">None — built-in @ProfileEditing.LegacyInternal (Internal)</option>
                                @foreach (var g in ap.GrantedProfiles) { <option value="@g">@ProfileEditing.Label(cfg, g)</option> }
                            </select>
                        </div>
                    </div>
                    <div class="dialog-section">
                        <label class="switch"><input type="checkbox" checked="@ap.Enabled" @onchange="@(e => ap.Enabled = e.Value is bool b && b)" /> Enabled</label>
                        <label class="switch"><input type="checkbox" checked="@ap.ConsoleTesting" @onchange="@(e => ap.ConsoleTesting = e.Value is bool b && b)" /> Console testing allowed (the Playground may run as this application)</label>
                        <span class="secondary subtle">@ProfileEditing.ApplicationKeysExplained</span>
                    </div>
                </EditDialog>
            }

            @if (_workload is { } we)
            {
                var wp = we.Working;
                var wlProblems = WorkloadProblems(we, cfg);
                <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="@(we.IsNew ? "New workload" : "Workload: " + (wp.Name ?? wp.Id))"
                            OpenerId="@_opener" IsDirty="() => we.IsDirty" Busy="@_saving" SaveDisabled="@(wlProblems.Count > 0)"
                            Error="@(_error ?? (wlProblems.Count > 0 ? string.Join(" ", wlProblems) : null))" ErrorTitle="@(_error is null ? "Before saving" : _errorTitle)" ErrorTone="@(_error is null ? "warn" : _errorTone)" Issues="@_issues"
                            OnSave="@(() => SaveWorkloadAsync(we))" OnCancel="DiscardScoped">
                    <div class="dialog-section">
                        <div class="form-grid">
                            <div class="field"><label for="wd-name">Name</label><input id="wd-name" class="input" @bind="wp.Name" @bind:event="oninput" /></div>
                            @if (we.IsNew)
                            {
                                <div class="field"><label for="wd-id">Workload id</label><input id="wd-id" class="input mono" @bind="wp.Id" @bind:event="oninput" spellcheck="false" /></div>
                            }
                            <div class="field">
                                <label for="wd-base">Trusted baseline</label>
                                <select id="wd-base" class="input" value="@wp.Baseline" @onchange="@(e => SetBaseline(wp, e.Value?.ToString()))">
                                    @foreach (var b in ProfileEditing.Baselines) { <option value="@b">@PolicyText.ClassificationLabel(b)</option> }
                                </select>
                                <span class="help">Detection can only raise it.</span>
                            </div>
                        </div>
                        <div class="field"><label for="wd-desc">Description</label><input id="wd-desc" class="input" @bind="wp.Description" @bind:event="oninput" /></div>
                        <label class="switch">
                            <input type="checkbox" checked="@wp.WebSearchAllowed" disabled="@(!string.Equals(wp.Baseline, "Public", StringComparison.Ordinal) && !wp.WebSearchAllowed)" @onchange="@(e => wp.WebSearchAllowed = e.Value is bool b && b)" />
                            Allow web search (Public workloads only)
                        </label>
                        @* ADR-0019: server-side, versioned; the gateway enforces it for every caller (console and API). *@
                        <div class="field">
                            <label for="wd-sens">When sensitive data is detected</label>
                            @{ var sensDisabled = PolicyText.IsSensitive(wp.Baseline); }
                            <select id="wd-sens" class="input" value="@(ProfileEditing.RejectsSensitive(wp) ? ProfileEditing.ActionReject : ProfileEditing.ActionRoute)"
                                    disabled="@sensDisabled" aria-describedby="wd-sens-h"
                                    @onchange="@(e => ProfileEditing.SetSensitiveAction(wp, e.Value?.ToString()))">
                                <option value="@ProfileEditing.ActionRoute">Route by policy (PII/PHI stay local)</option>
                                <option value="@ProfileEditing.ActionReject">Reject the request</option>
                            </select>
                            <span id="wd-sens-h" class="help">@(sensDisabled ? "A PII/PHI workload is sensitive by declaration; its requests are always routed by the sensitive-data policy." : ProfileEditing.SensitiveActionExplained)</span>
                        </div>
                    </div>
                    @if (!we.IsNew)
                    {
                        <div class="dialog-section">
                            @{ var blockers = ProfileEditing.RemovalBlockers(cfg, wp.Id); }
                            @if (blockers.Count > 0)
                            {
                                <span class="secondary">Cannot be removed yet: @string.Join(" ", blockers)</span>
                            }
                            else
                            {
                                <button type="button" class="btn ghost sm" disabled="@_saving" @onclick="() => OpenRemoveWorkload(wp.Id, cfg)">Remove this workload…</button>
                            }
                        </div>
                    }
                </EditDialog>
            }

            @if (_mode is { } md)
            {
                <EditDialog Open="true" OpenChanged="@(_ => CloseDialogs())" Title="Provider mode" OpenerId="mode-open" IsDirty="@(() => !string.Equals(md.Value, cfg.Mode, StringComparison.Ordinal))"
                            Busy="@_saving" SaveDisabled="@string.Equals(md.Value, cfg.Mode, StringComparison.Ordinal)" Error="@_error" ErrorTitle="@_errorTitle" ErrorTone="@_errorTone" Issues="@_issues"
                            OnSave="SaveModeAsync" OnCancel="DiscardScoped">
                    <div class="seg" role="radiogroup" aria-label="Provider mode">
                        <button type="button" role="radio" aria-checked="@(PolicyRoutes.IsLocalOnly(md.Value) ? "true" : "false")" @onclick="@(() => md.Value = "local-only")">Local-only</button>
                        <button type="button" role="radio" aria-checked="@(string.Equals(md.Value, "hybrid", StringComparison.Ordinal) ? "true" : "false")" @onclick="@(() => md.Value = "hybrid")">Hybrid</button>
                    </div>
                    <span class="secondary">@ModeSentence(md.Value)</span>
                </EditDialog>
            }
        }
    </RequiresConnection>
</div>

@code {
    private sealed record RetryKind(string Key, string Label);
    private sealed class ModeChoice { public string? Value { get; set; } }
    private sealed record Confirm(string Title, IReadOnlyList<string> Lines, string Action, bool Danger, Func<CovenantConfigDto, string?> Change, string Summary);

    private static readonly RetryKind[] RetryKinds =
    [
        new("connect", "Connection failure"),
        new("timeout", "Provider timeout"),
        new("429", "429 rate limited"),
        new("5xx", "500/502/503/504"),
    ];

    private static readonly (string Key, string Label)[] Views = [("routes", "Routes"), ("applications", "Applications"), ("workloads", "Workloads")];

    private string _view = "routes";
    private EntityEdit<PolicyDto>? _route;
    private EntityEdit<ApplicationDto>? _app;
    private EntityEdit<WorkloadProfileDto>? _workload;
    private ModeChoice? _mode;
    private Confirm? _confirm;
    private string? _opener;
    private bool _saving;
    private string? _error;
    private string? _errorTitle;
    private string _errorTone = "bad";
    private IReadOnlyList<ConfigIssueDto>? _issues;
    private string? _notice;

    private bool CanEdit => Editor.Applied is not null && !Editor.Saving && !_saving && (!Editor.IsDirty || Editor.Owner == "policies");

    private IReadOnlyList<string> ClaimedPaths => Editor.Current is { } c
        ? Enumerable.Range(0, c.Policies.Count).Select(IssueIndex.Policy)
            .Concat(Enumerable.Range(0, c.Profiles.Count).Select(IssueIndex.Profile))
            .Concat(Enumerable.Range(0, c.Applications.Count).Select(IssueIndex.Application)).ToList()
        : [];

    protected override async Task OnInitializedAsync()
    {
        Editor.Changed += OnChanged;
        Ws.Changed += OnChanged;
        State.Changed += OnChanged;
        // Deep links from other pages: #applications / #applications-list → Applications, #workloads → Workloads.
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        _view = fragment.StartsWith("applications", StringComparison.OrdinalIgnoreCase) ? "applications"
              : fragment.StartsWith("workloads", StringComparison.OrdinalIgnoreCase) ? "workloads" : "routes";
        await Editor.EnsureLoadedAsync();
        await Ws.EnsureLoadedAsync();
    }

    private static IEnumerable<PolicyDto> OrderedPolicies(CovenantConfigDto cfg)
        => cfg.Policies.OrderBy(p => p.Classifications.Count == 0 ? 9 : p.Classifications.Min(PolicyText.ClassificationOrder)).ThenBy(p => p.Profiles.Count == 0 ? 1 : 0);

    private static string ModeSentence(string? mode)
    {
        if (PolicyRoutes.IsLocalOnly(mode)) return "Local-only: only in-perimeter models can run; cloud routes are never used.";
        if (string.Equals(mode, "hybrid", StringComparison.OrdinalIgnoreCase)) return "Hybrid: local and approved external routes; raw PII/PHI never leaves (a sanitized structured-record route is the only, opt-in exception for PII).";
        if (PolicyRoutes.IsLegacy(mode)) return "Legacy cloud: imported pre-v2 routing — review before relying on it.";
        return "Mode not reported.";
    }

    // ---------------- open dialogs ----------------

    /// <summary>Active version when the current dialog opened: its save is refused if the configuration moved since.</summary>
    private int? _openedAt;

    private void ResetResult()
    {
        _openedAt = Editor.AppliedVersion;
        _error = null;
        _errorTitle = null;
        _errorTone = "bad";
        _issues = null;
        _notice = null;
    }

    private void OpenRoute(PolicyDto? p, CovenantConfigDto cfg)
    {
        ResetResult();
        _opener = p is null ? "route-add" : "route-edit-" + p.Id;
        _route = p is null
            ? EntityEdits.New(new PolicyDto { Id = PolicyEditing.UniqueId("route", cfg), Name = "", Enabled = true, Classifications = ["Public"], Strategy = "fixed",
                                              Retry = new RetrySettingsDto { MaxAttempts = 1, DeadlineMs = 120_000, On = [] } })
            : EntityEdits.Edit(p);
        _route.BaseVersion = Editor.AppliedVersion;
    }

    private void OpenApp(ApplicationDto? a, CovenantConfigDto cfg)
    {
        ResetResult();
        _opener = a is null ? "app-add" : "app-edit-" + a.Id;
        _app = a is null
            ? EntityEdits.New(new ApplicationDto { Id = ConnectionRules.UniqueId("app", cfg.Applications.Select(x => x.Id)), Team = "", Enabled = true, ConsoleTesting = true, MaxOutputTokens = 1024 })
            : EntityEdits.Edit(a);
        _app.BaseVersion = Editor.AppliedVersion;
    }

    private void OpenWorkload(WorkloadProfileDto? w)
    {
        ResetResult();
        _opener = w is null ? "wl-add" : "wl-edit-" + w.Id;
        _workload = w is null
            ? EntityEdits.New(new WorkloadProfileDto { Id = Editor.Applied?.Config is { } c ? ProfileEditing.UniqueId("workload", c) : "workload", Name = "", Baseline = "Internal" })
            : EntityEdits.Edit(w);
        _workload.BaseVersion = Editor.AppliedVersion;
    }

    private void OpenMode()
    {
        ResetResult();
        _mode = new ModeChoice { Value = Editor.Applied?.Config?.Mode };
    }

    private void OpenPause(PolicyDto p)
    {
        ResetResult();
        _opener = "route-pause-" + p.Id;
        var id = p.Id;
        bool pause = !p.Paused;
        _confirm = new Confirm(
            (pause ? "Pause route: " : "Resume route: ") + (p.Name ?? p.Id),
            pause
                ? ["Requests that match this route are refused (audited) until it is resumed.", "Other routes are unchanged. Saving creates a new configuration version."]
                : ["Requests that match this route are served again by its primary (and fallback).", "Saving creates a new configuration version."],
            pause ? "Pause route" : "Resume route", pause,
            d => d.Policies.FirstOrDefault(x => x.Id == id) is { } x ? Set(() => x.Paused = pause) : "The route no longer exists in the active configuration.",
            "Console: route " + id + (pause ? " paused" : " resumed"));
    }

    private void OpenRemoveRoute(string id)
    {
        var cfg = Editor.Applied?.Config;
        var p = cfg?.Policies.FirstOrDefault(x => x.Id == id);
        if (cfg is null || p is null) return;
        _route = null;
        ResetResult();
        _confirm = new Confirm("Remove route: " + (p.Name ?? p.Id), PolicyEditing.RemovalImpact(p, cfg), "Remove route", true,
            d => EntityEdits.Remove(d.Policies, id, x => x.Id, "route"), "Console: route " + id + " removed");
    }

    private void OpenRemoveWorkload(string id, CovenantConfigDto cfg)
    {
        _workload = null;
        ResetResult();
        _confirm = new Confirm("Remove workload: " + id, ProfileEditing.RemovalImpact(cfg, id), "Remove workload", true,
            d => ProfileEditing.Remove(d, id), "Console: workload " + id + " removed");
    }

    private static string? Set(Action a) { a(); return null; }

    private void CloseDialogs()
    {
        _route = null;
        _app = null;
        _workload = null;
        _mode = null;
        _confirm = null;
    }

    private void DiscardScoped()
    {
        Editor.DiscardIfOwner("policies");
        ResetResult();
    }

    // ---------------- save ----------------

    private async Task<bool> ApplyAsync(Func<CovenantConfigDto, string?> change, string summary)
        => await ApplyAsync(_openedAt, change, summary);

    private async Task<bool> ApplyAsync(int? openedAt, Func<CovenantConfigDto, string?> change, string summary)
    {
        _saving = true;
        _error = null;
        _issues = null;
        StateHasChanged();
        try
        {
            var outcome = await Editor.ApplyScopedAsync("policies", openedAt, change, summary);
            if (outcome.Succeeded)
            {
                _notice = outcome.Message + ".";
                return true;
            }
            _errorTitle = outcome.Kind switch
            {
                EditOutcomeKind.Stale => "The configuration changed meanwhile",
                EditOutcomeKind.Invalid => "The Host rejected this change",
                _ => "Not saved",
            };
            _errorTone = outcome.Kind == EditOutcomeKind.Stale ? "warn" : "bad";
            _error = outcome.Kind == EditOutcomeKind.Stale
                ? outcome.Message + " Cancel and reopen to edit the current version."
                : outcome.Message;
            _issues = outcome.Errors;
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveRouteAsync(EntityEdit<PolicyDto> e)
    {
        if (await ApplyAsync(e.BaseVersion, d => EntityEdits.Apply(d, e), "Console: route " + e.Working.Id + (e.IsNew ? " added" : " edited"))) CloseDialogs();
    }

    private async Task SaveAppAsync(EntityEdit<ApplicationDto> e)
    {
        if (await ApplyAsync(e.BaseVersion, d => EntityEdits.Apply(d, e), "Console: application " + e.Working.Id + (e.IsNew ? " added" : " edited"))) CloseDialogs();
    }

    private async Task SaveWorkloadAsync(EntityEdit<WorkloadProfileDto> e)
    {
        if (await ApplyAsync(e.BaseVersion, d => EntityEdits.Apply(d, e), "Console: workload " + e.Working.Id + (e.IsNew ? " added" : " edited"))) CloseDialogs();
    }

    private async Task SaveConfirmAsync(Confirm c)
    {
        if (await ApplyAsync(c.Change, c.Summary)) CloseDialogs();
    }

    private async Task SaveModeAsync()
    {
        if (_mode?.Value is not { } mode) return;
        if (await ApplyAsync(d => Set(() => d.Mode = mode), "Console: mode " + mode)) CloseDialogs();
    }

    // ---------------- field helpers ----------------

    private static string? RouteProblem(EntityEdit<PolicyDto> e, IReadOnlyList<TargetOption> options)
    {
        var p = e.Working;
        if (e.IsNew && !ConnectionRules.IsValidId(p.Id)) return "Enter a route id (letters, digits, '.', '_' or '-').";
        if (p.Classifications.Count == 0) return "Choose at least one classification.";
        if (p.Targets.Count == 0) return "Choose the primary model.";
        var bad = p.Targets.Select(PolicyRoutes.Key).FirstOrDefault(k => options.FirstOrDefault(o => o.Value == k) is { DisabledReason: not null });
        if (bad is not null) return "Target " + bad + " is not allowed here: " + options.First(o => o.Value == bad).DisabledReason + ".";
        return null;
    }

    private static IReadOnlyList<string> AppProblems(EntityEdit<ApplicationDto> e, CovenantConfigDto cfg)
    {
        var p = new List<string>();
        var a = e.Working;
        if (e.IsNew && !ConnectionRules.IsValidId(a.Id)) p.Add("Enter an application id (letters, digits, '.', '_' or '-').");
        p.AddRange(ProfileEditing.ApplicationProblems(a, cfg));
        if ((a.DisplayName?.Length ?? 0) > ProfileEditing.MaxDisplayNameChars) p.Add("Name must be at most 100 characters.");
        return p;
    }

    private static IReadOnlyList<string> WorkloadProblems(EntityEdit<WorkloadProfileDto> e, CovenantConfigDto cfg)
    {
        var p = new List<string>();
        var w = e.Working;
        if (e.IsNew && !ConnectionRules.IsValidId(w.Id)) p.Add("Enter a workload id (letters, digits, '.', '_' or '-').");
        if (string.IsNullOrWhiteSpace(w.Name)) p.Add("Enter a name.");
        if (w.WebSearchAllowed && !string.Equals(w.Baseline, "Public", StringComparison.Ordinal)) p.Add("Only a Public workload may use web search.");
        if (ProfileEditing.RejectsSensitive(w) && PolicyText.IsSensitive(w.Baseline)) p.Add("Only a Public or Internal workload can reject detected sensitive data.");
        return p;
    }

    private static void Toggle(List<string> list, string value, ChangeEventArgs e)
    {
        list.Remove(value);
        if (e.Value is bool b && b) list.Add(value);
    }

    private static void ToggleGrant(ApplicationDto a, string profileId, ChangeEventArgs e)
    {
        a.GrantedProfiles.Remove(profileId);
        if (e.Value is bool b && b) a.GrantedProfiles.Add(profileId);
        else if (a.DefaultProfile == profileId) a.DefaultProfile = null;
    }

    private static void SetBaseline(WorkloadProfileDto w, string? baseline)
    {
        if (!ProfileEditing.IsBaseline(baseline)) return;
        w.Baseline = baseline;
        if (!string.Equals(baseline, "Public", StringComparison.Ordinal)) w.WebSearchAllowed = false;
        // ADR-0019: a PII/PHI workload cannot reject "detected" sensitive data — back to the default.
        if (PolicyText.IsSensitive(baseline) && ProfileEditing.RejectsSensitive(w)) w.SensitiveDataAction = ProfileEditing.ActionRoute;
    }

    /// <summary>Primary/fallback from the selectors; an empty primary is reported by RouteProblem (Save stays disabled).</summary>
    private static void SetTargets(PolicyDto p, string? primary, string? fallback)
    {
        if (string.IsNullOrWhiteSpace(fallback)) fallback = null;
        if (string.Equals(primary, fallback, StringComparison.Ordinal)) fallback = null;
        if (string.IsNullOrWhiteSpace(primary)) { p.Targets = p.Targets.Skip(1).ToList(); return; }
        _ = EntityEdits.SetPrimaryFallback(p, primary, fallback);
    }

    private static RetrySettingsDto RetryOf(PolicyDto p) => p.Retry ??= new RetrySettingsDto { MaxAttempts = 1, DeadlineMs = 120_000, On = [] };

    private static void SetStrategy(PolicyDto p, ChangeEventArgs e)
    {
        p.Strategy = e.Value?.ToString() == "length-heuristic" ? "length-heuristic" : "fixed";
        if (p.Strategy == "length-heuristic" && p.ThresholdTokens is null) p.ThresholdTokens = 400;
    }

    private static void SetRetryOn(PolicyDto p, string key, ChangeEventArgs e)
    {
        var retry = RetryOf(p);
        var on = retry.On ?? [];
        on.RemoveAll(x => x == key);
        if (e.Value is bool b && b) on.Add(key);
        retry.On = RetryKinds.Select(k => k.Key).Where(on.Contains).ToList();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Editor.Changed -= OnChanged;
        Ws.Changed -= OnChanged;
        State.Changed -= OnChanged;
    }
}
