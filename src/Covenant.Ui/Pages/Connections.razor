@page "/connections"
@inject AppState State
@inject AdminApi Api
@inject CatalogState Catalog
@inject ConsoleInferenceApi Inference
@inject WorkspaceConfig Ws
@inject EvidenceTracker Evidence
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Models &amp; connections · Covenant</PageTitle>

@*
  TASK 06 (UI half). Top: the APPLIED configuration as the server reports it (GET /admin/catalog) — "Registered"
  only ever comes from the server's flag. Bottom: the Ollama wizard. Draft values live only in this page; probing
  a draft never changes the running configuration, and runtime apply is not available (config + restart).
  The governed test runs through POST /admin/playground/requests as an authorized test application (ADR-0012) —
  the same governed pipeline as /v1; no application key is ever entered in the console.
*@

<div class="page">
    <RequiresConnection>
        <div class="page-head">
            <div class="titles">
                <h1>Models &amp; connections</h1>
                <span class="lede">Where Covenant sends calls. Registration, permission and observed reachability are separate facts.</span>
            </div>
            <span class="page-note">Managed by configuration; restart required</span>
            <Button Busy="@Catalog.Refreshing" BusyText="Refreshing…" OnClick="Catalog.RefreshAsync">Refresh</Button>
        </div>

        @{ var cat = State.Catalog; var localRoute = RouteHealth.LocalRoute(cat, DateTimeOffset.UtcNow); }

        @if (cat is null)
        {
            if (State.CatalogError is { } ce)
            {
                <ErrorBanner Title="Catalog unavailable" Message="@ce" OnRetry="Catalog.RefreshAsync" />
            }
            else
            {
                <Skeleton Lines="4" Label="Loading the provider catalog" />
            }
        }
        else
        {
            <section class="panel flush" aria-labelledby="cur-h">
                <div class="panel-head">
                    <h2 id="cur-h">Running configuration</h2>
                    <span class="panel-sub">
                        Mode <span class="mono">@Fmt.OrNotRecorded(cat.Mode)</span> · read @Fmt.Ago(State.CatalogUpdatedUtc, DateTimeOffset.UtcNow)
                    </span>
                </div>
                <div style="padding:14px 18px;display:flex;flex-direction:column;gap:10px">
                    <span class="indicator"><span class="dot @localRoute.Tone" aria-hidden="true"></span>@localRoute.Text</span>
                    <dl class="facts">
                        <dt>Local route configured</dt><dd>@(cat.Local?.Configured == true ? "Yes" : "No")</dd>
                        <dt>Local:Endpoint (running)</dt><dd class="mono">@Fmt.OrNotRecorded(cat.Local?.Endpoint)</dd>
                        <dt>Local:ModelId (running)</dt><dd class="mono">@Fmt.OrNotRecorded(cat.Local?.ModelId)</dd>
                        <dt>Local model registered</dt><dd>@(cat.Local is null ? "Not reported" : cat.Local.Registered ? "Yes (server-reported)" : "No (server-reported)")</dd>
                        <dt>Endpoint health</dt><dd>@HealthText(cat.Local?.EndpointHealth)</dd>
                        <dt>Probe allow-list</dt><dd class="mono">@(cat.ProbeAllowList is { Count: > 0 } al ? string.Join(", ", al) : "Not reported")</dd>
                    </dl>
                </div>
                @if (cat.Models.Count == 0)
                {
                    <div style="padding:0 18px 18px"><EmptyState Title="No routed models" Body="Policy has no routes, so every request is refused (fail-closed)." /></div>
                }
                else
                {
                    <div class="table-scroll">
                        <table style="min-width:1040px">
                            <thead>
                                <tr>
                                    <th scope="col">Adapter</th>
                                    <th scope="col">Model id</th>
                                    <th scope="col">Route classifications</th>
                                    <th scope="col">Registered</th>
                                    <th scope="col">Permitted</th>
                                    <th scope="col">Price basis</th>
                                    <th scope="col">Observed health</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in cat.Models)
                                {
                                    <tr>
                                        <td class="mono">@m.Adapter@(m.EndpointHost is { Length: > 0 } eh ? " · " + eh : "")</td>
                                        <td class="mono wrap-any">@m.ModelId</td>
                                        <td>@(m.Classifications.Count > 0 ? string.Join(", ", m.Classifications) : "None")</td>
                                        <td>@(m.Registered ? "Yes" : "No — matching requests are refused at the provider stage")</td>
                                        <td>@(m.Classifications.Count > 0 ? "Yes, for " + string.Join(", ", m.Classifications) : "No")</td>
                                        <td>@PriceText(m)</td>
                                        <td>@HealthText(m.Health)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div style="padding:12px 18px" class="note">Health is observed from real governed calls and probes of the applied endpoint; “unknown” means never observed. GET /v1/models is not a health check.</div>
            </section>
        }

        <section class="panel" aria-labelledby="wiz-h">
            <div class="panel-head">
                <h2 id="wiz-h">Connect an existing Ollama</h2>
                <span class="panel-sub">One exact model tag · nothing is applied from here</span>
            </div>
            <div class="wizard">
                <fieldset>
                    <legend>1 · Endpoint</legend>
                    <div class="field">
                        <label for="cx-url">Base URL, as seen from the Covenant host</label>
                        <input id="cx-url" class="input mono" type="text" spellcheck="false" placeholder="http://ollama-host:11434/v1"
                               value="@_endpoint" @oninput="OnEndpointInput" aria-invalid="@(EndpointProblem is not null && _endpoint.Length > 0 ? "true" : "false")" aria-describedby="cx-url-h" />
                        <span id="cx-url-h" class="help @(EndpointProblem is not null && _endpoint.Length > 0 ? "bad" : "")">@(EndpointProblem ?? "Looks valid. Test it next.")</span>
                        <span class="help">“localhost” means the machine or container running Covenant — not this browser.</span>
                    </div>
                    @if (_invalidated)
                    {
                        <span class="note warn" role="status">The endpoint changed, so the earlier probe, model choice and checks were cleared. The running configuration is unchanged.</span>
                    }
                </fieldset>

                <fieldset disabled="@(EndpointProblem is not null)">
                    <legend>2 · Test connection <span class="step-state @StepTone(ProbePassed, _probe is not null)">@StepText(ProbePassed, _probe is not null)</span></legend>
                    <span class="secondary muted">Covenant probes the endpoint from its own host (GET …/models, 5 s timeout, 64 KiB cap, no redirects, allow-listed destinations only). No Covenant credential is forwarded.</span>
                    <div class="btn-row">
                        <Button Variant="primary" Busy="@_probing" BusyText="Testing…" OnClick="ProbeAsync">Test connection</Button>
                    </div>
                    <ErrorBanner Title="Probe request failed" Message="@_probeError" />
                    @if (_probe is { } pr)
                    {
                        <dl class="facts">
                            <dt>Allowed destination</dt><dd>@(pr.Allowed ? "Yes" : "No")</dd>
                            <dt>Reachable</dt><dd>@(pr.Reachable ? "Yes" : "No")</dd>
                            <dt>HTTP status</dt><dd class="mono">@(pr.HttpStatus?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "None")</dd>
                            <dt>Duration</dt><dd class="mono">@(pr.DurationMs is { } ms ? Fmt.Ms(ms) : "Not reported")</dd>
                            <dt>Normalised endpoint</dt><dd class="mono wrap-any">@Fmt.OrNotRecorded(pr.Endpoint)</dd>
                            <dt>Error</dt><dd>@(pr.Error ?? "None")</dd>
                        </dl>
                        @if (!pr.Allowed)
                        {
                            <span class="note bad">This destination is not on the operator allow-list. Add <span class="mono">@(ConnectionLogic.Authority(_endpoint) ?? "host:port")</span> to <span class="mono">Providers:ProbeAllowList</span> (e.g. <span class="mono">Providers__ProbeAllowList=@(ConnectionLogic.Authority(_endpoint) ?? "host:port")</span>) and restart Covenant, then test again.</span>
                        }
                        else if (!pr.Reachable)
                        {
                            <span class="note bad">The probe failed, so the wizard stops here. Check the address from the Covenant host’s point of view, then edit the endpoint or test again.</span>
                        }
                        <span class="note">Observed @(pr.CheckedUtc is { } cu ? Fmt.Utc(cu) : Fmt.Utc(_probeAtUtc)). Reachability is a point-in-time observation.</span>
                    }
                </fieldset>

                <fieldset disabled="@(!ProbePassed)">
                    <legend>3 · Installed models <span class="step-state @StepTone(DiscoveryPassed, ProbePassed)">@StepText(DiscoveryPassed, ProbePassed)</span></legend>
                    <span class="secondary muted">What the endpoint reports as installed. Discovery never registers or permits a model.</span>
                    @if (ProbePassed && _probe is { } dp)
                    {
                        if (dp.Models.Count == 0)
                        {
                            <EmptyState Title="No models installed" Body="The endpoint answered but lists no models. Install the exact Qwen tag on that host (outside Covenant), then test again." />
                        }
                        else
                        {
                            <ul class="plain-list mono">
                                @foreach (var t in dp.Models)
                                {
                                    <li class="wrap-any">@t</li>
                                }
                            </ul>
                        }
                    }
                </fieldset>

                <fieldset disabled="@(!DiscoveryPassed)">
                    <legend>4 · Choose exactly one tag <span class="step-state @StepTone(TagPassed, DiscoveryPassed)">@StepText(TagPassed, DiscoveryPassed)</span></legend>
                    <span class="secondary muted">Covenant registers exactly one local model (Local:ModelId). The tag must match exactly — it is never guessed.</span>
                    @if (DiscoveryPassed && _probe is { } tp)
                    {
                        <div class="tag-list" role="radiogroup" aria-label="Installed model tags">
                            @foreach (var t in tp.Models)
                            {
                                var tag = t;
                                <label>
                                    <input type="radio" name="cx-tag" value="@tag" checked="@(string.Equals(_tag, tag, StringComparison.Ordinal))" @onchange="() => ChooseTag(tag)" />
                                    <span>@tag</span>
                                </label>
                            }
                        </div>
                    }
                </fieldset>

                <fieldset disabled="@(!TagPassed)">
                    <legend>5 · Review the route and configuration</legend>
                    @if (TagPassed && _tag is { } rt)
                    {
                        <span>@ConnectionLogic.RouteReview(cat?.Mode, rt)</span>
                        <div class="seg" role="radiogroup" aria-label="Configuration to generate">
                            <button type="button" role="radio" aria-checked="@(_localOnly ? "false" : "true")" @onclick="() => _localOnly = false">Keep cloud mode</button>
                            <button type="button" role="radio" aria-checked="@(_localOnly ? "true" : "false")" @onclick="() => _localOnly = true">Local-only mode</button>
                        </div>
                        @if (_localOnly)
                        {
                            <span class="note">@ConnectionLogic.RouteReview("local-only", rt)</span>
                        }
                        <pre class="code-block" aria-label="Generated configuration">@ConnectionLogic.ConfigBlock(_endpoint, rt, _localOnly)</pre>
                        <span class="note warn">Runtime apply is not available in this version: apply the configuration and restart Covenant. Then check what the running instance actually loaded.</span>
                    }
                </fieldset>

                <fieldset disabled="@(!TagPassed)">
                    <legend>6 · Check applied configuration <span class="step-state @StepTone(AppliedPassed, _appliedChecked)">@StepText(AppliedPassed, _appliedChecked)</span></legend>
                    <span class="secondary muted">Re-reads GET /admin/catalog. Passes only if the running instance loaded this endpoint and tag and reports the model as registered.</span>
                    <div class="btn-row">
                        <Button Busy="@_checking" BusyText="Checking…" OnClick="CheckAppliedAsync">Check applied configuration</Button>
                    </div>
                    @if (_appliedChecked)
                    {
                        <span class="note @(AppliedPassed ? "" : "bad")" role="status">@_appliedMessage</span>
                    }
                </fieldset>

                <fieldset disabled="@(!AppliedPassed)">
                    <legend>7 · Governed test <span class="step-state @TestTone">@TestStepText</span></legend>
                    <span class="secondary muted">Sends a short synthetic prompt through the full governed pipeline as the chosen test application, requesting model <span class="mono">@(_tag ?? "—")</span> — never directly to Ollama. The prompt carries the published sample SSN so it is classified sensitive and must stay local.</span>
                    <div class="field">
                        <label for="cx-app">Run as</label>
                        <select id="cx-app" class="input" value="@(_testApp ?? "")" @onchange="OnTestApp">
                            <option value="" disabled>@(Ws.Applications is null ? "Applications unavailable" : "Choose an application…")</option>
                            @foreach (var c in ComposerRules.Applications(Ws.Applications))
                            {
                                <option value="@c.App.Id" disabled="@(!c.Selectable)">@c.Label</option>
                            }
                        </select>
                        @if (Ws.ApplicationsError is { } wae)
                        {
                            <span class="help bad">@wae</span>
                        }
                    </div>
                    <div class="btn-row">
                        <Button Variant="primary" Busy="@_testing" BusyText="Running test…" Disabled="@(_testApp is null)" OnClick="RunTestAsync">Run governed test</Button>
                    </div>
                    @if (_testOutcome is { } to)
                    {
                        <div class="result-head">
                            <span class="outcome @to.PillKind" style="font-size:22px">@(to.Outcome == DisplayOutcome.Paused ? "Paused — not a reachability result" : to.Title)</span>
                            <StatusPill Kind="@to.PillKind" Text="@to.StatusLine" />
                        </div>
                        <span class="secondary">@to.Explanation</span>
                        <dl class="facts">
                            <dt>Request id</dt><dd class="mono wrap-any">@(_testResult?.RequestId ?? "None received")</dd>
                            @if (_testEvidence.Record is { } trec)
                            {
                                <dt>Selected / attempted / served</dt><dd class="mono">@ModelFacts.Selected(trec) · @ModelFacts.Attempted(trec) · @ModelFacts.Served(trec)</dd>
                                <dt>Classification</dt><dd>@ModelFacts.Classification(trec)</dd>
                            }
                            else
                            {
                                <dt>Evidence</dt><dd>@EvidenceText</dd>
                            }
                        </dl>
                        @if (_testResult?.RequestId is { Length: > 0 } tid)
                        {
                            <a class="btn" href="@("requests/" + Uri.EscapeDataString(tid))">Open evidence</a>
                        }
                    }
                </fieldset>
            </div>
        </section>

        <section class="panel" aria-labelledby="owui-h">
            <h2 id="owui-h">Optional: use Open WebUI as a client</h2>
            <div class="path-row">
                <span class="hop">Open WebUI</span><span aria-hidden="true">→</span>
                <span class="hop">Covenant /v1</span><span aria-hidden="true">→</span>
                <span class="hop">Covenant request pipeline</span><span aria-hidden="true">→</span>
                <span class="hop">Ollama</span>
            </div>
            <dl class="facts">
                <dt>OpenAI-compatible base URL</dt><dd class="mono">@CovenantV1</dd>
                <dt>API key</dt><dd>A Covenant application key — never the admin token.</dd>
                <dt>Supported</dt><dd>Text chat, buffered and streamed. Tools, images and other APIs are not supported and are refused.</dd>
            </dl>
            <span class="note">Pointing Open WebUI at Ollama directly bypasses Covenant: no policy, budget, pause or audit.</span>
        </section>
    </RequiresConnection>
</div>

@code {
    private string _endpoint = "";
    private bool _invalidated;

    private ProbeResponse? _probe;
    private DateTimeOffset _probeAtUtc;
    private bool _probing;
    private string? _probeError;

    private string? _tag;
    private bool _localOnly;

    private bool _checking;
    private bool _appliedChecked;
    private bool _appliedPass;
    private string? _appliedMessage;

    private bool _testing;
    private InferenceResult? _testResult;
    private OutcomeView? _testOutcome;
    private EvidenceStatus _testEvidence = EvidenceStatus.Idle;
    private CancellationTokenSource? _cts;
    private string? _testApp;

    private string? EndpointProblem => ConnectionLogic.EndpointProblem(_endpoint);
    private bool ProbePassed => _probe is { Allowed: true, Reachable: true };
    private bool DiscoveryPassed => ProbePassed && _probe is { Models.Count: > 0 };
    private bool TagPassed => DiscoveryPassed && _tag is not null && _probe is { } p && p.Models.Contains(_tag);
    private bool AppliedPassed => TagPassed && _appliedChecked && _appliedPass;

    private string CovenantV1 => new Uri(new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority)).ToString().TrimEnd('/') + "/v1";

    private string TestTone => _testOutcome is null ? "" : _testOutcome.PillKind switch { "served" => "ok", "failed" => "bad", _ => "warn" };
    private string TestStepText => _testOutcome is null ? (AppliedPassed ? "Ready" : "Locked") : OutcomeModel.Label(_testOutcome.Outcome);

    private string EvidenceText => _testEvidence.State switch
    {
        EvidenceState.Pending => "Awaiting audit record…",
        EvidenceState.Unavailable => _testEvidence.Message ?? EvidenceTracker.UnavailableMessage,
        EvidenceState.Error => _testEvidence.Message ?? "Evidence lookup failed",
        _ => _testResult?.RequestId is null ? "No request id received" : "Not looked up",
    };

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await Ws.EnsureLoadedAsync();
        _testApp = ComposerRules.Applications(Ws.Applications).FirstOrDefault(c => c.Selectable)?.App.Id;
    }

    private void OnTestApp(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _testApp = ComposerRules.Find(Ws.Applications, id) is { } a && ComposerRules.WhyNotSelectable(a) is null ? a.Id : null;
    }

    private static string StepText(bool passed, bool attempted) => passed ? "Passed" : attempted ? "Not passed" : "";
    private static string StepTone(bool passed, bool attempted) => passed ? "ok" : attempted ? "bad" : "";

    private static string HealthText(ModelHealth? h)
    {
        if (h is null) return "Not reported";
        var state = string.IsNullOrWhiteSpace(h.State) ? "unknown" : h.State;
        var now = DateTimeOffset.UtcNow;
        var parts = new List<string> { state };
        parts.Add("last success " + (h.LastSuccessUtc is null ? "never" : Fmt.Ago(h.LastSuccessUtc, now)));
        if (h.LastFailureUtc is not null) parts.Add("last failure " + Fmt.Ago(h.LastFailureUtc, now));
        if (!string.IsNullOrWhiteSpace(h.LastError)) parts.Add("error: " + h.LastError);
        return string.Join(" · ", parts);
    }

    private static string PriceText(CatalogModel m) => m.PriceBasis switch
    {
        "zero" => "$0 configured provider price (infrastructure excluded)",
        "configured" => $"{(m.InPer1M is { } i ? Fmt.Usd(i, 2) : "?")} in / {(m.OutPer1M is { } o ? Fmt.Usd(o, 2) : "?")} out per 1M tokens",
        "unpriced" => "Unpriced — cost unknown, not zero",
        _ => "Not reported",
    };

    private void OnEndpointInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        if (string.Equals(next, _endpoint, StringComparison.Ordinal)) return;
        bool hadDraftResults = _probe is not null || _tag is not null || _appliedChecked || _testOutcome is not null;
        _endpoint = next;
        InvalidateFromProbe();
        _invalidated = hadDraftResults;
    }

    /// <summary>Editing the endpoint invalidates every later DRAFT result. The running configuration is untouched.</summary>
    private void InvalidateFromProbe()
    {
        _cts?.Cancel();
        _probe = null;
        _probeError = null;
        _tag = null;
        InvalidateFromApplied();
    }

    private void InvalidateFromApplied()
    {
        _appliedChecked = false;
        _appliedPass = false;
        _appliedMessage = null;
        _testResult = null;
        _testOutcome = null;
        _testEvidence = EvidenceStatus.Idle;
    }

    private void ChooseTag(string tag)
    {
        if (string.Equals(_tag, tag, StringComparison.Ordinal)) return;
        _tag = tag;
        InvalidateFromApplied();
    }

    private async Task ProbeAsync()
    {
        if (EndpointProblem is not null || _probing) return;
        var endpoint = _endpoint.Trim();
        _probing = true;
        _probeError = null;
        _invalidated = false;
        _probe = null;
        _tag = null;
        InvalidateFromApplied();
        try
        {
            var result = await Api.ProbeAsync(endpoint);
            // Ignore a stale answer if the endpoint was edited while the probe was running.
            if (string.Equals(_endpoint.Trim(), endpoint, StringComparison.Ordinal))
            {
                _probe = result;
                _probeAtUtc = DateTimeOffset.UtcNow;
            }
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            // handled by ConsoleSession
        }
        catch (Exception ex)
        {
            _probeError = ex.Message;
        }
        finally
        {
            _probing = false;
        }
        // A probe of the APPLIED endpoint updates its observed health on the server.
        await Catalog.RefreshAsync();
    }

    private async Task CheckAppliedAsync()
    {
        if (!TagPassed || _tag is not { } tag) return;
        _checking = true;
        try
        {
            await Catalog.RefreshAsync();
            var (pass, message) = ConnectionLogic.CheckApplied(State.Catalog, _endpoint, tag);
            _appliedPass = pass;
            _appliedMessage = message + " Read " + Fmt.Utc(State.CatalogUpdatedUtc) + ".";
            _appliedChecked = true;
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task RunTestAsync()
    {
        if (!AppliedPassed || _testing || _tag is not { } tag || _testApp is not { } app) return;
        _testing = true;
        _testResult = null;
        _testOutcome = null;
        _testEvidence = EvidenceStatus.Idle;
        _cts?.Cancel();
        var cts = new CancellationTokenSource();
        _cts = cts;
        try
        {
            var form = new PlaygroundForm
            {
                ApplicationId = app,
                ProfileId = ComposerRules.Find(Ws.Applications, app) is { } appDto ? ComposerRules.DefaultProfile(appDto) : null,
                Streaming = false,
                Prompt = ConnectionLogic.GovernedTestPrompt(),
                Mode = RouteMode.Explicit,
                ExplicitModel = tag,
                MaxTokens = 16,
                Workflow = "connection-test",
                UseCase = "local-route-check",
            };
            var snapshot = RequestSnapshot.Freeze(1, form, DateTimeOffset.UtcNow);
            var result = await Inference.SendAsync(snapshot, null, null, cts.Token);
            _testResult = result;
            _testOutcome = OutcomeModel.Compute(result.ToOutcomeInput(null));
            StateHasChanged();

            if (result.RequestId is { Length: > 0 } id && result.HttpStatus is not null)
            {
                var final = await Evidence.TrackAsync(id, s => { _testEvidence = s; _ = InvokeAsync(StateHasChanged); }, cts.Token);
                if (final.State != EvidenceState.Idle) _testEvidence = final;
                _testOutcome = OutcomeModel.Compute(result.ToOutcomeInput(_testEvidence.Record));
            }
        }
        finally
        {
            _testing = false;
            if (ReferenceEquals(_cts, cts)) _cts = null;
            cts.Dispose();
        }
        // The backend records success/failure from this real call; re-read shared health so the header and catalog
        // show a later failure even after an earlier success (last success time is kept by the server).
        await Catalog.RefreshAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        _cts?.Cancel();
    }
}
