@page "/connections"
@inject AppState State
@inject AdminApi Api
@inject CatalogState Catalog
@inject ConfigEditor Editor
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Models &amp; connections · Covenant</PageTitle>

@*
  T08. Connections from the versioned configuration (GET /admin/config) joined with the catalog's observed health
  (GET /admin/catalog). Add / Edit / Disable change the configuration DRAFT; Preview impact → Save & apply activates a
  new version (PUT /admin/config, If-Match). Test probes the endpoint host-side (POST /admin/providers/probe).
  Secrets are references only. The old "edit a file and restart" wizard is gone.
*@

<div class="page">
    <RequiresConnection>
        <div class="page-head">
            <div class="titles">
                <h1>Models &amp; connections</h1>
                <span class="lede">Where Covenant may send calls: approved connections and the exact models permitted on each. Permission, health and price are separate facts.</span>
            </div>
            <div class="btn-row tight">
                <button type="button" class="btn primary" id="add-ollama" @onclick="AddOllama" disabled="@(!CanEdit)"><Icon Name="local" Size="16" /><span>Add Ollama</span></button>
                <button type="button" class="btn" id="add-cloud" @onclick="AddCloud" disabled="@(!CanEdit)"><Icon Name="cloud" Size="16" /><span>Add cloud provider</span></button>
                <Button Busy="@Catalog.Refreshing" BusyText="Refreshing…" OnClick="RefreshAsync">Refresh</Button>
            </div>
        </div>

        <EditorBar Owner="connections" Subject="Connections" ShowEditButton="false"
                   ViewHint="Add, edit or disable a connection to start a draft." ClaimedPaths="@ClaimedPaths" />

        @if (Editor.Current is not { } cfg)
        {
            if (Editor.Loading || (Editor.Applied is null && Editor.LoadError is null))
            {
                <section class="panel"><Skeleton Lines="5" Label="Loading connections" /></section>
            }
            else if (Editor.EndpointMissing)
            {
                <EmptyState Title="Connections cannot be edited on this Host" Body="This Host does not expose versioned configuration (GET /admin/config). Integration pending on the backend; nothing here is editable until it does." />
            }
        }
        else
        {
            if (State.CatalogError is { } ce)
            {
                <ErrorBanner Title="Health unavailable" Message="@("Catalog: " + ce + " — connections are listed from the configuration; observed health is unknown.")" OnRetry="RefreshAsync" />
            }
            if (cfg.Connections.Count == 0)
            {
                <EmptyState Title="No connections configured" Body="Every request is refused until an approved connection and a policy route exist (fail-closed).">
                    <button type="button" class="btn primary" @onclick="AddOllama">Add Ollama</button>
                    <button type="button" class="btn" @onclick="AddCloud">Add cloud provider</button>
                </EmptyState>
            }
            else
            {
                <ul class="conn-list" aria-label="Configured connections">
                    @foreach (var c in cfg.Connections)
                    {
                        var conn = c;
                        var cat = CatalogFor(conn.Id);
                        var health = HealthFor(conn, cat);
                        var changed = ChangedInDraft(conn);
                        var routed = RoutedBy(cfg, conn.Id);
                        <li class="conn-card @(conn.Enabled ? "" : "disabled")">
                            <div class="conn-head">
                                <span class="conn-icon" aria-hidden="true"><Icon Name="@(ComposerRules.BoundaryLabel(conn.Boundary) == "Cloud" ? "cloud" : "local")" Size="20" /></span>
                                <div class="conn-title">
                                    <strong class="wrap-any">@(conn.DisplayName ?? conn.Id)</strong>
                                    <span class="secondary subtle"><span class="mono">@conn.Id</span> · @ConnectionRules.KindLabel(conn.Kind)</span>
                                </div>
                                <BoundaryTag Boundary="@ComposerRules.BoundaryLabel(conn.Boundary)" />
                                <span class="pill @(conn.Enabled ? "served" : "unknown")"><span class="dot" aria-hidden="true"></span>@(conn.Enabled ? "Enabled" : "Disabled")</span>
                                @if (changed is { } ch)
                                {
                                    <span class="changed-flag">@ch</span>
                                }
                            </div>
                            <dl class="facts">
                                <dt>Endpoint</dt>
                                <dd class="mono wrap-any">@(conn.Endpoint ?? "Provider default")
                                    @if (cat is { EndpointAllowListed: false })
                                    {
                                        <span class="note bad"> · not on the startup egress allow-list</span>
                                    }
                                </dd>
                                <dt>Permitted models</dt>
                                <dd>
                                    @if (conn.Models.Count == 0)
                                    {
                                        <span class="muted">None — this connection serves nothing</span>
                                    }
                                    else
                                    {
                                        <ul class="inline-list">
                                            @foreach (var m in conn.Models)
                                            {
                                                <li><span class="mono wrap-any">@m.ModelId</span> <span class="subtle">· @Money.Price(m.Price?.InputPer1M, m.Price?.OutputPer1M)@(m.Price?.Basis is { Length: > 0 } b ? " (" + b + ")" : "")</span>@RegisteredNote(cat, m.ModelId)</li>
                                            }
                                        </ul>
                                    }
                                </dd>
                                @if (conn.SecretRef is { } sr)
                                {
                                    <dt>Credential</dt>
                                    <dd><span class="mono">@sr</span> · @SecretText(sr, cat)</dd>
                                }
                                <dt>Used by</dt>
                                <dd>@(routed.Count == 0 ? "No policy routes" : string.Join(", ", routed))</dd>
                                <dt>Health</dt>
                                <dd>
                                    <span class="indicator"><span class="dot @health.Tone" aria-hidden="true"></span>@health.Summary</span>
                                    <details class="tech">
                                        <summary>Timestamps</summary>
                                        <dl class="facts">
                                            @foreach (var (label, value) in health.Details)
                                            {
                                                <dt>@label</dt><dd class="wrap-any">@value</dd>
                                            }
                                        </dl>
                                        <span class="note">A probe shows the endpoint answered; only a governed call shows a model served. GET /v1/models is not a health check.</span>
                                    </details>
                                </dd>
                            </dl>
                            <div class="btn-row tight">
                                <button type="button" class="btn sm" id="@("edit-" + conn.Id)" @onclick="() => EditConnection(conn)" disabled="@(!CanEdit)">Edit</button>
                                @if (conn.Endpoint is { Length: > 0 })
                                {
                                    <button type="button" class="btn sm" @onclick="() => TestAsync(conn)" disabled="@_testing.Contains(conn.Id)" aria-busy="@(_testing.Contains(conn.Id) ? "true" : null)">
                                        @(_testing.Contains(conn.Id) ? "Testing…" : "Test")
                                    </button>
                                }
                                else
                                {
                                    <span class="secondary subtle">Test: provider default endpoints are not probed — run a governed Public request in the Playground.</span>
                                }
                                <button type="button" class="btn sm" @onclick="() => ToggleEnabled(conn)" disabled="@(!CanEdit)">@(conn.Enabled ? "Disable…" : "Enable…")</button>
                            </div>
                            @if (_testErrors.TryGetValue(conn.Id, out var terr))
                            {
                                <span class="note bad" role="status">Test failed to run: @terr</span>
                            }
                            @if (_probes.TryGetValue(conn.Id, out var pr) && !pr.Probe.Allowed)
                            {
                                <span class="note bad" role="status">Probe refused: @(ConnectionLogic.Authority(conn.Endpoint) ?? "this destination") is not on the probe allow-list (Providers:ProbeAllowList; restart required).</span>
                            }
                            <FieldIssues Issues="@Editor.Issues" Path="@IssueIndex.Connection(cfg.Connections.IndexOf(conn))" />
                        </li>
                    }
                </ul>
                <span class="note">Disable/Enable change the draft only; preview the impact and save to apply. Disabled connections are never eligible for any route.</span>
            }

            <details class="panel tech">
                <summary>Using Open WebUI or another client</summary>
                <span class="note">Point the client at <span class="mono">@CovenantV1</span> with a Covenant application key (never the admin token). Pointing it at Ollama directly bypasses Covenant: no policy, budget, pause or audit.</span>
            </details>
        }

        <Drawer Title="@DrawerTitle" Open="@(_form is not null)" OpenChanged="OnDrawerOpenChanged" OpenerId="@_openerId">
            @if (_form is { } form)
            {
                <ConnectionEditor Form="@form" Envelope="@Editor.Applied" OtherIds="@OtherIds(form)" DraftIndex="@_draftIndex"
                                  Issues="@Editor.Issues" Validation="@Editor.Validation" ValidationCurrent="@Editor.ValidationCurrent"
                                  Validating="@Editor.Validating" Saving="@Editor.Saving" CanSave="@Editor.CanSave"
                                  RemovedStillRouted="@(Editor.Current is { } cur ? form.RemovedModelsStillRouted(cur) : Array.Empty<string>())"
                                  OnPreview="PreviewFormAsync" OnSave="SaveFormAsync" OnChanged="StateHasChanged"
                                  OnProbed="@(p => RecordProbe(form.OriginalId ?? form.Id, p))" />
                @if (Editor.LastOutcome is { Succeeded: false } lo && lo.Kind != EditOutcomeKind.Stale)
                {
                    <ErrorBanner Title="Not applied" Message="@lo.Message" />
                }
                @if (Editor.Conflict is { } conflict)
                {
                    <div class="alert warn" role="alert"><div class="alert-text"><strong>@conflict.Message</strong><span class="alert-body">Use Reload or Compare in the page bar.</span></div></div>
                }
            }
        </Drawer>

        <Drawer Mode="dialog" Title="@(_toggleTarget is { } t ? (t.Enabled ? "Disable " : "Enable ") + (t.DisplayName ?? t.Id) + "?" : "")"
                Open="@(_toggleTarget is not null)" OpenChanged="@(open => { if (!open) _toggleTarget = null; })">
            @if (_toggleTarget is { } tt)
            {
                <p class="secondary">
                    @(tt.Enabled
                        ? "Disabling removes every model on this connection from eligibility. Routes that name it fall to their next approved target, or are refused when none remains. "
                        : "Enabling makes this connection's permitted models eligible again for the routes that name them. ")
                    This changes the draft only; you will preview the impact before anything is applied.
                </p>
                <div class="btn-row" style="justify-content:flex-end">
                    <button type="button" class="btn" @onclick="() => _toggleTarget = null">Cancel</button>
                    <button type="button" class="btn primary" @onclick="ConfirmToggleAsync">@(tt.Enabled ? "Disable in draft & preview" : "Enable in draft & preview")</button>
                </div>
            }
        </Drawer>
    </RequiresConnection>
</div>

@code {
    private ConnectionForm? _form;
    private int? _draftIndex;
    private string? _openerId;
    private ConnectionDto? _toggleTarget;
    private readonly HashSet<string> _testing = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _testErrors = new(StringComparer.Ordinal);
    private readonly Dictionary<string, (ProbeResponse Probe, DateTimeOffset At)> _probes = new(StringComparer.Ordinal);

    private bool CanEdit => Editor.Applied is not null && !Editor.Saving && (!Editor.Editing || Editor.Owner == "connections" || !Editor.IsDirty);

    private IReadOnlyList<string> ClaimedPaths => Editor.Current is { } c ? Enumerable.Range(0, c.Connections.Count).Select(IssueIndex.Connection).ToList() : [];

    private string DrawerTitle => _form is null ? "" : _form.IsNew
        ? (_form.IsOllama ? "Add Ollama connection" : "Add cloud provider")
        : "Edit " + (_form.DisplayName.Length > 0 ? _form.DisplayName : _form.Id);

    private string CovenantV1 => new Uri(new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority)).ToString().TrimEnd('/') + "/v1";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Editor.Changed += OnChanged;
        await Editor.EnsureLoadedAsync();
    }

    private Task RefreshAsync() => Catalog.RefreshAsync();

    private CatalogConnectionDto? CatalogFor(string id)
        => State.Catalog?.Connections?.FirstOrDefault(c => string.Equals(c.Id, id, StringComparison.Ordinal));

    private ConnectionHealthView HealthFor(ConnectionDto conn, CatalogConnectionDto? cat)
    {
        // One shape: the catalog's connection-scoped view (catalog.connections[].models[].health). A connection the
        // catalog does not list has no observed health yet.
        var models = cat?.Models.Select(m => m.Health).ToList() ?? new List<ModelHealth?>();
        ModelHealth? endpointHealth = null;
        if (State.Catalog?.Local is { } local && ConnectionLogic.SameEndpoint(local.Endpoint, conn.Endpoint)) endpointHealth = local.EndpointHealth;
        _probes.TryGetValue(conn.Id, out var probe);
        return ConnectionHealth.Summarize(conn.Enabled, models, probe.Probe, probe.Probe is null ? null : probe.At, endpointHealth, DateTimeOffset.UtcNow);
    }

    private static string RegisteredNote(CatalogConnectionDto? cat, string modelId)
    {
        var m = cat?.Models.FirstOrDefault(x => string.Equals(x.ModelId, modelId, StringComparison.Ordinal));
        return m is { Registered: false } ? " · no provider client (refused at the provider stage)" : "";
    }

    private string SecretText(string secretRef, CatalogConnectionDto? cat)
    {
        bool? available = cat?.SecretAvailable;
        if (available is null && Editor.Applied?.Secrets is { } map && map.TryGetValue(secretRef, out var s)) available = s.Available;
        return available switch
        {
            true => "available on the server (value never shown)",
            false => "NOT SET on the server — set " + ConnectionRules.EnvVarFor(secretRef) + " and restart",
            null => "availability not reported (checked on preview)",
        };
    }

    private string? ChangedInDraft(ConnectionDto conn)
    {
        if (!Editor.Editing || Editor.Applied?.Config is not { } applied) return null;
        var before = applied.Connections.FirstOrDefault(c => string.Equals(c.Id, conn.Id, StringComparison.Ordinal));
        if (before is null) return "New in draft";
        return string.Equals(ConfigCopy.Canonical(before), ConfigCopy.Canonical(conn), StringComparison.Ordinal) ? null : "Changed in draft";
    }

    private static List<string> RoutedBy(CovenantConfigDto cfg, string connectionId)
        => cfg.Policies.Where(p => p.Targets.Any(t => string.Equals(t.ConnectionId, connectionId, StringComparison.Ordinal)))
            .Select(p => (p.Name ?? p.Id) + (p.Enabled ? "" : " (disabled)"))
            .ToList();

    private IReadOnlyList<string> OtherIds(ConnectionForm form)
        => (Editor.Current?.Connections ?? []).Select(c => c.Id)
            .Where(id => !string.Equals(id, form.AppliedAsId ?? form.OriginalId, StringComparison.Ordinal)).ToList();

    private IEnumerable<string> ExistingIds => (Editor.Current?.Connections ?? []).Select(c => c.Id);

    private void AddOllama()
    {
        _form = ConnectionForm.NewOllama(ExistingIds);
        _draftIndex = null;
        _openerId = "add-ollama";
    }

    private void AddCloud()
    {
        _form = ConnectionForm.NewCloud("OpenAi", ExistingIds);
        _draftIndex = null;
        _openerId = "add-cloud";
    }

    private void EditConnection(ConnectionDto conn)
    {
        _form = ConnectionForm.FromConnection(conn);
        _draftIndex = Editor.Current?.Connections.IndexOf(conn) is int i and >= 0 && Editor.Editing ? i : null;
        _openerId = "edit-" + conn.Id;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        if (!open) _form = null;
    }

    /// <summary>Puts the form into the draft and asks the Host for validation + impact.</summary>
    private async Task PreviewFormAsync()
    {
        if (_form is not { } form || !Editor.BeginEdit("connections") || Editor.Draft is not { } draft) return;
        _draftIndex = form.ApplyTo(draft);
        Editor.Touch();
        await Editor.ValidateAsync();
    }

    private async Task SaveFormAsync()
    {
        var outcome = await Editor.SaveAsync();
        if (outcome.Succeeded) _form = null;
    }

    private void ToggleEnabled(ConnectionDto conn) => _toggleTarget = conn;

    private async Task ConfirmToggleAsync()
    {
        if (_toggleTarget is not { } target) return;
        _toggleTarget = null;
        if (!Editor.BeginEdit("connections") || Editor.Draft is not { } draft) return;
        var inDraft = draft.Connections.FirstOrDefault(c => string.Equals(c.Id, target.Id, StringComparison.Ordinal));
        if (inDraft is null) return;
        inDraft.Enabled = !inDraft.Enabled;
        Editor.Touch();
        await Editor.ValidateAsync();
    }

    private async Task TestAsync(ConnectionDto conn)
    {
        if (conn.Endpoint is not { Length: > 0 } endpoint || !_testing.Add(conn.Id)) return;
        _testErrors.Remove(conn.Id);
        try
        {
            var result = await Api.ProbeAsync(endpoint);
            RecordProbe(conn.Id, result);
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            // ConsoleSession disconnects.
        }
        catch (Exception ex)
        {
            _testErrors[conn.Id] = ex.Message;
        }
        finally
        {
            _testing.Remove(conn.Id);
        }
        await Catalog.RefreshAsync();
    }

    private void RecordProbe(string connectionId, ProbeResponse p) => _probes[connectionId] = (p, DateTimeOffset.UtcNow);

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Editor.Changed -= OnChanged;
    }
}
