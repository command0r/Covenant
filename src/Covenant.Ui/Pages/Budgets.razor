@page "/budgets"
@inject AppState State
@inject AdminApi Api
@inject ConfigEditor Editor
@implements IDisposable

<PageTitle>Budgets · Covenant</PageTitle>

@*
  T08. Budget state per scope from the ledger (GET /admin/budgets, ADR-0014): period + period id, spent, reserved,
  remaining, cap, warning state, enforcement. Caps/thresholds/period/enforcement are edited in the configuration draft
  (ConfigEditor → Preview impact → Save & apply). Drill-down: GET /admin/budgets/{id}/requests. Amounts via
  Logic/Money (significant digits; never $0.00 for a non-zero charge).
*@

<div class="page">
    <RequiresConnection>
        <div class="page-head">
            <div class="titles">
                <h1>Budgets</h1>
                <span class="lede">Provider spend by scope and UTC period, checked before every paid attempt. Spend lives in the budget ledger — independent of audit segments.</span>
            </div>
            <Button Busy="@_loading" BusyText="Loading…" OnClick="LoadAsync">Refresh</Button>
        </div>

        <EditorBar Owner="budgets" Subject="Budgets" ShowEditButton="false" ClaimedPaths="@ClaimedPaths" OnSaved="LoadAsync"
                   ViewHint="Each budget is edited in its own dialog; saving creates a new configuration version." />
        @if (_notice is { } notice)
        {
            <span class="note" role="status">@notice</span>
        }

        <ErrorBanner Title="Budget state unavailable" Message="@_error" OnRetry="LoadAsync" Busy="@_loading" />

        @if (_budgets is null && _loading)
        {
            <section class="panel"><Skeleton Lines="4" Label="Loading budget state" /></section>
        }
        else if (_endpointMissing)
        {
            <div class="alert warn" role="status">
                <div class="alert-text">
                    <strong>This Host has no budget ledger yet (GET /admin/budgets is missing)</strong>
                    <span class="alert-body">Integration pending on the backend. Shown below: the pre-v2 status counters (global and team spend of the current audit segment). Periods, reservations and application scopes are not available on this Host.</span>
                </div>
            </div>
            @if (State.LastStatus is { } s)
            {
                <section class="panel">
                    <h2>Pre-v2 counters</h2>
                    <FactList Inline="true" Facts="@LegacyFacts(s)" />
                </section>
            }
        }
        else if (_budgets is { } budgets)
        {
            if (budgets.Count == 0)
            {
                <EmptyState Title="No budgets reported" Body="A global budget is required by validation; if none is reported, check the Host's configuration." />
            }
            else
            {
                if (BudgetText.NoSpendAnywhere(budgets))
                {
                    <div class="alert info" role="status">
                        <div class="alert-text">
                            <strong>No provider spend in the current periods</strong>
                            <span class="alert-body">Requests served by local models with a zero-marginal price reserve and settle $0 provider charge, and refusals or cache hits make no call — so there is nothing to chart. Infrastructure cost (hardware, power, operations) is not measured by Covenant. To see spend, route Public traffic to a priced cloud connection.</span>
                        </div>
                        <a class="btn" href="connections">Models &amp; connections</a>
                    </div>
                }
                <section class="panel flush" aria-labelledby="bs-h">
                    <div class="panel-head">
                        <h2 id="bs-h">Budget state</h2>
                        <InfoTip Label="How do Global and application budgets combine?">Budgets are ceilings over the same charges. Global covers every application. A team or application cap is an additional, smaller ceiling within Global: the same charge counts against both, never added up as separate spend. A "Hard cap" refuses a paid request whose reserved cost would exceed any applicable cap (an estimated bound); "Warn only" never blocks. Alerts are the warning thresholds in % of the cap.</InfoTip>
                        <span class="panel-sub">@(_loadedUtc is { } t ? "Read " + Fmt.UtcShort(t) + " UTC from the ledger" : "")</span>
                        <span class="grow"></span>
                        <button type="button" class="btn sm" id="budget-add" disabled="@(!CanEdit)" @onclick="OpenAdd"><Icon Name="plus" Size="16" /><span>Add budget…</span></button>
                    </div>
                    <div class="table-wrap">
                        <table class="budget-table">
                            <thead>
                                <tr>
                                    <th scope="col">Scope</th>
                                    <th scope="col">Period</th>
                                    <th scope="col" class="num">Spent</th>
                                    <th scope="col" class="num">Reserved</th>
                                    <th scope="col" class="num">Remaining</th>
                                    <th scope="col" class="num">Cap</th>
                                    <th scope="col">State</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in budgets)
                                {
                                    var row = b;
                                    var warn = BudgetText.Warning(row.Warning);
                                    var pct = BudgetText.MeterPercent(row.SpentUsd, row.ReservedUsd, row.CapUsd);
                                    <tr>
                                        <td>
                                            <div class="budget-scope" title="@(BudgetText.Coverage(row.Scope, Editor.Applied?.Config) + " Budget id: " + row.Id)">
                                                <span class="budget-name">
                                                    <strong>@BudgetText.ScopeName(row.Scope, Editor.Applied?.Config)</strong>
                                                    @if (BudgetText.TeamOf(row.Scope, Editor.Applied?.Config) is { } team) { <span class="chip">team @team</span> }
                                                    @if (BudgetText.IsLowCap(row.Scope, row.CapUsd, row.Enforcement)) { <span class="jchip refused" title="@BudgetText.LowCapEffect(row.CapUsd)"><span>Low spending cap</span></span> }
                                                </span>
                                                <span class="secondary subtle">@BudgetText.ShortCoverage(row.Scope)</span>
                                            </div>
                                        </td>
                                        <td class="secondary budget-period"><span>@BudgetText.PeriodName(row.Period)</span>@if (!string.IsNullOrWhiteSpace(row.PeriodId)) { <span class="mono subtle">@row.PeriodId</span> }</td>
                                        <td class="num mono">@Money.Usd(row.SpentUsd)</td>
                                        <td class="num mono">@Money.Usd(row.ReservedUsd)</td>
                                        <td class="num mono">@BudgetText.Remaining(row.RemainingUsd)</td>
                                        <td class="num mono">@Money.Cap(row.CapUsd)
                                            <span class="meter @(warn.Tone == "bad" ? "bad" : warn.Tone == "warn" ? "warn" : "")" role="img"
                                                  aria-label="@(Money.Share(row.SpentUsd + row.ReservedUsd, row.CapUsd) + " of the cap spent or reserved")"><span style="width:@pct%"></span></span>
                                        </td>
                                        <td class="secondary budget-state" title="@(BudgetText.Enforcement(row.Enforcement) + " · warning thresholds " + BudgetText.Thresholds(row.WarnAt))">
                                            <span class="indicator"><span class="dot @warn.Tone" aria-hidden="true"></span>@warn.Label</span>
                                            <span class="subtle">@BudgetText.StateLine(row.Enforcement, row.WarnAt)</span>
                                        </td>
                                        <td class="row-actions">
                                            <div class="budget-actions">
                                                <button type="button" class="btn sm" id="@("budget-edit-" + row.Id)" disabled="@(!CanEdit || ConfigBudget(row.Id) is null)" @onclick="() => OpenEdit(row.Id)">Edit</button>
                                                <button type="button" class="btn sm" id="@("drill-" + row.Id)" @onclick="() => OpenDrillAsync(row)">Requests</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }

        @if (_edit is { } be)
        {
            var b = be.Working;
            var problem = BudgetForm.Problem(be, _warnText, Editor.Applied?.Config);
            <EditDialog Open="true" OpenChanged="@(_ => CloseDialog())" Title="@(be.IsNew ? "New budget" : "Budget: " + BudgetText.Scope(b.Scope))"
                        OpenerId="@(be.IsNew ? "budget-add" : "budget-edit-" + be.OriginalKey)" IsDirty="@(() => be.IsDirty || _warnText != BudgetText.FormatThresholds(_warnOriginal))"
                        Busy="@_saving" SaveDisabled="@(problem is not null)"
                        Error="@(_saveError ?? problem)" ErrorTitle="@(_saveError is null ? "Before saving" : _saveErrorTitle)" ErrorTone="@(_saveError is null ? "warn" : _saveErrorTone)" Issues="@_issues"
                        OnSave="@(() => SaveAsync(be))" OnCancel="DiscardScoped">
                @if (be.IsNew)
                {
                    <div class="dialog-section">
                        <div class="form-grid">
                            <div class="field">
                                <label for="bd-kind">Scope</label>
                                <select id="bd-kind" class="input" value="@_newKind" @onchange="@(e => SetNewScope(b, e.Value?.ToString() ?? "team", _newName))">
                                    <option value="team">Team</option>
                                    <option value="application">Application</option>
                                    <option value="global">Global</option>
                                </select>
                            </div>
                            @if (_newKind != "global")
                            {
                                <div class="field">
                                    <label for="bd-name">@(_newKind == "team" ? "Team name" : "Application id")</label>
                                    <input id="bd-name" class="input mono" spellcheck="false" value="@_newName" @oninput="@(e => SetNewScope(b, _newKind, e.Value?.ToString()))" />
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="dialog-section">
                    <div class="form-grid">
                        <div class="field">
                            <label for="bd-cap">Cap (USD)</label>
                            <input id="bd-cap" class="input mono" type="number" min="0" step="any" @bind="b.CapUsd" @bind:event="oninput" />
                            <span class="help">Lowering it below current spend blocks new paid work; spend is never erased.</span>
                        </div>
                        <div class="field">
                            <label for="bd-per">Period (UTC)</label>
                            <select id="bd-per" class="input" value="@(b.Period ?? "monthly")" @onchange="@(e => b.Period = e.Value?.ToString() is "daily" or "none" ? e.Value!.ToString() : "monthly")">
                                <option value="monthly">Monthly</option>
                                <option value="daily">Daily</option>
                                <option value="none">No period (cumulative)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="bd-warn">Warn at (% of cap)</label>
                            <input id="bd-warn" class="input mono" placeholder="80, 95" @bind="_warnText" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label for="bd-enf">Enforcement</label>
                            <select id="bd-enf" class="input" value="@(b.Enforcement ?? "hard")" @onchange="@(e => b.Enforcement = e.Value?.ToString() == "warn-only" ? "warn-only" : "hard")">
                                <option value="hard">Hard — refuse paid work over the cap</option>
                                <option value="warn-only">Warn only — never block</option>
                            </select>
                        </div>
                    </div>
                    <span class="secondary subtle">Hard caps are an estimated bound (reservation from enforced input/output limits), not an invoice ceiling.</span>
                </div>
            </EditDialog>
        }

        <details class="panel tech budget-accounting">
            <summary>How charges are counted</summary>
            <ul class="plain-list secondary">
                <li><strong>Provider charge:</strong> provider-reported tokens × the configured price for that connection/model. Covenant does not read provider invoices.</li>
                <li><strong>Reservation:</strong> before each attempt a conservative amount is held; it settles once against reported usage (or an explicit estimate) and the rest is released.</li>
                <li><strong>Unknown is not $0:</strong> an unpriced paid model is not eligible under a hard budget.</li>
                <li><strong>Local models:</strong> priced "zero marginal" settle $0 provider charge. Hardware, power and operations are excluded — not free; no infrastructure estimate is configured.</li>
                <li><strong>Periods and archives:</strong> a period rolls over by UTC date. Archiving the audit log (earlier saved history) never reopens or resets a budget.</li>
            </ul>
        </details>

        <Drawer Title="@(_drill is { } d ? "Contributing requests · " + BudgetText.Scope(d.Scope) : "")" Open="@(_drill is not null)" OpenChanged="OnDrillOpenChanged"
                OpenerId="@(_drill is { } dd ? "drill-" + dd.Id : null)">
            @if (_drill is { } db)
            {
                <span class="secondary muted">@BudgetText.Period(db.Period, db.PeriodId) · settled contributions, newest first. Open a request to see its attempts and evidence.</span>
                @if (_drillLoading)
                {
                    <Skeleton Lines="5" Label="Loading contributing requests" />
                }
                <ErrorBanner Title="Contributing requests unavailable" Message="@_drillError" OnRetry="@(() => LoadDrillAsync(db))" />
                @if (_drillRows is { Count: 0 })
                {
                    <EmptyState Title="No settled requests in this period" Body="Nothing has been charged to this scope in the current period." />
                }
                else if (_drillRows is { } rows)
                {
                    <ol class="row-list">
                        @foreach (var r in rows)
                        {
                            var req = r;
                            <li>
                                <a class="mono" href="@("requests/" + Uri.EscapeDataString(req.RequestId))">@req.RequestId</a>
                                <span class="mono">@Money.Usd(req.AmountUsd)</span>
                                <span class="subtle secondary">@(Fmt.Utc(req.TsUtc) + (req.AttemptId.Length > 0 ? " · attempt " + req.AttemptId : "") + (req.Kind != "settle" && req.Kind.Length > 0 ? " · " + req.Kind : ""))</span>
                                @if (req.Overrun)
                                {
                                    <span class="note warn">Reported charge exceeded the reservation — settled in full.</span>
                                }
                            </li>
                        }
                    </ol>
                }
            }
        </Drawer>
    </RequiresConnection>
</div>

@code {
    private List<BudgetStateDto>? _budgets;
    private bool _loading;
    private string? _error;
    private bool _endpointMissing;
    private DateTimeOffset? _loadedUtc;
    private bool _started;

    private BudgetStateDto? _drill;
    private bool _drillLoading;
    private string? _drillError;
    private List<BudgetContributionDto>? _drillRows;

    private string _newKind = "team";
    private string? _newName;
    private EntityEdit<BudgetConfigDto>? _edit;
    private string _warnText = "";
    private List<decimal>? _warnOriginal;
    private bool _saving;
    private string? _saveError;
    private string? _saveErrorTitle;
    private string _saveErrorTone = "bad";
    private IReadOnlyList<ConfigIssueDto>? _issues;
    private string? _notice;

    private bool CanEdit => Editor.Applied?.Config is not null && !Editor.Saving && !_saving && (!Editor.IsDirty || Editor.Owner == "budgets");

    private IReadOnlyList<string> ClaimedPaths => Editor.Current is { } d ? Enumerable.Range(0, d.Budgets.Count).Select(IssueIndex.Budget).ToList() : [];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Editor.Changed += OnChanged;
        await Editor.EnsureLoadedAsync();
        if (State.Connected) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_loading || !State.Connected) return;
        _started = true;
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            _budgets = await Api.GetBudgetsAsync();
            _endpointMissing = false;
            _loadedUtc = DateTimeOffset.UtcNow;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound)
        {
            _endpointMissing = true;
            _budgets = null;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            // ConsoleSession disconnects.
        }
        catch (Exception ex)
        {
            _error = ex.Message; // keep the previous rows visible but say they could not be refreshed
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static IReadOnlyList<FactList.Fact> LegacyFacts(StatusReport s) =>
    [
        new("Global cap", Money.Cap(s.Budget.GlobalCapUsd), true),
        new("Recorded spend", Money.Usd(s.Budget.GlobalSpendUsd), true),
        new("Teams with spend", s.Budget.Teams.Count.ToString(System.Globalization.CultureInfo.InvariantCulture), true),
    ];

    private BudgetConfigDto? ConfigBudget(string id) => Editor.Applied?.Config?.Budgets.FirstOrDefault(b => b.Id == id);

    private void ResetResult()
    {
        _saveError = null;
        _saveErrorTitle = null;
        _saveErrorTone = "bad";
        _issues = null;
        _notice = null;
    }

    private void OpenEdit(string id)
    {
        if (ConfigBudget(id) is not { } b) return;
        ResetResult();
        _edit = EntityEdits.Edit(b);
        _edit.BaseVersion = Editor.AppliedVersion;
        _warnOriginal = b.WarnAt;
        _warnText = BudgetText.FormatThresholds(b.WarnAt);
    }

    private void OpenAdd()
    {
        ResetResult();
        _newKind = "team";
        _newName = null;
        _warnOriginal = [0.80m, 0.95m];
        _warnText = BudgetText.FormatThresholds(_warnOriginal);
        _edit = EntityEdits.New(new BudgetConfigDto { Id = "", Scope = "team:", CapUsd = 0m, Period = "monthly", WarnAt = [0.80m, 0.95m], Enforcement = "hard" });
        _edit.BaseVersion = Editor.AppliedVersion;
    }

    private void SetNewScope(BudgetConfigDto b, string kind, string? name)
    {
        _newKind = kind;
        _newName = name;
        b.Scope = BudgetForm.Scope(kind, name);
        b.Id = BudgetForm.Id(b.Scope, Editor.Applied?.Config);
    }

    private void CloseDialog() => _edit = null;

    private void DiscardScoped()
    {
        Editor.DiscardIfOwner("budgets");
        ResetResult();
    }

    private async Task SaveAsync(EntityEdit<BudgetConfigDto> e)
    {
        if (BudgetText.ParseThresholds(_warnText) is not { } warn) return;
        e.Working.WarnAt = warn;
        _saving = true;
        _saveError = null;
        _issues = null;
        try
        {
            var outcome = await Editor.ApplyScopedAsync("budgets", e.BaseVersion, d => EntityEdits.Apply(d, e),
                "Console: budget " + e.Working.Id + (e.IsNew ? " added" : " edited"));
            if (outcome.Succeeded)
            {
                _notice = outcome.Message + ".";
                _edit = null;
                await LoadAsync();
                return;
            }
            _saveErrorTitle = outcome.Kind == EditOutcomeKind.Stale ? "The configuration changed meanwhile" : outcome.Kind == EditOutcomeKind.Invalid ? "The Host rejected this change" : "Not saved";
            _saveErrorTone = outcome.Kind == EditOutcomeKind.Stale ? "warn" : "bad";
            _saveError = outcome.Message;
            _issues = outcome.Errors;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenDrillAsync(BudgetStateDto b)
    {
        _drill = b;
        await LoadDrillAsync(b);
    }

    private async Task LoadDrillAsync(BudgetStateDto b)
    {
        _drillLoading = true;
        _drillError = null;
        _drillRows = null;
        StateHasChanged();
        try
        {
            var page = await Api.GetBudgetRequestsAsync(b.Id);
            if (!ReferenceEquals(_drill, b)) return;
            _drillRows = page.Items;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound)
        {
            _drillError = "Contributing requests are not available on this Host (GET /admin/budgets/{id}/requests missing).";
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            // ConsoleSession disconnects.
        }
        catch (Exception ex)
        {
            _drillError = ex.Message;
        }
        finally
        {
            _drillLoading = false;
        }
    }

    private void OnDrillOpenChanged(bool open)
    {
        if (open) return;
        _drill = null;
        _drillRows = null;
        _drillError = null;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (State.Connected && !_started) await LoadAsync();
            StateHasChanged();
        });
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Editor.Changed -= OnChanged;
    }
}
