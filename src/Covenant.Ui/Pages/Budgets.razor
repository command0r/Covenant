@page "/budgets"
@inject AppState State
@inject AdminApi Api
@inject ConfigEditor Editor
@implements IDisposable

<PageTitle>Budgets · Covenant</PageTitle>

@*
  T08. Budget state per scope from the ledger (GET /admin/budgets, ADR-0014): period + period id, spent, reserved,
  remaining, cap, warning state, enforcement. Caps/thresholds/period/enforcement are edited in the configuration draft
  (ConfigEditor → Preview impact → Save & apply). Drill-down: GET /admin/budgets/{id}/requests. Amounts via
  Logic/Money (significant digits; never $0.00 for a non-zero charge).
*@

<div class="page">
    <RequiresConnection>
        <div class="page-head">
            <div class="titles">
                <h1>Budgets</h1>
                <span class="lede">Provider spend by scope and UTC period, checked before every paid attempt. Spend lives in the budget ledger — independent of audit segments.</span>
            </div>
            <Button Busy="@_loading" BusyText="Loading…" OnClick="LoadAsync">Refresh</Button>
        </div>

        <EditorBar Owner="budgets" Subject="Budgets" ClaimedPaths="@ClaimedPaths" OnSaved="LoadAsync"
                   ViewHint="Viewing applied caps. Edit to change caps, thresholds, periods or enforcement." />

        <ErrorBanner Title="Budget state unavailable" Message="@_error" OnRetry="LoadAsync" Busy="@_loading" />

        @if (_budgets is null && _loading)
        {
            <section class="panel"><Skeleton Lines="4" Label="Loading budget state" /></section>
        }
        else if (_endpointMissing)
        {
            <div class="alert warn" role="status">
                <div class="alert-text">
                    <strong>This Host has no budget ledger yet (GET /admin/budgets is missing)</strong>
                    <span class="alert-body">Integration pending on the backend. Shown below: the pre-v2 status counters (global and team spend of the current audit segment). Periods, reservations and application scopes are not available on this Host.</span>
                </div>
            </div>
            @if (State.LastStatus is { } s)
            {
                <section class="panel">
                    <h2>Pre-v2 counters</h2>
                    <FactList Inline="true" Facts="@LegacyFacts(s)" />
                </section>
            }
        }
        else if (_budgets is { } budgets)
        {
            if (budgets.Count == 0)
            {
                <EmptyState Title="No budgets reported" Body="A global budget is required by validation; if none is reported, check the Host's configuration." />
            }
            else
            {
                if (BudgetText.NoSpendAnywhere(budgets))
                {
                    <div class="alert info" role="status">
                        <div class="alert-text">
                            <strong>No provider spend in the current periods</strong>
                            <span class="alert-body">Requests served by local models with a zero-marginal price reserve and settle $0 provider charge, and refusals or cache hits make no call — so there is nothing to chart. Infrastructure cost (hardware, power, operations) is not measured by Covenant. To see spend, route Public traffic to a priced cloud connection.</span>
                        </div>
                        <a class="btn" href="connections">Models &amp; connections</a>
                    </div>
                }
                <section class="panel flush" aria-labelledby="bs-h">
                    <div class="panel-head">
                        <h2 id="bs-h">Budget state</h2>
                        <span class="panel-sub">@(_loadedUtc is { } t ? "Read " + Fmt.UtcShort(t) + " UTC from the ledger" : "")</span>
                    </div>
                    <div class="table-wrap">
                        <table class="budget-table">
                            <thead>
                                <tr>
                                    <th scope="col">Scope</th>
                                    <th scope="col">Period</th>
                                    <th scope="col" class="num">Spent</th>
                                    <th scope="col" class="num">Reserved</th>
                                    <th scope="col" class="num">Remaining</th>
                                    <th scope="col" class="num">Cap</th>
                                    <th scope="col">State</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in budgets)
                                {
                                    var row = b;
                                    var warn = BudgetText.Warning(row.Warning);
                                    var pct = BudgetText.MeterPercent(row.SpentUsd, row.ReservedUsd, row.CapUsd);
                                    <tr>
                                        <td><strong>@BudgetText.Scope(row.Scope)</strong><br /><span class="mono subtle secondary">@row.Id</span></td>
                                        <td class="secondary">@BudgetText.Period(row.Period, row.PeriodId)</td>
                                        <td class="num mono">@Money.Usd(row.SpentUsd)</td>
                                        <td class="num mono">@Money.Usd(row.ReservedUsd)</td>
                                        <td class="num mono">@BudgetText.Remaining(row.RemainingUsd)</td>
                                        <td class="num mono">@Money.Cap(row.CapUsd)
                                            <span class="meter @(warn.Tone == "bad" ? "bad" : warn.Tone == "warn" ? "warn" : "")" role="img"
                                                  aria-label="@(Money.Share(row.SpentUsd + row.ReservedUsd, row.CapUsd) + " of the cap spent or reserved")"><span style="width:@pct%"></span></span>
                                        </td>
                                        <td class="secondary">
                                            <span class="indicator"><span class="dot @warn.Tone" aria-hidden="true"></span>@warn.Label</span>
                                            <span class="subtle">@BudgetText.Enforcement(row.Enforcement) · warn at @BudgetText.Thresholds(row.WarnAt)</span>
                                        </td>
                                        <td><button type="button" class="btn sm" id="@("drill-" + row.Id)" @onclick="() => OpenDrillAsync(row)">Requests</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }

        @if (Editing && Editor.Draft is { } draft)
        {
            <section class="panel" aria-labelledby="be-h">
                <div class="panel-head">
                    <h2 id="be-h">Edit budgets (draft)</h2>
                    <span class="panel-sub">Changing a cap never erases spend; lowering it below spend blocks new paid work. Changing a period or id keeps the scope's accrued ledger.</span>
                </div>
                <ul class="budget-edit-list">
                    @foreach (var b in draft.Budgets)
                    {
                        var cfgRow = b;
                        var bi = draft.Budgets.IndexOf(cfgRow);
                        var path = IssueIndex.Budget(bi);
                        <li>
                            <div class="policy-head">
                                <strong>@BudgetText.Scope(cfgRow.Scope)</strong>
                                <span class="mono subtle secondary">@cfgRow.Id</span>
                                @if (IsNewBudget(cfgRow))
                                {
                                    <span class="changed-flag">New in draft</span>
                                    <button type="button" class="btn ghost sm" @onclick="() => RemoveBudget(cfgRow)">Remove</button>
                                }
                            </div>
                            <div class="form-grid">
                                <div class="field">
                                    <label for="@("cap-" + bi)">Cap (USD)</label>
                                    <input id="@("cap-" + bi)" class="input mono" type="number" min="0" step="any" @bind="cfgRow.CapUsd" @bind:after="Editor.Touch"
                                           aria-invalid="@(Editor.Issues.HasErrorAt(path + ".cap_usd") ? "true" : "false")" />
                                    <FieldIssues Issues="@Editor.Issues" Path="@(path + ".cap_usd")" />
                                </div>
                                <div class="field">
                                    <label for="@("per-" + bi)">Period (UTC)</label>
                                    <select id="@("per-" + bi)" class="input" value="@(cfgRow.Period ?? "monthly")" @onchange="@(e => SetPeriod(cfgRow, e))">
                                        <option value="monthly">Monthly</option>
                                        <option value="daily">Daily</option>
                                        <option value="none">No period (cumulative)</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="@("warn-" + bi)">Warn at (% of cap)</label>
                                    <input id="@("warn-" + bi)" class="input mono" type="text" placeholder="80, 95"
                                           value="@BudgetText.FormatThresholds(cfgRow.WarnAt)" @onchange="@(e => SetThresholds(cfgRow, bi, e))"
                                           aria-invalid="@(_thresholdErrors.ContainsKey(bi) || Editor.Issues.HasErrorAt(path + ".warn_at") ? "true" : "false")" />
                                    @if (_thresholdErrors.TryGetValue(bi, out var te))
                                    {
                                        <span class="help bad">@te</span>
                                    }
                                    <FieldIssues Issues="@Editor.Issues" Path="@(path + ".warn_at")" />
                                </div>
                                <div class="field">
                                    <label for="@("enf-" + bi)">Enforcement</label>
                                    <select id="@("enf-" + bi)" class="input" value="@(cfgRow.Enforcement ?? "hard")" @onchange="@(e => SetEnforcement(cfgRow, e))">
                                        <option value="hard">Hard — refuse paid work over the cap</option>
                                        <option value="warn-only">Warn only — never block</option>
                                    </select>
                                </div>
                            </div>
                            <FieldIssues Issues="@Editor.Issues" Path="@path" />
                        </li>
                    }
                </ul>
                <div class="field-row">
                    <div class="field">
                        <label for="nb-kind">New budget scope</label>
                        <select id="nb-kind" class="input" @bind="_newKind">
                            <option value="team">Team</option>
                            <option value="application">Application</option>
                            <option value="global">Global</option>
                        </select>
                    </div>
                    @if (_newKind != "global")
                    {
                        <div class="field">
                            <label for="nb-name">@(_newKind == "team" ? "Team name" : "Application id")</label>
                            <input id="nb-name" class="input mono" type="text" spellcheck="false" @bind="_newName" @bind:event="oninput" />
                        </div>
                    }
                    <button type="button" class="btn form" @onclick="AddBudget" disabled="@(_newKind != "global" && string.IsNullOrWhiteSpace(_newName))"><Icon Name="plus" Size="16" /><span>Add budget</span></button>
                </div>
                @if (_addError is { } ae)
                {
                    <span class="note bad" role="status">@ae</span>
                }
                <span class="note">Raising or lowering a cap is a configuration activation and is audited with before/after. Hard caps are an estimated bound (reservation from enforced input/output limits), not an invoice ceiling.</span>
            </section>
        }

        <section class="panel two-col" aria-label="What counts as spend">
            <div>
                <h2>Provider charge</h2>
                <ul class="plain-list secondary muted">
                    <li>Provider-reported tokens × configured price for that connection/model. Covenant does not read provider invoices.</li>
                    <li>Before each attempt a conservative reservation is held; it settles against reported usage (or an explicit estimate) exactly once, and the remainder is released.</li>
                    <li>An unpriced paid model is not eligible under a hard budget — unknown cost is never counted as $0.</li>
                </ul>
            </div>
            <div>
                <h2>Local infrastructure</h2>
                <ul class="plain-list secondary muted">
                    <li>Local models priced “zero marginal” settle $0 provider charge.</li>
                    <li>Hardware, power and operations are excluded — not free. No infrastructure estimate is configured, so none is shown.</li>
                </ul>
            </div>
        </section>
        <p class="note">Budget period rollover and audit archive are different operations: a budget's period rolls over by UTC date; archiving the audit segment (Settings → Maintenance) never reopens a budget.</p>

        <Drawer Title="@(_drill is { } d ? "Contributing requests · " + BudgetText.Scope(d.Scope) : "")" Open="@(_drill is not null)" OpenChanged="OnDrillOpenChanged"
                OpenerId="@(_drill is { } dd ? "drill-" + dd.Id : null)">
            @if (_drill is { } db)
            {
                <span class="secondary muted">@BudgetText.Period(db.Period, db.PeriodId) · settled contributions, newest first. Open a request to see its attempts and evidence.</span>
                @if (_drillLoading)
                {
                    <Skeleton Lines="5" Label="Loading contributing requests" />
                }
                <ErrorBanner Title="Contributing requests unavailable" Message="@_drillError" OnRetry="@(() => LoadDrillAsync(db))" />
                @if (_drillRows is { Count: 0 })
                {
                    <EmptyState Title="No settled requests in this period" Body="Nothing has been charged to this scope in the current period." />
                }
                else if (_drillRows is { } rows)
                {
                    <ol class="row-list">
                        @foreach (var r in rows)
                        {
                            var req = r;
                            <li>
                                <a class="mono" href="@("requests/" + Uri.EscapeDataString(req.RequestId))">@req.RequestId</a>
                                <span class="mono">@Money.Usd(req.AmountUsd)</span>
                                <span class="subtle secondary">@(req.TimestampUtc is { } ts ? Fmt.Utc(ts) : "time not reported")@(req.AttemptId is { Length: > 0 } at ? " · attempt " + at : "")@(req.Kind is { Length: > 0 } k && k != "settle" ? " · " + k : "")</span>
                                @if (req.Overrun)
                                {
                                    <span class="note warn">Reported charge exceeded the reservation — settled in full.</span>
                                }
                            </li>
                        }
                    </ol>
                }
            }
        </Drawer>
    </RequiresConnection>
</div>

@code {
    private List<BudgetStateDto>? _budgets;
    private bool _loading;
    private string? _error;
    private bool _endpointMissing;
    private DateTimeOffset? _loadedUtc;
    private bool _started;

    private BudgetStateDto? _drill;
    private bool _drillLoading;
    private string? _drillError;
    private List<BudgetRequestDto>? _drillRows;

    private string _newKind = "team";
    private string? _newName;
    private string? _addError;
    private readonly Dictionary<int, string> _thresholdErrors = new();

    private bool Editing => Editor.Editing && Editor.Owner == "budgets";

    private IReadOnlyList<string> ClaimedPaths => Editing && Editor.Draft is { } d ? Enumerable.Range(0, d.Budgets.Count).Select(IssueIndex.Budget).ToList() : [];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Editor.Changed += OnChanged;
        await Editor.EnsureLoadedAsync();
        if (State.Connected) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_loading || !State.Connected) return;
        _started = true;
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            _budgets = await Api.GetBudgetsAsync();
            _endpointMissing = false;
            _loadedUtc = DateTimeOffset.UtcNow;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound)
        {
            _endpointMissing = true;
            _budgets = null;
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            // ConsoleSession disconnects.
        }
        catch (Exception ex)
        {
            _error = ex.Message; // keep the previous rows visible but say they could not be refreshed
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static IReadOnlyList<FactList.Fact> LegacyFacts(StatusReport s) =>
    [
        new("Global cap", Money.Cap(s.Budget.GlobalCapUsd), true),
        new("Recorded spend", Money.Usd(s.Budget.GlobalSpendUsd), true),
        new("Teams with spend", s.Budget.Teams.Count.ToString(System.Globalization.CultureInfo.InvariantCulture), true),
    ];

    private bool IsNewBudget(BudgetConfigDto b) => Editor.Applied?.Config?.Budgets.All(x => !string.Equals(x.Id, b.Id, StringComparison.Ordinal)) ?? true;

    private void SetPeriod(BudgetConfigDto b, ChangeEventArgs e)
    {
        b.Period = e.Value?.ToString() is "daily" or "none" ? e.Value!.ToString() : "monthly";
        Editor.Touch();
    }

    private void SetEnforcement(BudgetConfigDto b, ChangeEventArgs e)
    {
        b.Enforcement = e.Value?.ToString() == "warn-only" ? "warn-only" : "hard";
        Editor.Touch();
    }

    private void SetThresholds(BudgetConfigDto b, int index, ChangeEventArgs e)
    {
        var parsed = BudgetText.ParseThresholds(e.Value?.ToString());
        if (parsed is null)
        {
            _thresholdErrors[index] = "Enter percentages between 0 and 100, separated by commas (e.g. 80, 95).";
            return;
        }
        _thresholdErrors.Remove(index);
        b.WarnAt = parsed;
        Editor.Touch();
    }

    private void AddBudget()
    {
        _addError = null;
        if (Editor.Draft is not { } d) return;
        string scope = _newKind switch
        {
            "global" => "global",
            "application" => "application:" + (_newName ?? "").Trim(),
            _ => "team:" + (_newName ?? "").Trim(),
        };
        if (d.Budgets.Any(x => string.Equals(x.Scope, scope, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = "A budget for " + scope + " already exists in the draft.";
            return;
        }
        var seed = scope.Replace(':', '-');
        var id = ConnectionRules.UniqueId(seed, d.Budgets.Select(x => x.Id));
        d.Budgets.Add(new BudgetConfigDto { Id = id, Scope = scope, CapUsd = 0m, Period = "monthly", WarnAt = [0.80m, 0.95m], Enforcement = "hard" });
        _newName = null;
        Editor.Touch();
    }

    private void RemoveBudget(BudgetConfigDto b)
    {
        if (Editor.Draft is not { } d) return;
        d.Budgets.Remove(b);
        _thresholdErrors.Clear();
        Editor.Touch();
    }

    private async Task OpenDrillAsync(BudgetStateDto b)
    {
        _drill = b;
        await LoadDrillAsync(b);
    }

    private async Task LoadDrillAsync(BudgetStateDto b)
    {
        _drillLoading = true;
        _drillError = null;
        _drillRows = null;
        StateHasChanged();
        try
        {
            var json = await Api.GetBudgetRequestsJsonAsync(b.Id);
            if (!ReferenceEquals(_drill, b)) return;
            _drillRows = BudgetRequests.Parse(json);
            if (_drillRows is null) _drillError = "The Host answered in an unrecognised shape — nothing is shown rather than a guess.";
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound)
        {
            _drillError = "Contributing requests are not available on this Host (GET /admin/budgets/{id}/requests missing).";
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            // ConsoleSession disconnects.
        }
        catch (Exception ex)
        {
            _drillError = ex.Message;
        }
        finally
        {
            _drillLoading = false;
        }
    }

    private void OnDrillOpenChanged(bool open)
    {
        if (open) return;
        _drill = null;
        _drillRows = null;
        _drillError = null;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (State.Connected && !_started) await LoadAsync();
            StateHasChanged();
        });
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Editor.Changed -= OnChanged;
    }
}
