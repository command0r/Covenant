<mxfile host="app.diagrams.net" agent="Covenant gen_diagram.py" version="24.0.0"><diagram name="Covenant architecture" id="covenant-arch"><mxGraphModel dx="1420" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="perimeter" value="&lt;b&gt;Customer perimeter — no prompt, response, or metadata leaves; egress only to the allow-listed models&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#616161;fontColor=#212121;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="920" height="830" as="geometry"/></mxCell><mxCell id="appliance" value="&lt;b&gt;Covenant appliance — single .NET process, NativeAOT target&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#616161;fontColor=#212121;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="690" height="560" as="geometry"/></mxCell><mxCell id="c_openai" value="&lt;b&gt;OpenAI-compatible clients&lt;/b&gt;&lt;br&gt;SDKs · Open WebUI · Bearer key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="190" height="70" as="geometry"/></mxCell><mxCell id="c_anthropic" value="&lt;b&gt;Anthropic clients&lt;/b&gt;&lt;br&gt;x-api-key · Messages API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="190" height="70" as="geometry"/></mxCell><mxCell id="c_admin" value="&lt;b&gt;Admins / auditors&lt;/b&gt;&lt;br&gt;admin token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;" vertex="1"