<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="covenant-architecture" name="How a request is governed"><mxGraphModel dx="1440" dy="1240" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1240" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="How a request is governed" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#14233B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="32" width="1360" height="42" /></mxCell><mxCell id="3" value="Read top to bottom. A refusal stops further work and still creates an audit record." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#54647B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="80" width="1360" height="28" /></mxCell><mxCell id="4" value="INPUT AND CONTROL" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#54647B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="126" width="320" height="28" /></mxCell><mxCell id="5" value="REQUEST PIPELINE" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#54647B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="126" width="480" height="28" /></mxCell><mxCell id="6" value="DESTINATIONS AND RESULTS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#54647B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="126" width="330" height="28" /></mxCell><mxCell id="7" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="172" width="480" height="108" /></mxCell><mxCell id="8" value="" style="rounded=1;arcSize=10;fillColor=#2563EB;strokeColor=#2563EB;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="188" width="32" height="32" /></mxCell><mxCell id="9" value="1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="188" width="32" height="32" /></mxCell><mxCell id="10" value="Identify the caller" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#2563EB;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="187" width="404" height="30" /></mxCell><mxCell id="11" value="Authenticate the application; bind its team." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="226" width="440" height="24" /></mxCell><mxCell id="12" value="Validate the request format." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="250" width="440" height="24" /></mxCell><mxCell id="13" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="280" /><mxPoint as="targetPoint" x="720" y="306" /></mxGeometry></mxCell><mxCell id="14" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#B77912;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="306" width="480" height="108" /></mxCell><mxCell id="15" value="" style="rounded=1;arcSize=10;fillColor=#B77912;strokeColor=#B77912;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="322" width="32" height="32" /></mxCell><mxCell id="16" value="2" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="322" width="32" height="32" /></mxCell><mxCell id="17" value="Inspect the content" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#B77912;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="321" width="404" height="30" /></mxCell><mxCell id="18" value="Combine the workload label with detection." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="360" width="440" height="24" /></mxCell><mxCell id="19" value="Incomplete inspection means refuse." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="384" width="440" height="24" /></mxCell><mxCell id="20" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="414" /><mxPoint as="targetPoint" x="720" y="440" /></mxGeometry></mxCell><mxCell id="21" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#B77912;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="440" width="480" height="108" /></mxCell><mxCell id="22" value="" style="rounded=1;arcSize=10;fillColor=#B77912;strokeColor=#B77912;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="456" width="32" height="32" /></mxCell><mxCell id="23" value="3" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="456" width="32" height="32" /></mxCell><mxCell id="24" value="Apply the policy" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#B77912;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="455" width="404" height="30" /></mxCell><mxCell id="25" value="Enforce sensitive-data handling and routes." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="494" width="440" height="24" /></mxCell><mxCell id="26" value="Sanitize only an approved structured record." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="518" width="440" height="24" /></mxCell><mxCell id="27" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="548" /><mxPoint as="targetPoint" x="720" y="574" /></mxGeometry></mxCell><mxCell id="28" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="574" width="480" height="108" /></mxCell><mxCell id="29" value="" style="rounded=1;arcSize=10;fillColor=#2563EB;strokeColor=#2563EB;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="590" width="32" height="32" /></mxCell><mxCell id="30" value="4" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="590" width="32" height="32" /></mxCell><mxCell id="31" value="Check the exact cache" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#2563EB;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="589" width="404" height="30" /></mxCell><mxCell id="32" value="Reuse only an eligible, matching response." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="628" width="440" height="24" /></mxCell><mxCell id="33" value="A cache hit avoids a new model call." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="652" width="440" height="24" /></mxCell><mxCell id="34" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="682" /><mxPoint as="targetPoint" x="720" y="708" /></mxGeometry></mxCell><mxCell id="35" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#B77912;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="708" width="480" height="108" /></mxCell><mxCell id="36" value="" style="rounded=1;arcSize=10;fillColor=#B77912;strokeColor=#B77912;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="724" width="32" height="32" /></mxCell><mxCell id="37" value="5" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="724" width="32" height="32" /></mxCell><mxCell id="38" value="Check limits and retrieve" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#B77912;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="723" width="404" height="30" /></mxCell><mxCell id="39" value="Check rate, pause and budget reservation." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="762" width="440" height="24" /></mxCell><mxCell id="40" value="Optional Public web search is governed too." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="786" width="440" height="24" /></mxCell><mxCell id="41" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="816" /><mxPoint as="targetPoint" x="720" y="842" /></mxGeometry></mxCell><mxCell id="42" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#078568;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="842" width="480" height="108" /></mxCell><mxCell id="43" value="" style="rounded=1;arcSize=10;fillColor=#078568;strokeColor=#078568;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="858" width="32" height="32" /></mxCell><mxCell id="44" value="6" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="858" width="32" height="32" /></mxCell><mxCell id="45" value="Call an approved model" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#078568;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="857" width="404" height="30" /></mxCell><mxCell id="46" value="Use the selected local or external adapter." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="896" width="440" height="24" /></mxCell><mxCell id="47" value="Fallback stays within the approved routes." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="920" width="440" height="24" /></mxCell><mxCell id="48" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="950" /><mxPoint as="targetPoint" x="720" y="976" /></mxGeometry></mxCell><mxCell id="49" value="" style="rounded=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="976" width="480" height="108" /></mxCell><mxCell id="50" value="" style="rounded=1;arcSize=10;fillColor=#64748B;strokeColor=#64748B;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="992" width="32" height="32" /></mxCell><mxCell id="51" value="7" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="496" y="992" width="32" height="32" /></mxCell><mxCell id="52" value="Finalize and record" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#64748B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="991" width="404" height="30" /></mxCell><mxCell id="53" value="Settle usage and attribute cost to the team." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="1030" width="440" height="24" /></mxCell><mxCell id="54" value="Record the outcome and return the response." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="1054" width="440" height="24" /></mxCell><mxCell id="55" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="172" width="340" height="108" /></mxCell><mxCell id="56" value="Application request" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#2563EB;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="187" width="304" height="30" /></mxCell><mxCell id="57" value="OpenAI / Anthropic compatible API" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="226" width="300" height="24" /></mxCell><mxCell id="58" value="Application key identifies the caller" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="250" width="300" height="24" /></mxCell><mxCell id="59" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=0;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="388" y="226" /><mxPoint as="targetPoint" x="480" y="226" /></mxGeometry></mxCell><mxCell id="60" value="" style="rounded=1;arcSize=10;fillColor=#FFF1F2;strokeColor=#C0394D;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="332" width="340" height="156" /></mxCell><mxCell id="61" value="Sensitive data rules" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#C0394D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="347" width="304" height="30" /></mxCell><mxCell id="62" value="Internal: approved local processing" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="386" width="300" height="24" /></mxCell><mxCell id="63" value="Public demo: reject detected PII/PHI" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="410" width="300" height="24" /></mxCell><mxCell id="64" value="Detection can raise the data label." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="434" width="300" height="24" /></mxCell><mxCell id="65" value="No match is not proof of safe data." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="458" width="300" height="24" /></mxCell><mxCell id="66" value="" style="rounded=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="550" width="340" height="132" /></mxCell><mxCell id="67" value="Configuration" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#64748B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="565" width="304" height="30" /></mxCell><mxCell id="68" value="Profiles, routes and model allow-list" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="604" width="300" height="24" /></mxCell><mxCell id="69" value="Budgets and permission settings" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="628" width="300" height="24" /></mxCell><mxCell id="70" value="Provider secrets stay on the server." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="652" width="300" height="24" /></mxCell><mxCell id="71" edge="1" parent="1" style="endArrow=block;endFill=1;rounded=0;strokeColor=#64748B;strokeWidth=2;dashed=1;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="388" y="603" /><mxPoint as="targetPoint" x="480" y="494" /><Array as="points"><mxPoint x="426" y="603" /><mxPoint x="426" y="494" /></Array></mxGeometry></mxCell><mxCell id="72" value="" style="rounded=1;arcSize=10;fillColor=#FFF1F2;strokeColor=#C0394D;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="758" width="340" height="156" /></mxCell><mxCell id="73" value="Refused or failed" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#C0394D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="773" width="304" height="30" /></mxCell><mxCell id="74" value="Record the reason and any usage." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="812" width="300" height="24" /></mxCell><mxCell id="75" value="Do not continue to later stages." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="836" width="300" height="24" /></mxCell><mxCell id="76" value="Earlier tool or model calls may" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="860" width="300" height="24" /></mxCell><mxCell id="77" value="already have incurred a charge." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="68" y="884" width="300" height="24" /></mxCell><mxCell id="78" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="574" width="332" height="108" /></mxCell><mxCell id="79" value="Exact cache hit" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#2563EB;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="589" width="296" height="30" /></mxCell><mxCell id="80" value="Skip retrieval and model execution." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="628" width="292" height="24" /></mxCell><mxCell id="81" value="Still record and attribute the request." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#23354D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="