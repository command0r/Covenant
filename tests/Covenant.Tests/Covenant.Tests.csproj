<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test assemblies are not the shipped appliance; AOT analysis off here. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Covenant.Core\Covenant.Core.csproj" />
    <ProjectReference Include="..\..\src\Covenant.Adapters\Covenant.Adapters.csproj" />
    <ProjectReference Include="..\..\src\Covenant.Governance\Covenant.Governance.csproj" />
    <!-- Host is referenced for the audit chain writer/verifier and evidence export (tamper tests). -->
    <ProjectReference Include="..\..\src\Covenant.Host\Covenant.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned against nuget.org 2026-07-15. xunit v2 deliberate — v3 changes runner packaging, buys nothing for this slice. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Console view-model logic is plain C# (no Blazor/JS types): compiled in here by link so ConsoleLogicTests run
         without referencing the Blazor WebAssembly project. Ui types live in Covenant.Ui.* namespaces — qualify
         them in tests where Covenant.Host has a same-named type (ErrorResponse, StatusReport, …). -->
    <Compile Include="..\..\src\Covenant.Ui\Logic\*.cs" Link="UiLogic\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Covenant.Ui\Models\*.cs" Link="UiLogic\Models\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
